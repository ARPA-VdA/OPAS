% layout 'default';
% title 'Telegram - invio messaggi';

<script src="<%=url_for(helperGetFileVersion('/bobo-js/divulgazione/telegram.js'))%>" type="text/javascript"></script>

<div class="row telegram-page">
    <div class="col-lg-12">
        <!-- Nav tabs -->
        <!-- <ul class="nav nav-tabs" role="tablist" id="nav-main">
            <li class="nav-item"><a id="sel-meteo" class="nav-link active" data-toggle="tab" href="#tab-meteo" role="tab"><i class="wi wi-day-sunny"></i> METEO</a> </li>
            <li class="nav-item"><a id="sel-alert" class="nav-link" data-toggle="tab" href="#tab-alert" role="tab"><i class="wi wi-storm-warning"></i> ALLERTA</a></li>
        </ul> -->
        <div class="card">
            <div class="card-body">

                <h4 class="card-title"><i class="mdi mdi-telegram"></i> Gestione dei canali <strong>Telegram</strong></h4>
                <h6 class="card-subtitle">Invio/eliminazione della messaggistica nei canali Telegram</h6>
                <!-- Nav tabs -->
                <ul class="nav nav-tabs customtab" role="tablist">
                    <li class="nav-item"> <a class="nav-link active" data-toggle="tab" href="#msg-list" role="tab"><span class="hidden-sm-up"><i class="mdi mdi-view-grid"></i></span> <span class="hidden-xs-down">Inviati</span></a> </li>
                    <!-- if user has insert grant -->
                    % if ($user_grants->{user_insert}){
                        <li class="nav-item" id="new-msg"> <a class="nav-link text-info" data-toggle="tab" href="#new" role="tab"><span class="hidden-sm-up"><i class="mdi mdi-library-plus"></i></span> <span class="hidden-xs-down">Nuovo</span></a> </li>
                    % }
                </ul>
                <!-- END Nav tabs -->

                <!-- Tab panes -->
                <div class="tab-content" id="tab-list">
                    <div class="tab-pane p-20 active" id="msg-list" role="tabpanel">
                        <div class="row">
                            <div class="input-group col-md-6" style="margin-bottom: 20px;">
                                <input class="form-control input-daterange-datepicker" type="text" name="daterange" value="" id="date-range" />
                                <div class="input-group-append">
                                    <span class="input-group-text"><i class="mdi mdi-calendar-multiple"></i></span>
                                </div>
                            </div>
                            <div class="col-md-6" style="margin-bottom: 20px;">
                                <select class="custom-select col-12" id="filter-channels" name="filter-channels">
                                    <option value="-1">Seleziona canale...</option>
                                    % foreach my $channel (@{$channels}){
                                        % if ( $channel->{'channel_insert'} == 1) {
                                            <option value="<%= $channel->{'chat'} %>"><%= $channel->{'channel_name'} %> (<%= $channel->{'chat'} %>)</option>
                                        % }
                                    % }
                                </select>
                            </div>
                        </div>
                        <table id="message-table" class="display responsive table table-hover table-striped" cellspacing="0" width="100%">
                            <thead>
                                <tr>
                                    <th class="bobo-nowrap"></th>
                                    <th class="bobo-nowrap">Data</th>
                                    <th class="bobo-nowrap"><i class="mdi mdi-telegram"></i> Canale</th>
                                    <th class="bobo-nowrap">Tag</th>
                                    <th class="bobo-nowrap"><i class="mdi mdi-buffer"></i>&nbsp;Tipo</th>
                                    <th>Messaggio</th>
                                    <th>Inviato</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th class="bobo-nowrap"></th>
                                    <th class="bobo-nowrap">Data</th>
                                    <th class="bobo-nowrap"><i class="mdi mdi-telegram"></i> Canale</th>
                                    <th class="bobo-nowrap">Tag</th>
                                    <th class="bobo-nowrap"><i class="mdi mdi-buffer"></i>&nbsp;Tipo</th>
                                    <th>Messaggio</th>
                                    <th>Inviato</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <div class="tab-pane p-20" id="new" role="tabpanel">
                        <h4 class="box-title"><strong>Seleziona il canale</strong> ed invia un messaggio Telegram <span class="text-danger">*</span></h4>
                        <hr class="m-t-0 m-b-20">
                        <form class="form" id="form_telegram_new">
                            <div class="row">
                                <div class="col-md-8">
                                    <select class="custom-select col-12 m-b-20" id="select-channel" name="select-channel">
                                        <option value="">Seleziona canale...</option>
                                        % foreach my $channel (@{$channels}){
                                            % if ( $channel->{'channel_insert'} == 1) {
                                                <option value="<%= $channel->{'chat'} %>"><%= $channel->{'channel_name'} %> (<%= $channel->{'chat'} %>)</option>
                                            % }
                                        % }
                                    </select>
                                    <textarea class="form-control" id="message-channel" name="message-channel" rows="11" placeholder="INSERISCI TESTO..."></textarea>
                                    <p><span class="text-danger">*</span> Entrambi i campi sono obbiligatori</p>
                                </div>
                                <div class="col-md-4">
                                    <div class="blackboard">
                                        <h5 class="divider-title">Vademecuum</h5>
                                        <h6>Per inserire il grassetto:</h6>
                                        <p>*testo*</p>
                                        <h6>Per inserire l'italico:</h6>
                                        <p>_italic text_</p>
                                        <h6>Per inserire un indirizzo web:</h6>
                                        <p>[testo URL](http://www.link-di-esempio.com/)</p>
                                        <h6 class="text-danger">NOTA BENE</h6>
                                        <p class="text-info">Se vuoi inserire un _ oppure un * aggiungi prima il carattere \<br>
                                        <strong>Per esempio: \_ oppure \*</strong></p>
                                    </div>
                                </div>
                            </div>

                            <hr class="m-t-30">
                            <div class="form-group row">
                                <div class="col-12">
                                    <button type="submit" class="btn btn-info" name="invia-msg" id="invia-msg"> <i class="mdi mdi-telegram"></i> Invia messaggio sul CANALE SCELTO</button>
                                    <!-- <button type="submit" class="btn btn-info" name="invia-msg-test" id="invia-msg-test"> <i class="icon-globe"></i> Invia su TEST</button>
                                    <button type="submit" class="btn btn-success" name="invia-msg-prod" id="invia-msg-prod"> <i class="mdi mdi-telegram"></i> Invia su CANALE METEO UFFICIALE</button> -->
                                    <button type="button" class="btn btn-inverse" name="annulla-msg" id="annulla-msg">Annulla</button>
                                </div>
                            </div>
                        </form>

                    </div>
                </div>
                <!-- end Tab panes -->

            </div>
        </div>
    </div>
</div>
