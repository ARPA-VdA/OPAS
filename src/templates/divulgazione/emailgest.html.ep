% layout 'default';
% title 'Gestione email';

<script src="<%=url_for(helperGetFileVersion('/bobo-js/divulgazione/emailgest.js'))%>" type="text/javascript"></script>

<div class="row">
    <div class="col-lg-12">
        <!-- Nav tabs -->
        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item"> <a class="nav-link active" data-toggle="tab" href="#tab-lists" role="tab">Mailing lists</a></li>
            <li class="nav-item"> <a class="nav-link" data-toggle="tab" href="#tab-ext" role="tab">Email esterne</a></li>
        </ul>

        <!-- Tab panes -->
        <div class="tab-content tabcontent-border tab-big mb-4 img-all-view" id="main-tab">
            <!-- Mailing lists -->
            <div class="tab-pane p-20 active" id="tab-lists" role="tabpanel">
                <h4 class="box-title text-info m-b-5">Gestisci le <strong>Mailing Lists</strong> della tua rete</h4>
                <h6 class="tab-subtitle">Elenco delle <code>Mailing Lists</code> relative ai tuoi prodotti, aggiungi e modifica a seconda delle preferenze.</h6>
                <hr class="m-t-0 m-b-10">

                <!-- Nav tabs -->
                <ul class="nav nav-tabs customtab" role="tablist">
                    <li class="nav-item"> <a class="nav-link active" data-toggle="tab" href="#lists-tbl" role="tab"><span class="hidden-sm-up"><i class="mdi mdi-view-grid"></i></span> <span class="hidden-xs-down">Mailing lists</span></a> </li>
                    <!-- if user has insert grant -->
                    % if ($user_grants->{user_insert}){
                        <li class="nav-item"> <a class="nav-link text-info" data-toggle="tab" href="#lists-new" role="tab"><span class="hidden-sm-up"><i class="mdi mdi-library-plus"></i></span> <span class="hidden-xs-down" id="inner-new-list">Nuova</span></a> </li>
                    % }
                </ul>
                <!-- END Nav tabs -->

                <!-- Tab panes -->
                <div class="tab-content inner-content">
                    <div class="tab-pane p-20 active" id="lists-tbl" role="tabpanel">
                        <table id="lists-table" class="display responsive table table-hover table-striped" cellspacing="0" width="100%">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Nome</th>
                                    <th>Descrizione</th>
                                    <th>Azienda</th>
                                    <th>Email inserite</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th></th>
                                    <th>Nome</th>
                                    <th>Descrizione</th>
                                    <th>Azienda</th>
                                    <th>Email inserite</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div class="tab-pane p-20" id="lists-new" role="tabpanel">
                        <h4 class="box-title">Inserisci nuova MAILING LIST</h4>
                        <hr class="m-t-0 m-b-20">
                        <form class="form form-medium" id="form-mlist" name="form-mlist">
                            <input type="hidden" class="clear-input" id="mlist-id" name="mlist-id" value="">
                            <h5 class="divider-title">Inserisci dati generali</h5>
                            <div class="form-group row">
                                <label for="mlist-name" class="col-lg-2 col-form-label">Nome <span class="text-danger">*</span></label>
                                <div class="col-lg-4">
                                    <input type="text" class="form-control clear-input" id="mlist-name" name="mlist-name" placeholder="Nome...">
                                </div>
                                <label for="mlist-company" class="col-lg-2 col-form-label">Azienda</label>
                                <div class="input-group col-lg-4">
                                    <select class="custom-select clear-select col-12"  id="mlist-company" name="mlist-company">
                                        <option value="-1">Seleziona azienda...</option>
                                        % foreach my $company (@{$companies}){
                                            % if ($company->{'comp_id'} != 1){
                                            <option value="<%= $company->{'comp_id'} %>"><%= $company->{'comp_name'}%></option>
                                            % }
                                        % }
                                    </select>
                                </div>
                            </div>

                            <div class="form-group row">
                                <label for="mlist-desc" class="col-lg-2 col-form-label">Descrizione </label>
                                <div class="col-lg-10">
                                    <textarea class="form-control clear-input" rows="2" id="mlist-desc" name="mlist-desc"></textarea>
                                </div>
                            </div>

                            <h5 class="divider-title">Inserisci utenti del portale ed esterni</h5>
                            <div class="form-group row">
                                <label for="mlist-users" class="col-lg-2 col-form-label">Utenti <span class="text-danger">*</span></label>
                                <div class="col-lg-4">
                                    <select name="from[]" id="multiselect" class="form-control multi-style" size="15" multiple="multiple">
                                        <optgroup label="Utenti del portale">
                                            % foreach my $user (@{$users}){
                                                <option value="port-<%= $user->{'us_id'} %>"><%= $user->{'us_email'}%> - <%= $user->{'us_name'}%> <%= $user->{'us_surname'}%></option>
                                            % }
                                        </optgroup>

                                    </select>
                                </div>

                                <div class="col-lg-2 m-t-45">
                                    <button type="button" id="multiselect_rightAll" class="btn btn-block"><i class="fa fa-angle-double-right"></i></button>
                                    <button type="button" id="multiselect_rightSelected" class="btn btn-block"><i class="fa fa-angle-right"></i></button>
                                    <button type="button" id="multiselect_leftSelected" class="btn btn-block"><i class="fa fa-angle-left"></i></button>
                                    <button type="button" id="multiselect_leftAll" class="btn btn-block"><i class="fa fa-angle-double-left"></i></button>
                                </div>

                                <div class="col-lg-4">
                                    <select name="mlist-selected-users[]" id="mlist-selected-users" class="form-control multi-style" size="15" multiple="multiple">
                                    </select>
                                </div>
                            </div>

                            <hr class="m-t-30">
                            <div class="form-group row">
                                <div class="col-md-12">
                                    <button type="submit" class="btn btn-success" name="mlist-save" id="mlist-save"> <i class="ti-save"></i> Inserisci</button>
                                    <button type="button" class="btn btn-inverse" name="mlist-cancel" id="mlist-cancel">Annulla</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Email esterne -->
            <div class="tab-pane p-20" id="tab-ext" role="tabpanel">
                <h4 class="box-title text-primary m-b-5">Gestisci le <strong>Email Esterne</strong> al tuo portale</h4>
                <h6 class="tab-subtitle">Elenco delle <code>Email Esterne</code> al tuo portale, inseriscile qui in modo che possano ricevere le tue emails.</h6>
                <hr class="m-t-0 m-b-20">
                % if ($user_grants->{user_insert}){
                <div class="row m-b-20">
                    <div class="col-lg-12">
                            <div class="new-external-email bobo-inline-form">
                                <h4 class="box-title">Inserisci <strong>nuova EMAIL</strong> <span class="text-danger">*</span></h4>
                                <hr class="m-t-0 m-b-20">
                                <form class="form" id="form-email">
                                    <input type="hidden" class="clear-input" id="email-id" name="email-id" value="">
                                    <div class="row m-b-10">
                                        <div class="col-lg-6">
                                            <input type="text" class="form-control clear-input" id="email-name" name="email-name" placeholder="Nome...">
                                        </div>
                                        <div class="col-lg-6">
                                            <input type="text" class="form-control clear-input" id="email-surname" name="email-surname" placeholder="Cognome...">
                                        </div>
                                    </div>
                                    <div class="row m-b-10">
                                        <div class="col-lg-6">
                                            <input type="email" class="form-control clear-input" id="email-mail" name="email-mail" placeholder="Email...">
                                        </div>
                                        <div class="col-lg-6">
                                            <select class="custom-select clear-select col-md-12"  id="email-company" name="email-company">
                                                <option value="-1">Seleziona azienda...</option>
                                                % foreach my $company (@{$companies}){
                                                    % if ($company->{'comp_id'} != 1){
                                                    <option value="<%= $company->{'comp_id'} %>"><%= $company->{'comp_name'}%></option>
                                                    % }
                                                % }
                                            </select>
                                        </div>
                                    </div>
                                    <p><span class="text-danger">*</span> L'utente <strong>NON DEVE avere</strong> un account nel tuo portale</p>
                                    <div class="row">
                                        <div class="col-md-12">
                                            <button type="submit" class="btn btn-success" name="email-save" id="email-save"> <i class="ti-save"></i> Salva</button>
                                            <button type="button" class="btn btn-inverse" name="email-cancel" id="email-cancel">Annulla</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                    </div>
                </div>
                % }

                <table id="email-table" class="display responsive table table-hover table-striped" cellspacing="0" width="100%">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Nome</th>
                            <th>Cognome</th>
                            <th>Email</th>
                            <th>Azienda</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                    <tfoot>
                        <tr>
                            <th></th>
                            <th>Nome</th>
                            <th>Cognome</th>
                            <th>Email</th>
                            <th>Azienda</th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>

            </div>

        </div>
    </div>
</div>