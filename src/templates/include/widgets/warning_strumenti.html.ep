<script src="<%=url_for(helperGetFileVersion('/bobo-js/include/widgets/warning_strumenti.js'))%>" type="text/javascript"></script>

<div class="card">
    <div class="preloader-mini" id="preloader-warnings">
        <span class="fa-stack fa-4x">
            <i class="fa-thin fa-bahai fa-stack-2x fa-flip text-warning"  style="--fa-animation-duration: 2s; opacity: 0.9; text-shadow: 2px 2px 3px #ddd;"></i>
            <i class="fa-duotone fa-mug-hot fa-stack-1x fa-beat" style="font-size: 0.7em; line-height: 2.6em; --fa-flip-x: 0; --fa-secondary-opacity: 1.0; --fa-primary-color: #2293b5; --fa-secondary-color: #dc5a08; text-shadow: 2px 2px 3px #cacaca;"></i>
            <!-- fa-spin-pulse fa-beat -->
        </span>
    </div>
    <div class="card-body table-hp">
        <h4 class="card-title"><i class="icon-flag"></i> Warning dagli strumenti</h4>
        <h6 class="card-subtitle">Elenco delle <code>stazioni</code> che hanno degli <strong>strumenti in warning</strong> suddivisi per categoria.</h6>

        <div id="warnings">
            <div class="row m-b-10">
                <div class="col-md-12">
                    <select class="custom-select col-12">
                        % if(defined $page_options->{'warnings'}){
                            % foreach my $warn (@{$page_options->{'warnings'}}){
                                <option value="<%= $warn->{'value'} %>"><%= $warn->{'label'} %></option>
                            % }
                        % }
                        % else{
                            <option value="1">FAI Swam</option>
                            <option value="2">Tecora Skypost</option>
                            <option value="3">COMDE Derenda</option>
                            <option value="4">Envea MP101M</option>
                            <option value="5">MetOne BC1054</option>
                            <option value="6">Palas Fidas200</option>
                            <option value="7">Teledyne API</option>
                        % }

                    </select>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <h5 class="mt-0 m-b-10"></h5>
                    <table id="instrument-table" class="table table-hover table-striped table-compressed m-b-0">
                        <thead>
                            <tr>
                                <th>Data ora</th>
                                <th>Provincia</th>
                                <th>Stazione</th>
                                <th class="text-center">N° warning</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <%
        foreach my $row ( @{$options} ) {
            foreach my $widget ( @{$row} ){
                if($widget->{'wdg_page_html'} eq '/warning_strumenti'){

                    my $dest = $widget->{'gw_dest'};
                    if( $dest->{'type'} eq 'default'){
    %>
                    <div class="card-footer">
                        <a href="/dat_warning" class="show-more"><i class="mdi mdi-library-plus"></i> Visualizza tutto &raquo;</a>
                    </div>
    <%
                    }
                    elsif( $dest->{'type'} eq 'page' || $dest->{'type'} eq 'external' ){
    %>
                    <div class="card-footer">
                        <a href="<%= $dest->{'link'} %>" class="show-more"><i class="mdi mdi-library-plus"></i> <%= $dest->{'title'} %> &raquo;</a>
                    </div>
    <%
                    }
                }
            }
        }
    %>
</div>