<script src="<%=url_for(helperGetFileVersion('/bobo-js/include/widgets/links.js'))%>" type="text/javascript"></script>

<div class="card">
    <div class="preloader-mini" id="preloader-links">
        <span class="fa-stack fa-4x">
            <i class="fa-thin fa-bahai fa-stack-2x fa-flip text-warning"  style="--fa-animation-duration: 2s; opacity: 0.9; text-shadow: 2px 2px 3px #ddd;"></i>
            <i class="fa-duotone fa-mug-hot fa-stack-1x fa-beat" style="font-size: 0.7em; line-height: 2.6em; --fa-flip-x: 0; --fa-secondary-opacity: 1.0; --fa-primary-color: #2293b5; --fa-secondary-color: #dc5a08; text-shadow: 2px 2px 3px #cacaca;"></i>
            <!-- fa-spin-pulse fa-beat -->
        </span>
    </div>
    <div class="card-body" id="widget-links">
        <!-- TODO da riattivare per aggiungere link nuovi -->
        <!-- <a href="#" class="add-link"><i class="icon-plus"></i></a> -->
        <form id="add-my-link" class="form-vertical-line">
            <h4 class="card-title"><i class="icon-plus"></i> Aggiungi un nuovo link</h4>
            <div class="form-group row">
                <label for="link-url" class="col-12 col-form-label">Link</label>
                <div class="col-12">
                    <select class="form-control col-12" id="link-url" name="link-url">

                    </select>
                    <!-- <input type="url" class="form-control clear-input" id="link-url" name="link-url" > -->
                </div>
                <label for="link-ttl" class="col-12 col-form-label">Titolo</label>
                <div class="col-12">
                    <input type="text" class="form-control clear-input" id="link-ttl" name="link-ttl" placeholder="Titolo...">
                </div>
            </div>
            <!-- <div>
                <input type="checkbox" class="ckb-banner" data-onstyle="success" data-offstyle="danger" data-on="SI" data-off="NO" data-size="sm" data-style="android">&nbsp;&nbsp;Aggiungi un banner
            </div>
            <div class="form-group row" id="add-my-banner">
                <label for="link-attach" class="col-12 col-form-label text-danger">Per aggiungere un banner, inserire immagine.</label>
                <div class="col-12">
                    <div id="link-attach" class="dropzone"></div>
                </div>
            </div> -->
            <div class="form-group row">
                <div class="col-12 m-t-15">
                    <button type="submit" class="btn btn-sm btn-info" name="btn-link-form" id="btn-link-form"> <i class="ti-save"></i> Inserisci</button>
                    <button type="button" class="btn btn-sm btn-inverse" name="cancel-link-form" id="cancel-link-form">Annulla</button>
                </div>
            </div>
        </form>
        <h4 class="card-title"><i class="icon-link"></i> Link Utili</h4>
        <h6 class="card-subtitle">Raccolta dei <code>link utili</code> da utilizzare a <strong>supporto lavorativo</strong>.</h6>
        <hr class="hp-dotted">
        <div class="link-bottom m-b-5">
            <ul id="sortable-img" class="bobo-sortable-img">
            </ul>
        </div>
        <div class="link-top">
            <ul id="sortable" class="bobo-sortable">
            </ul>
        </div>
    </div>
    <%
        foreach my $row ( @{$options} ) {
            foreach my $widget ( @{$row} ){
                if($widget->{'wdg_page_html'} eq '/links'){

                    my $dest = $widget->{'gw_dest'};
                    if( $dest->{'type'} eq 'page' || $dest->{'type'} eq 'external' ){
    %>
                    <div class="card-footer">
                        <span class="show-more">
                            <a href="<%= $dest->{'link'} %>" class="show-more"><i class="mdi mdi-library-plus"></i> <%= $dest->{'title'} %> &raquo;</a>
                        </span>
                    </div>
    <%
                    }
                }
            }
        }
    %>
</div>