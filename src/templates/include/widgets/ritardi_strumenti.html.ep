<script src="<%=url_for(helperGetFileVersion('/bobo-js/include/widgets/ritardi_strumenti.js'))%>" type="text/javascript"></script>

<div class="card">
    <div class="preloader-mini" id="preloader-instr-delays">
        <span class="fa-stack fa-4x">
            <i class="fa-thin fa-bahai fa-stack-2x fa-flip text-warning"  style="--fa-animation-duration: 2s; opacity: 0.9; text-shadow: 2px 2px 3px #ddd;"></i>
            <i class="fa-duotone fa-mug-hot fa-stack-1x fa-beat" style="font-size: 0.7em; line-height: 2.6em; --fa-flip-x: 0; --fa-secondary-opacity: 1.0; --fa-primary-color: #2293b5; --fa-secondary-color: #dc5a08; text-shadow: 2px 2px 3px #cacaca;"></i>
            <!-- fa-spin-pulse fa-beat -->
        </span>
    </div>
    <div class="card-body table-hp">
        <h4 class="card-title">
            <i class="icon-refresh"></i> Update strumenti per stazioni
            <a class="mytooltip" href="javascript:void(0)">
                <i class="fa-regular fa-circle-info text-info"></i>
                <span class="tooltip-content5 tooltip-legend"><span class="tooltip-text3"><span class="tooltip-inner2">
                    <div class="p-15">
                        <h5 class="font-bold">Legenda colori strumenti</h5>
                        <strong>Colori per il BTX:</strong>
                        <ul class="ul-legend-centered">
                            <li><i class="fa-sharp fa-solid fa-square text-purple"></i> ritardo negativo (acquisizioni nel futuro);</li>
                            <li><i class="fa-sharp fa-solid fa-square text-danger"></i> assenza di dati o ritardo maggiore di 3 ore;</li>
                            <li><i class="fa-sharp fa-solid fa-square text-warning"></i> ritardo compreso tra 2 e 3 ore;</li>
                            <li><i class="fa-sharp fa-solid fa-square text-success"></i> tutti gli altri casi.</li>
                        </ul>
                        <strong>Colori per altro strumento:</strong>
                        <ul class="ul-legend-centered">
                            <li><i class="fa-sharp fa-solid fa-square text-purple"></i> ritardo negativo (acquisizioni nel futuro);</li>
                            <li><i class="fa-sharp fa-solid fa-square text-danger"></i> assenza di dati o ritardo maggiore di 2 ore;</li>
                            <li><i class="fa-sharp fa-solid fa-square text-warning"></i> ritardo compreso tra 1 e 2 ore;</li>
                            <li><i class="fa-sharp fa-solid fa-square text-success"></i> tutti gli altri casi.</li>
                        </ul>
                    </div>
                </span></span></span>
            </a>
            <a href="#" class="btn btn-small btn-warning btn-rounded pull-right" data-toggle="modal" data-target="#parameters-late">Ritardi param.</a>
        </h4>
        <h6 class="card-subtitle">Aggiornamento dei <strong>singoli strumenti per stazione</strong>, ultimo dato atteso <code id="instr-delays-utc-time"></code>.</h6>
        <table id="instr-delays-table" class="display table table-hover table-striped" cellspacing="0" width="100%">
            <thead>
                <tr>
                    <th>Order</th>
                    <th>Header</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
    <%
        foreach my $row ( @{$options} ) {
            foreach my $widget ( @{$row} ){
                if($widget->{'wdg_page_html'} eq '/ritardi'){

                    my $dest = $widget->{'gw_dest'};
                    if( $dest->{'type'} eq 'page' || $dest->{'type'} eq 'external' ){
    %>
                    <div class="card-footer">
                        <span class="show-more">
                            <a href="<%= $dest->{'link'} %>" class="show-more"><i class="mdi mdi-library-plus"></i> <%= $dest->{'title'} %> &raquo;</a>
                        </span>
                    </div>
    <%
                    }
                }
            }
        }
    %>
</div>





<!-- MODAL RITARDI RICEZIONE DATI -->
<div class="modal fade" id="parameters-late" tabindex="-1" role="dialog" aria-labelledby="parameters-late" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md" role="document">
        <div class="modal-content content-calendar">
            <div class="modal-header">
                <h5 class="modal-title text-primary"><i class="fa-sharp fa-regular fa-alarm-exclamation"></i> Ricezione dati in ritardo <strong>nell'ultima settimana</strong></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p><strong class="text-info font-italic">Seleziona una stazione:</strong> per ogni parametro in ritardo puoi vedere <strong>la data di ricezione dell'ultimo dato ed il conseguente GAP</strong>.</p>
                <p>
                    <select class="custom-select col-12" id="select-late-stat-param">
                    </select>
                </p>
                <table class="table table-striped table-compressed" id="table-hp-params">
                    <thead>
                        <tr>
                            <!-- <th></th> -->
                            <th>Parametro</th>
                            <th>
                                Data
                                <a class="mytooltip" href="javascript:void(0)">
                                    <i class="fa-regular fa-circle-info text-info"></i>
                                    <span class="tooltip-content5"><span class="tooltip-text3"><span class="tooltip-inner2">Data di riferimento del valore misurato, espressa in <strong>UTC+1 anticipata</strong>.<br>(Es: 06 indica un valore acquisito dalle h. 06 alle 07)</span></span></span>
                                </a>
                            </th>
                            <th>
                                Ricezione
                                <a class="mytooltip" href="javascript:void(0)">
                                    <i class="fa-regular fa-circle-info text-info"></i>
                                    <span class="tooltip-content5"><span class="tooltip-text3"><span class="tooltip-inner2">Data di ricezione al centro del valore misurato, espressa in <strong>UTC+1</strong>.</span></span></span>
                                </a>
                            </th>
                            <th>GAP</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-link text-danger" data-dismiss="modal"><i class="ti-close"></i> Chiudi</button>
            </div>
        </div>
    </div>
</div>