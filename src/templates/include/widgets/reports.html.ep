
<script src="<%=url_for(helperGetFileVersion('/bobo-js/include/widgets/reports.js'))%>" type="text/javascript"></script>

<div class="card">
    <div class="preloader-mini" id="preloader-reports">
        <span class="fa-stack fa-4x">
            <i class="fa-thin fa-bahai fa-stack-2x fa-flip text-warning"  style="--fa-animation-duration: 2s; opacity: 0.9; text-shadow: 2px 2px 3px #ddd;"></i>
            <i class="fa-duotone fa-mug-hot fa-stack-1x fa-beat" style="font-size: 0.7em; line-height: 2.6em; --fa-flip-x: 0; --fa-secondary-opacity: 1.0; --fa-primary-color: #2293b5; --fa-secondary-color: #dc5a08; text-shadow: 2px 2px 3px #cacaca;"></i>
            <!-- fa-spin-pulse fa-beat -->
        </span>
    </div>
    <div class="card-body">
        <h4 class="card-title"><i class="fa-regular fa-pen-ruler"></i> Report tarature e manutenzioni</h4>
        <h6 class="card-subtitle">Ultimi <code>report</code> di tarature o manutenzioni effettuati sulla tua rete.</h6>
        <!-- <hr class="hp-dotted m-b-20"> -->
        <table id="reports-tbl" class="table tbl-rep m-b-0" cellspacing="0" width="100%">
            <!-- <tr class="tbl-top">
                <td class="bobo-nowrap operators" rowspan="2">
                    <img src="/bobo-img/default/avatar/ava-admin.png">
                </td>
                <td><strong>Elisa Malloci - <a href="">Taratura</a> in:</strong> Parco Santa Chiara (TN)</td>
                <td class="text-info text-right">4gg fa</td>
            </tr>
            <tr class="tbl-bottom">
                <td colspan="2">
                    <strong>610246 - Tecora SENTINEL PM:</strong> Carico filtri<br>
                    <strong>610246 - Tecora SENTINEL PM:</strong> Carico filtri<br>
                    <strong>Note:</strong> Riprogrammato campionamento (24 filtri)
                </td>
            </tr> -->
        </table>
    </div>
    <%
        foreach my $row ( @{$options} ) {
            foreach my $widget ( @{$row} ){
                if($widget->{'wdg_page_html'} eq '/reports'){

                    my $dest = $widget->{'gw_dest'};
                    if( $dest->{'type'} eq 'default'){
    %>
                    <div class="card-footer">
                        <span class="show-more">
                            <i class="mdi mdi-library-plus"></i> Visualizza dettagli <a href="/rep_qa_tarature">tarature</a> e <a href="/rep_qa_manutenzioni">manutenzioni</a> &raquo;
                        </span>
                    </div>
    <%
                    }
                    elsif( $dest->{'type'} eq 'page' || $dest->{'type'} eq 'external' ){
    %>
                    <div class="card-footer">
                        <span class="show-more">
                            <a href="<%= $dest->{'link'} %>" class="show-more"><i class="mdi mdi-library-plus"></i> <%= $dest->{'title'} %> &raquo;</a>
                        </span>
                    </div>
    <%
                    }
                }
            }
        }
    %>

</div>