% layout 'default';
% title 'QA - report tarature';

<script src="<%=url_for(helperGetFileVersion('/bobo-js/report/qa_tarature.js'))%>" type="text/javascript"></script>

<script type="text/javascript">
    // arriving from server, id visible in page's url
    var rpid = '<%= $rpid %>';
</script>
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-11">
                        <h4 class="card-title">Visualizza i report TARATURE inseriti</h4>
                        <h6 class="card-subtitle">Clicca sul singolo report che vuoi visualizzare</h6>
                    </div>
                </div>

                <!-- Nav tabs -->
                <ul class="nav nav-tabs customtab main-tab" role="tablist">
                    <li class="nav-item"> <a class="nav-link active" data-toggle="tab" href="#report-list" role="tab"><span class="hidden-sm-up"><i class="mdi mdi-view-grid"></i></span> <span class="hidden-xs-down">Report</span></a> </li>
                    <!-- if user has insert grant -->
                    % if ($user_grants->{user_insert}){
                        <li class="nav-item"> <a class="nav-link text-info" data-toggle="tab" href="#new" id="new-report" role="tab"><span class="hidden-sm-up"><i class="mdi mdi-library-plus"></i></span> <span class="hidden-xs-down" id="inner-new-report">Nuovo</span></a> </li>
                    % }
               </ul>

                <!-- Tab panes -->
                <div class="tab-content">
                    <div class="tab-pane p-20 active" id="report-list" role="tabpanel">
                        <div class="row m-b-10 show-space-between-med">
                            <div class="input-group col-md-3">
                                <input class="form-control input-daterange-datepicker" type="text" name="daterange" value="" />
                                <div class="input-group-append">
                                    <span class="input-group-text"><i class="mdi mdi-calendar-multiple"></i></span>
                                </div>
                            </div>
                            <div class=" col-md-2">
                                <select class="custom-select col-12" id="networks" name="networks">
                                    <option value="-1">Seleziona rete...</option>
                                    % foreach my $net (@{$networks}){
                                        <option value="<%= $net->{'st_network_id'} %>"><%= $net->{'st_network_desc'} %></option>
                                    % }
                                </select>
                            </div>
                            <div class=" col-md-2">
                                <select class="custom-select col-12" id="provinces" name="provinces" data-change="stations">
                                    <option value="-1">Seleziona provincia...</option>
                                </select>
                            </div>
                            <div class=" col-md-3">
                                <select class="custom-select col-12" id="stations" name="stations">
                                    <option value="-1">Seleziona stazione...</option>
                                </select>
                            </div>
                            <div class=" col-md-2">
                                <select class="custom-select col-12" id="str-categories" name="str-categories">
                                    <option value="-1">Tutti gli strumenti</option>
                                    % foreach my $category (@{$categories}){
                                        <option value="<%= $category->{'category_id'} %>"><%= $category->{'category_name'} %></option>
                                    % }
                                </select>
                            </div>
                        </div>
                        <table id="report-table" class="display responsive table table-hover table-striped tbl-va-center" cellspacing="0" width="100%">
                            <thead>
                                <tr>
                                    <th class="bobo-nowrap"></th>
                                    <th class="bobo-nowrap">Data</th>
                                    <th>Operatore</th>
                                    <th>Rete</th>
                                    <th>Stazione</th>
                                    <th>Strumento</th>
                                    <th>Zero</th>
                                    <th class="bobo-nowrap">Zero T.</th>
                                    <th>Span</th>
                                    <th class="bobo-nowrap">Span T.</th>
                                    <th>Note</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>

                            </tbody>
                            <tfoot>
                                <tr>
                                    <th class="bobo-nowrap"></th>
                                    <th class="bobo-nowrap">Data</th>
                                    <th>Operatore</th>
                                    <th>Rete</th>
                                    <th>Stazione</th>
                                    <th>Strumento</th>
                                    <th>Zero</th>
                                    <th class="bobo-nowrap">Zero T.</th>
                                    <th>Span</th>
                                    <th class="bobo-nowrap">Span T.</th>
                                    <th>Note</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <div class="tab-pane p-20" id="new" role="tabpanel">
                        <h4 class="box-title">Inserisci nuova TARATURA</h4>
                        <hr class="m-t-0 m-b-20">
                        <form class="form form-medium" id="form-calib" name="form-calib">
                            <input type="hidden" id="report-caid" name="report-caid" value="">
                            <!-- parte iniziale -->
                            <!-- <div class="alert alert-danger alert-rounded"> <i class="icon-flag"></i> Parte iniziale = per tutti
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close"> <span aria-hidden="true">×</span> </button>
                            </div> -->
                            <div class="form-group row">
                                <label for="datetime-calib" class="col-md-2 col-form-label">Data e ora <span class="text-danger">*</span></label>
                                <div class="input-group col-md-4">
                                    <input type="text" class="form-control" id="datetime-calib" name="datetime-calib" placeholder="mm/dd/yyyy hh:mm">
                                    <div class="input-group-append">
                                        <span class="input-group-text"><i class="icon-calender"></i></span>
                                    </div>
                                </div>
                                <label for="prov-calib" class="col-md-2 col-form-label">Provincia</label>
                                <div class="col-md-4">
                                    <select class="custom-select col-12" id="prov-calib" name="prov-calib" data-change="station-calib">
                                        <option value="-1">Seleziona provincia...</option>
                                        % my $region = '';
                                        % foreach my $province (@{$provinces}){
                                            % if ($region eq ''){
                                                <optgroup label="<%= $province->{'region_name'} %>">
                                                <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                            % }else{
                                                % if ($region eq $province->{'region_id'}){
                                                    <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                                % } else {
                                                    </optgroup>
                                                    <optgroup label="<%= $province->{'region_name'} %>">
                                                    <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                                % }
                                            % }
                                            % $region = $province->{'region_id'};
                                        % }
                                        </optgroup>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="station-calib" class="col-md-2 col-form-label">Stazione <span class="text-danger">*</span></label>
                                <div class="col-md-4">
                                    <select class="custom-select col-12" id="station-calib" name="station-calib">
                                        <option value="-1">Seleziona...</option>
                                    </select>
                                </div>
                                <label for="instrument-calib" class="col-md-2 col-form-label">Strumento <span class="text-danger">*</span></label>
                                <div class="col-md-4">
                                    <select class="custom-select col-12" id="instrument-calib" name="instrument-calib">
                                        <option value="-1">Seleziona strumento...</option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="reason-calib" class="col-md-2 col-form-label">Motivo <span class="text-danger">*</span></label>
                                <div class="col-md-4">
                                    <select class="custom-select col-12" id="reason-calib" name="reason-calib">
                                        <option value="-1">Seleziona motivo...</option>
                                        % foreach my $reason (@{$reasons}){
                                            <option value="<%= $reason->{'reason_id'} %>"><%= $reason->{'reason_name'} %></option>
                                        % }
                                    </select>
                                </div>
                                <div class="col-md-6" id="row-multi" data-id="">
                                    <div class="form-group row">
                                        <label for="" class="col-md-4 col-form-label"></label>
                                        <div class="col-md-8">
                                            <input type="checkbox" class="js-switch" data-color="#79a030" id="flag-multi" name="flag-multi" />
                                            Taratura multipla
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                        <form class="form form-medium" id="form-calib-obj" name="form-calib-obj">
                            <!-- SO2 -->
                            <div id="so2" class="hide-fields-instrument">
                                <!-- <div class="alert alert-info alert-rounded"> <i class="icon-magic-wand"></i> SO2
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close"> <span aria-hidden="true">×</span> </button>
                                </div> -->

                                <h5 class="divider-title">Zero</h5>
                                <div class="form-group row">
                                    <label for="find-zero-so2" class="col-md-2 col-form-label">Zero trovato</label>
                                    <div class="col-md-4">
                                        <input class="form-control" type="text" value="" id="find-zero-so2" name="find-zero-so2" placeholder="Sep. decimale: PUNTO">
                                    </div>
                                    <div class="col-md-4 offset-md-2">
                                        <div class="custom-control custom-checkbox">
                                            <input type="checkbox" class="custom-control-input" id="mod-zero-so2" name="mod-zero-so2">
                                            <label class="custom-control-label" for="mod-zero-so2">Zero modificato</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <label for="tank-zero-so2" class="col-md-2 col-form-label">Bombola</label>
                                    <div class="col-md-4">
                                        <select class="tanks custom-select col-md-12" id="tank-zero-so2" name="tank-zero-so2">
                                            <option value="-1">Seleziona bombola...</option>
                                        </select>
                                    </div>
                                    <label for="method-zero-so2" class="col-md-2 col-form-label">Metodo</label>
                                    <div class="col-md-4">
                                        <select class="methods custom-select col-md-12" id="method-zero-so2" name="method-zero-so2">
                                            <option value="-1">Seleziona metodo...</option>
                                            <option value="0">Carbone</option>
                                            <option value="1">Zero</option>
                                            <option value="2">Scubber</option>
                                        </select>
                                    </div>
                                </div>

                                <h5 class="divider-title">Span</h5>
                                <div class="form-group row">
                                    <label for="tank-span-so2" class="col-md-2 col-form-label">Bombola</label>
                                    <div class="col-md-4">
                                        <select class="tanks custom-select col-12" id="tank-span-so2" name="tank-span-so2">
                                            <option value="-1">Seleziona bombola...</option>
                                        </select>
                                    </div>
                                    <label for="method-span-so2" class="col-md-2 col-form-label">Metodo</label>
                                    <div class="col-md-4">
                                        <select class="methods custom-select col-md-12" id="method-span-so2" name="method-span-so2">
                                            <option value="-1">Seleziona metodo...</option>
                                            <option value="0">Carbone</option>
                                            <option value="1">Zero</option>
                                            <option value="2">Scubber</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group row single-calibration" id="so2-single">
                                    <label for="read-span-so2" class="col-md-2 col-form-label">Span letto</label>
                                    <div class="col-md-4">
                                        <input class="form-control" type="text" value="" id="read-span-so2" name="read-span-so2" placeholder="Sep. decimale: PUNTO">
                                    </div>
                                    <label for="theory-span-so2" class="col-md-2 col-form-label">Span teorico</label>
                                    <div class="col-md-4">
                                        <input class="form-control" type="text" value="" id="theory-span-so2" name="theory-span-so2" placeholder="Sep. decimale: PUNTO">
                                    </div>
                                </div>

                                <div class="form-group row">
                                    <div class="col-md-4 offset-md-2">
                                        <div class="custom-control custom-checkbox">
                                            <input type="checkbox" class="custom-control-input" id="mod-span-so2" name="mod-span-so2">
                                            <label class="custom-control-label" for="mod-span-so2">Span modificato</label>
                                        </div>
                                    </div>
                                </div>

                                <div id="so2-multi" class="multiple-calibration">
                                    <div class="row-multi-label">
                                        <div class="multi-label-tag"><i class="icon-arrow-right-circle"></i> L1</div>
                                        <div class="form-group row multi-label-values">
                                            <label for="l1-read-span-so2" class="col-md-2 col-form-label">Span letto</label>
                                            <div class="col-md-4">
                                                <input class="form-control" type="text" value="" id="l1-read-span-so2" name="l1-read-span-so2" placeholder="Sep. decimale: PUNTO">
                                            </div>
                                            <label for="l1-theory-span-so2" class="col-md-2 col-form-label">Span teorico</label>
                                            <div class="col-md-4">
                                                <input class="form-control" type="text" value="" id="l1-theory-span-so2" name="l1-theory-span-so2" placeholder="Sep. decimale: PUNTO">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row-multi-label">
                                        <div class="multi-label-tag"><i class="icon-arrow-right-circle"></i> L2</div>
                                        <div class="form-group row multi-label-values">
                                            <label for="l2-read-span-so2" class="col-md-2 col-form-label">Span letto</label>
                                            <div class="col-md-4">
                                                <input class="form-control" type="text" value="" id="l2-read-span-so2" name="l2-read-span-so2" placeholder="Sep. decimale: PUNTO">
                                            </div>
                                            <label for="l2-theory-span-so2" class="col-md-2 col-form-label">Span teorico</label>
                                            <div class="col-md-4">
                                                <input class="form-control" type="text" value="" id="l2-theory-span-so2" name="l2-theory-span-so2" placeholder="Sep. decimale: PUNTO">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row-multi-label">
                                        <div class="multi-label-tag"><i class="icon-arrow-right-circle"></i> L3</div>
                                        <div class="form-group row multi-label-values">
                                            <label for="l3-read-span-so2" class="col-md-2 col-form-label">Span letto</label>
                                            <div class="col-md-4">
                                                <input class="form-control" type="text" value="" id="l3-read-span-so2" name="l3-read-span-so2" placeholder="Sep. decimale: PUNTO">
                                            </div>
                                            <label for="l3-theory-span-so2" class="col-md-2 col-form-label">Span teorico</label>
                                            <div class="col-md-4">
                                                <input class="form-control" type="text" value="" id="l3-theory-span-so2" name="l3-theory-span-so2" placeholder="Sep. decimale: PUNTO">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row-multi-label">
                                        <div class="multi-label-tag"><i class="icon-arrow-right-circle"></i> L4</div>
                                        <div class="form-group row multi-label-values">
                                            <label for="l4-read-span-so2" class="col-md-2 col-form-label">Span letto</label>
                                            <div class="col-md-4">
                                                <input class="form-control" type="text" value="" id="l4-read-span-so2" name="l4-read-span-so2" placeholder="Sep. decimale: PUNTO">
                                            </div>
                                            <label for="l4-theory-span-so2" class="col-md-2 col-form-label">Span teorico</label>
                                            <div class="col-md-4">
                                                <input class="form-control" type="text" value="" id="l4-theory-span-so2" name="l4-theory-span-so2" placeholder="Sep. decimale: PUNTO">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row-multi-label">
                                        <div class="multi-label-tag"><i class="icon-arrow-right-circle"></i> L5</div>
                                        <div class="form-group row multi-label-values">
                                            <label for="l5-read-span-so2" class="col-md-2 col-form-label">Span letto</label>
                                            <div class="col-md-4">
                                                <input class="form-control" type="text" value="" id="l5-read-span-so2" name="l5-read-span-so2" placeholder="Sep. decimale: PUNTO">
                                            </div>
                                            <label for="l5-theory-span-so2" class="col-md-2 col-form-label">Span teorico</label>
                                            <div class="col-md-4">
                                                <input class="form-control" type="text" value="" id="l5-theory-span-so2" name="l5-theory-span-so2" placeholder="Sep. decimale: PUNTO">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- NOx NO NO2 -->
                            <div id="noxnono2" class="hide-fields-instrument">
                                <!-- <div class="alert alert-info alert-rounded"> <i class="icon-magic-wand"></i> NOx NO NO2
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close"> <span aria-hidden="true">×</span> </button>
                                </div> -->

                                <h5 class="divider-title">Zero</h5>
                                <div class="form-group form-labels row disappear-med">
                                    <label for="nox-zero-noxnono2" class="col-md-3 offset-md-2 col-form-label">NOx</label>
                                    <label for="no-zero-noxnono2" class="col-md-4 col-form-label">NO</label>
                                    <label for="no2-zero-noxnono2" class="col-md-3 col-form-label">NO2</label>
                                </div>
                                <div class="form-group row show-space-med">
                                    <label for="" class="col-md-2 col-form-label">Zero trovato</label>
                                    <div class="col-md-3">
                                        <input class="form-control" type="text" value="" id="nox-zero-noxnono2" name="nox-zero-noxnono2" placeholder="NOX - Sep. decimale: PUNTO">
                                    </div>
                                    <div class="col-md-4">
                                        <input class="form-control" type="text" value="" id="no-zero-noxnono2" name="no-zero-noxnono2" placeholder="NO - Sep. decimale: PUNTO">
                                    </div>
                                    <div class="col-md-3">
                                        <input class="form-control" type="text" value="" id="no2-zero-noxnono2" name="no2-zero-noxnono2" placeholder="NO2 - Sep. decimale: PUNTO">
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-md-4 offset-md-2">
                                        <div class="custom-control custom-checkbox">
                                            <input type="checkbox" class="custom-control-input" id="mod-zero-noxnono2" name="mod-zero-noxnono2">
                                            <label class="custom-control-label" for="mod-zero-noxnono2">Zero modificato</label>
                                        </div>
                                    </div>
                                    <label for="method-zero-noxnono2" class="col-md-2 col-form-label">Metodo</label>
                                    <div class="col-md-4">
                                        <select class="methods custom-select col-12" id="method-zero-noxnono2" name="method-zero-noxnono2">
                                            <option value="-1">Seleziona...</option>
                                            <option value="0">Carbone</option>
                                            <option value="1">Zero</option>
                                            <option value="2">Scubber</option>
                                        </select>
                                    </div>
                                </div>

                                <h5 class="divider-title">Span</h5>
                                <div class="form-group row">
                                    <label for="tank-span-noxnono2" class="col-md-2 col-form-label">Bombola</label>
                                    <div class="col-md-4">
                                        <select class="tanks custom-select col-12" id="tank-span-noxnono2" name="tank-span-noxnono2">
                                            <option value="-1">Seleziona bombola...</option>
                                        </select>
                                    </div>
                                    <label for="method-span-noxnono2" class="col-md-2 col-form-label">Metodo</label>
                                    <div class="col-md-4">
                                        <select class="methods custom-select col-12" id="method-span-noxnono2" name="method-span-noxnono2">
                                            <option value="-1">Seleziona metodo...</option>
                                            <option value="0">Carbone</option>
                                            <option value="1">Zero</option>
                                            <option value="2">Scubber</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="single-calibration" id="noxnono2-single">
                                    <div class="form-group form-labels row disappear-med">
                                        <label for="" class="col-md-3 offset-md-2 col-form-label">NOx</label>
                                        <label for="" class="col-md-4 col-form-label">NO</label>
                                        <label for="" class="col-md-3 col-form-label">NO2</label>
                                    </div>
                                    <div class="form-group row show-space-med">
                                        <label for="" class="col-md-2 col-form-label">Span letto</label>
                                        <div class="col-md-3">
                                            <input class="form-control" type="text" value="" id="read-nox-span-noxnono2" name="read-nox-span-noxnono2" placeholder="NOX - Sep. decimale: PUNTO">
                                        </div>
                                        <div class="col-md-4">
                                            <input class="form-control" type="text" value="" id="read-no-span-noxnono2" name="read-no-span-noxnono2" placeholder="NO - Sep. decimale: PUNTO">
                                        </div>
                                        <div class="col-md-3">
                                            <input class="form-control" type="text" value="" id="read-no2-span-noxnono2" name="read-no2-span-noxnono2" placeholder="NO2 - Sep. decimale: PUNTO">
                                        </div>
                                    </div>
                                    <div class="form-group row show-space-med">
                                        <label for="" class="col-md-2 col-form-label">Span teorico</label>
                                        <div class="col-md-3">
                                            <input class="form-control" type="text" value="" id="theory-nox-span-noxnono2" name="theory-nox-span-noxnono2" placeholder="NOX - Sep. decimale: PUNTO">
                                        </div>
                                        <div class="col-md-4">
                                            <input class="form-control" type="text" value="" id="theory-no-span-noxnono2" name="theory-no-span-noxnono2" placeholder="NO - Sep. decimale: PUNTO">
                                        </div>
                                        <div class="col-md-3">
                                            <input class="form-control" type="text" value="" id="theory-no2-span-noxnono2" name="theory-no2-span-noxnono2" placeholder="NO2 - Sep. decimale: PUNTO">
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group row">
                                    <div class="col-md-4 offset-md-2">
                                        <div class="custom-control custom-checkbox">
                                            <input type="checkbox" class="custom-control-input" id="mod-span-noxnono2" name="mod-span-noxnono2">
                                            <label class="custom-control-label" for="mod-span-noxnono2">Span modificato</label>
                                        </div>
                                    </div>
                                </div>

                                <div id="noxnono2-multi" class="multiple-calibration">
                                    <div class="row-multi-label">
                                        <div class="multi-label-tag"><i class="icon-arrow-right-circle"></i> L1</div>
                                        <div class="multi-label-values">
                                            <div class="form-group form-labels row disappear-med">
                                                <label for="" class="col-md-4 offset-md-3 col-form-label">NOx</label>
                                                <label for="" class="col-md-5 col-form-label">NO</label>
                                            </div>
                                            <div class="form-group row">
                                                <label for="" class="col-md-3 col-form-label">Span letto</label>
                                                <div class="col-md-4">
                                                    <input class="form-control" type="text" value="" id="l1-read-nox-span-noxnono2" name="l1-read-nox-span-noxnono2" placeholder="NOX - Sep. decimale: PUNTO">
                                                </div>
