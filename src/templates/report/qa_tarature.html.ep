                                        <input class="form-control" type="text" value="" id="ch4-zero-biogas" name="ch4-zero-biogas" placeholder="Sep. decimale: PUNTO">
                                    </div>
                                    <div class="col-md-3">
                                        <input class="form-control" type="text" value="" id="co2-zero-biogas" name="co2-zero-biogas" placeholder="Sep. decimale: PUNTO">
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-md-4 offset-md-2">
                                        <div class="custom-control custom-checkbox">
                                            <input type="checkbox" class="custom-control-input" id="mod-zero-biogas" name="mod-zero-biogas">
                                            <label class="custom-control-label" for="mod-zero-biogas">Zero modificato</label>
                                        </div>
                                    </div>
                                    <label for="method-zero-biogas" class="col-2 col-form-label">Metodo</label>
                                    <div class="col-md-4">
                                        <select class="methods custom-select col-12" id="method-zero-biogas" name="method-zero-biogas">
                                            <option value="-1">Seleziona...</option>
                                            <option value="0">Carbone</option>
                                            <option value="1">Zero</option>
                                            <option value="2">Scubber</option>
                                        </select>
                                    </div>
                                </div>

                                <h5 class="divider-title">Span</h5>
                                <div class="form-group row">
                                    <label for="tank-span-biogas" class="col-md-2 col-form-label">Bombola</label>
                                    <div class="col-md-4">
                                        <select class="tanks custom-select col-12" id="tank-span-biogas" name="tank-span-biogas">
                                            <option value="-1">Seleziona bombola...</option>
                                        </select>
                                    </div>
                                    <label for="method-span-biogas" class="col-md-2 col-form-label">Metodo</label>
                                    <div class="col-md-4">
                                        <select class="methods custom-select col-md-12" id="method-span-biogas" name="method-span-biogas">
                                            <option value="-1">Seleziona metodo...</option>
                                            <option value="0">Carbone</option>
                                            <option value="1">Zero</option>
                                            <option value="2">Scubber</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="single-calibration" id="biogas-single">
                                    <div class="form-group form-labels row">
                                        <label for="" class="col-md-3 offset-md-2 col-form-label">O2</label>
                                        <label for="" class="col-md-4 col-form-label">CH4</label>
                                        <label for="" class="col-md-3 col-form-label">CO2</label>
                                    </div>
                                    <div class="form-group row">
                                        <label for="" class="col-md-2 col-form-label">Span letto</label>
                                        <div class="col-md-3">
                                            <input class="form-control" type="text" value="" id="read-o2-span-biogas" name="read-o2-span-biogas" placeholder="Sep. decimale: PUNTO">
                                        </div>
                                        <div class="col-md-4">
                                            <input class="form-control" type="text" value="" id="read-ch4-span-biogas" name="read-ch4-span-biogas" placeholder="Sep. decimale: PUNTO">
                                        </div>
                                        <div class="col-md-3">
                                            <input class="form-control" type="text" value="" id="read-co2-span-biogas" name="read-co2-span-biogas" placeholder="Sep. decimale: PUNTO">
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <label for="" class="col-md-2 col-form-label">Span teorico</label>
                                        <div class="col-md-3">
                                            <input class="form-control" type="text" value="" id="theory-o2-span-biogas" name="theory-o2-span-biogas" placeholder="Sep. decimale: PUNTO">
                                        </div>
                                        <div class="col-md-4">
                                            <input class="form-control" type="text" value="" id="theory-ch4-span-biogas" name="theory-ch4-span-biogas" placeholder="Sep. decimale: PUNTO">
                                        </div>
                                        <div class="col-md-3">
                                            <input class="form-control" type="text" value="" id="theory-co2-span-biogas" name="theory-co2-span-biogas" placeholder="Sep. decimale: PUNTO">
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group row">
                                    <div class="col-md-4 offset-md-2">
                                        <div class="custom-control custom-checkbox">
                                            <input type="checkbox" class="custom-control-input" id="mod-span-biogas" name="mod-span-biogas">
                                            <label class="custom-control-label" for="mod-span-biogas">Span modificato</label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Sonde -->
                            <div id="probe" class="hide-fields-instrument">
                                <!-- <div class="alert alert-info alert-rounded"> <i class="icon-magic-wand"></i> Temperatura Conducibilità Ph Redox
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close"> <span aria-hidden="true">×</span> </button>
                                </div> -->

                                <h5 class="divider-title">Sonda</h5>
                                <div class="form-group row">
                                    <label for="solution-probe" class="col-md-2 col-form-label">Soluzione</label>
                                    <div class="col-md-4">
                                        <select class="solutions custom-select col-md-12" id="solution-probe" name="solution-probe">
                                            <option value="-1">Seleziona soluzione...</option>
                                        </select>
                                    </div>
                                    <label for="method-probe" class="col-md-2 col-form-label">Metodo</label>
                                    <div class="col-md-4">
                                        <select class="methods custom-select col-12" id="method-probe" name="method-probe">
                                            <option value="-1">Seleziona metodo...</option>
                                            <option value="0">Carbone</option>
                                            <option value="1">Zero</option>
                                            <option value="2">Scubber</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="single-calibration" id="probe-single">
                                    <div class="form-group form-labels row">
                                        <label for="read-temp-probe" class="col-md-2 offset-md-2 col-form-label">Temperatura</label>
                                        <label for="read-cond-probe" class="col-md-2 col-form-label">Conducibilità</label>
                                        <label for="read-ph-probe" class="col-md-2 col-form-label">Ph</label>
                                        <label for="read-redox-probe" class="col-md-2 col-form-label">Redox</label>
                                    </div>
                                    <div class="form-group row">
                                        <label for="" class="col-md-2 col-form-label">Valore letto</label>
                                        <div class="col-md-2">
                                            <input class="form-control" type="text" value="" id="read-temp-probe" name="read-temp-probe" placeholder="Sep. decimale: PUNTO">
                                        </div>
                                        <div class="col-md-2">
                                            <input class="form-control" type="text" value="" id="read-cond-probe" name="read-cond-probe" placeholder="Sep. decimale: PUNTO">
                                        </div>
                                        <div class="col-md-2">
                                            <input class="form-control" type="text" value="" id="read-ph-probe" name="read-ph-probe" placeholder="Sep. decimale: PUNTO">
                                        </div>
                                        <div class="col-md-2">
                                            <input class="form-control" type="text" value="" id="read-redox-probe" name="read-redox-probe" placeholder="Sep. decimale: PUNTO">
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <label for="" class="col-md-2 col-form-label">Valore teorico</label>
                                        <div class="col-md-2">
                                            <input class="form-control" type="text" value="" id="theory-temp-probe" name="theory-temp-probe" placeholder="Sep. decimale: PUNTO">
                                        </div>
                                        <div class="col-md-2">
                                            <input class="form-control" type="text" value="" id="theory-cond-probe" name="theory-cond-probe" placeholder="Sep. decimale: PUNTO">
                                        </div>
                                        <div class="col-md-2">
                                            <input class="form-control" type="text" value="" id="theory-ph-probe" name="theory-ph-probe" placeholder="Sep. decimale: PUNTO">
                                        </div>
                                        <div class="col-md-2">
                                            <input class="form-control" type="text" value="" id="theory-redox-probe" name="theory-redox-probe" placeholder="Sep. decimale: PUNTO">
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group row">
                                    <div class="col-md-4 offset-md-2">
                                        <div class="custom-control custom-checkbox">
                                            <input type="checkbox" class="custom-control-input" id="mod-probe" name="mod-probe">
                                            <label class="custom-control-label" for="mod-probe">Taratura</label>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </form>

                        <form class="form form-medium" id="form-calib-close" name="form-calib-close">
                            <!-- parte finale -->
                            <!-- <div class="alert alert-danger alert-rounded"> <i class="icon-flag"></i> Parte finale = per tutti
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close"> <span aria-hidden="true">×</span> </button>
                            </div> -->
                            <h5 class="divider-title" >Allegati</h5>
                            <div class="row report-gallery-big m-b-10">
                                <div class="col-md-10 offset-md-2" id="att-container">

                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="report-add-attach" class="col-md-2 col-form-label">Aggiungi allegati</label>
                                <div class="col-md-10">
                                    <div id="report-add-attach" class="dropzone"></div>
                                    <!-- <input type="file" id="fileupload" name="fileupload" /> -->
                                </div>
                            </div>
                            <h5 class="divider-title">Annotazioni</h5>
                            <div class="form-group row">
                                <label for="notes-calib" class="col-md-2 col-form-label">Note</label>
                                <div class="col-md-10">
                                    <textarea class="form-control" rows="6" id="notes-calib" name="notes-calib"></textarea>
                                </div>
                            </div>
                            <hr class="m-t-30">
                            <div class="form-group row">
                                <div class="col-md-12">
                                    <button type="submit" class="btn btn-info" name="save-calib" id="save-calib"> <i class="ti-save"></i> Inserisci report</button>
                                    <button type="button" class="btn btn-inverse" name="cancel-calib" id="cancel-calib">Annulla</button>
                                </div>
                            </div>

                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>