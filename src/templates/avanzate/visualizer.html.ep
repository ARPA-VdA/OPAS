% layout 'default';
% title 'Avanzate - visualizer';

<script src="<%=url_for(helperGetFileVersion('/bobo-js/avanzate/visualizer.js'))%>" type="text/javascript"></script>

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-12">
                        <h4 class="card-title">Creazione <strong>pannelli di Visualizer</strong></h4>
                        <h6 class="card-subtitle">Pagina per la creazione dei pannelli da utilizzare in Visualizer</h6>
                        <div class="row" id="settings-main">
                            <div id="settings-tree" class="col-lg-3">
                                <h5 class="divider-title">Pannelli attuali</h5>
                                <div class="row">
                                    <div class="col-lg-12" id="subgroup-search">
                                        <input type="text" id="input-search" value="" class="form-control">
                                    </div>
                                    <div class="col-lg-12" id="group-json" >
                                    </div>
                                </div>
                            </div>
                            <div id="settings-form" class="col-lg-9">
                                <h5 class="divider-title">Aggiungi un nuovo pannello</h5>
                                <form id="panel-config" name="panel-config">
                                    <input type="hidden" class="form-control" id="panel-fill" name="panel-fill">
                                    <input type="hidden" class="form-control" id="panel-id" name="panel-id">
                                    <div class="form-group row">
                                        <label for="panel-name" class="col-sm-2 col-form-label">Nome pannello</label>
                                        <div class="col-sm-4">
                                            <input type="text" class="form-control" id="panel-name" name="panel-name" placeholder="Nome pannello...">
                                        </div>
                                        <label for="panel-group" class="col-sm-2 col-form-label">Gruppo appartenenza</label>
                                        <div class="col-sm-4">
                                            <select class="custom-select col-12" id="panel-group" name="panel-group">
                                            </select>
                                            <button type="button" class="btn btn-primary btn-xs m-t-5" name="set-groups" id="set-groups" data-target="#groups-settings" data-toggle="modal"> <i class="icon-people"></i> Gestione gruppi</button>
                                        </div>
                                    </div>
                                </form>
                                <hr class="line-dotted">
                                <div class="form-group row">
                                    <div class="col-sm-12">
                                        <button type="submit" class="btn btn-info btn-sm" name="panel-btn-add" id="panel-btn-add"> <i class="ti-plus"></i> Finestra manuale</button>
                                        <button type="button" class="btn btn-danger btn-sm" name="panel-btn-auto" id="panel-btn-auto" data-target="#auto-windows" data-toggle="modal"> <i class="ti-plus"></i> Finestre automatiche</button>
                                        <button type="button" class="btn btn-inverse btn-sm" name="panel-btn-cancel" id="panel-btn-cancel"> <i class="ti-close"></i> Elimina finestre</button>
                                    </div>
                                </div>

                                <form id="tab-config" name="tab-config">
                                    <div class="accordion bobo-accordion" id="accordion-windows">
                                    </div>
                                </form>

                                <div id="panel-save" class="saving-page">
                                    <button type="button" class="btn btn-success" name="panel-add" id="panel-add" data-reset="0"> <i class="icon-magic-wand"></i> Salva bozza</button>
                                    <button type="button" class="btn btn-primary" name="panel-add-cancel" id="panel-add-cancel" data-reset="1"> <i class="ti-save"></i> Salva e chiudi</button>
                                    <button type="button" class="btn btn-inverse" name="panel-cancel" id="panel-cancel">Annulla</button>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL GESTIONE GRUPPI -->
<div class="modal fade" id="groups-settings" tabindex="-1" role="dialog" aria-labelledby="groups-settings" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-primary" id="settings-macro-title">Gestione dei gruppi</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body one-tab-modal">
                <h4 class="text-info">Gruppi esistenti</h4>

                <table class="table table-sm table-striped table-compressed" id="categories-table">
                    <thead>
                        <tr>
                            <th scope="col"></th>
                            <th scope="col">Nome</th>
                            <th scope="col">Pubblico</th>
                            <th scope="col">Gruppi associati</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>

                % if ($user_grants->{user_insert} && $user_grants->{user_update}){
                <h4 class="text-info">Aggiungi gruppo</h4>
                <hr>
                <form class="form-horizontal" id="new-category">
                    <input type="hidden" name="new-cat-id" id="new-cat-id" value="">
                    <div class="form-group row">
                        <label for="new-cat-name" class="col-sm-3 col-form-label">Nome</label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control clear-macro" id="new-cat-name" name="new-cat-name" placeholder="Nome...">
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="new-cat-public" class="col-sm-3 col-form-label">Pubblico</label>
                        <div class="col-sm-9">
                            <label class="switch">
                                <input type="checkbox" name="new-cat-public" id="new-cat-public" data-onstyle="success" data-offstyle="danger" data-on="SI" data-off="NO" data-size="sm" data-style="android">
                            </label>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="new-cat-groups" class="col-sm-3 col-form-label">Gruppi associati</label>
                        <div class="col-sm-5">
                            <select class="select2 m-b-10 select2-multiple" id="new-cat-groups" name="new-cat-groups" style="width: 100%" multiple="multiple" data-placeholder="Seleziona...">
                                % foreach my $portal_group (@{$portal_groups_list}){
                                    <option value="<%=$portal_group->{'gr_id'} %>"><%=$portal_group->{'gr_name'} %></option>
                                % }
                            </select>
                        </div>
                        <div class="col-sm-4">
                            <span class="form-info text-info"><i class="ti-info-alt"></i>  I gruppi pubblici verranno visualizzati da tutti gli utenti del tuo portale. Non sarà necessario associare i gruppi</span>
                        </div>
                    </div>
                    <div class="form-group row m-t-20">
                        <div class="col-sm-9 offset-sm-3">
                            <div class="bording"></div>
                            <button type="submit" name="save-cat" id="save-cat" class="btn btn-info"><i class="ti-save-alt"></i> Aggiungi</button>
                            <button type="button" class="btn btn-inverse" id="reset-cat"><i class="ti-close"></i> Annulla</button>
                        </div>
                    </div>
                </form>
                % }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-link" data-dismiss="modal"><i class="ti-close"></i> CHIUDI FINESTRA</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL PARAMETRI -->
<div class="modal fade" id="adding-parameters" tabindex="-1" role="dialog" aria-labelledby="adding-parameters" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-primary" id="settings-macro-title"><strong>Aggiungi i parametri</strong> da visualizzare nella finestra</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body one-tab-modal">
                <form class="form-horizontal" id="add-windows-params">
                    <div class="form-group row">
                        <label for="select-net" class="col-sm-2 col-form-label">Rete</label>
                        <div class="col-sm-4">
                            <select class="custom-select col-12" id="select-net" name="select-net" data-change="select">
                                <option value="-1">Seleziona rete...</option>
                                % foreach my $net (@{$networks}){
                                    <option value="<%= $net->{'st_network_id'} %>"><%= $net->{'st_network_desc'} %></option>
                                % }
                            </select>
                        </div>
                        <label for="select-prov" class="col-sm-2 col-form-label">Provincia</label>
                        <div class="col-sm-4">
                            <select class="custom-select col-12 tochange-prov" id="select-prov" name="select-prov" data-change="select">
                                <option value="-1">Seleziona provincia...</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="select-stations" class="col-sm-2 col-form-label">Stazioni</label>
                        <div class="col-sm-4">
                            <select class="custom-select col-12" id="select-stations" name="select-stations" multiple>
                            </select>
                        </div>
                        <label for="show-conv" class="col-sm-2 col-form-label">Conversione dati</label>
                        <div class="col-sm-4">
                            <input type="checkbox" class="show-conv" name="show-conv" id="show-conv" data-onstyle="success" data-offstyle="danger" data-on="SI" data-off="NO" data-size="sm" data-style="android">
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="select-params" class="col-sm-2 col-form-label">Seleziona parametri</label>
                        <!-- <div class="col-sm-10 multiselect">
                            <select multiple="multiple" id="select-params" name="select-params[]" class="custom-select multiple-select col-12">
                            </select>
                        </div> -->
                        <div class="col-sm-4">
                            <select name="from[]" id="multiselect" class="form-control" size="8" multiple="multiple">
                            </select>
                        </div>

                        <div class="col-sm-2">
                            <button type="button" id="multiselect_rightAll" class="btn btn-block"><i class="fa fa-angle-double-right"></i></button>
                            <button type="button" id="multiselect_rightSelected" class="btn btn-block"><i class="fa fa-angle-right"></i></button>
                            <button type="button" id="multiselect_leftSelected" class="btn btn-block"><i class="fa fa-angle-left"></i></button>
                            <button type="button" id="multiselect_leftAll" class="btn btn-block"><i class="fa fa-angle-double-left"></i></button>
                        </div>

                        <div class="col-sm-4">
                            <select name="to[]" id="select-params" class="form-control" size="8" multiple="multiple"></select>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-link" data-dismiss="modal"><i class="ti-close"></i> CHIUDI FINESTRA</button>
                <button type="submit" class="btn btn-info" name="btn-add-params" id="btn-add-params"> <i class="icon-plus"></i> Aggiungi parametri</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL FINESTRE AUTOMATICHE -->
<div class="modal fade" id="auto-windows" tabindex="-1" role="dialog" aria-labelledby="auto-windows" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-success" id="settings-macro-title"><strong>Aggiungi finestre</strong> in modo automatico</h5>
                <button type="button" class="close clear-modal-form" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body one-tab-modal">
                <p><strong>Seleziona stazioni e parametri e crea in modo automatico le finestre per il tuo pannello di visualizer.</strong></p>
                <form class="form-horizontal" id="add-auto-windows">
                    <div class="form-group row">

                        <label for="auto-net" class="col-sm-2 col-form-label">Rete</label>
                        <div class="col-sm-4">
                            <select class="custom-select col-12" id="auto-net" name="auto-net" data-change="auto">
                                <option value="-1">Seleziona rete...</option>
                                % foreach my $net (@{$networks}){
                                    <option value="<%= $net->{'st_network_id'} %>"><%= $net->{'st_network_desc'} %></option>
                                % }
                            </select>
                        </div>
                        <label for="auto-prov" class="col-sm-2 col-form-label">Provincia</label>
                        <div class="col-sm-4">
                            <select class="custom-select col-12" id="auto-prov" name="auto-prov" data-change="auto">
                                <option value="-1">Seleziona provincia...</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="auto-stations" class="col-sm-2 col-form-label">Stazioni <span class="text-danger">*</span></label>
                        <div class="col-sm-4">
                            <select class="custom-select col-12" id="auto-stations" name="auto-stations" multiple>
                            </select>
                        </div>
                        <label for="auto-conv" class="col-sm-2 col-form-label">Conversione dati</label>
                        <div class="col-sm-4">
                            <input type="checkbox" class="show-conv" name="auto-conv" id="auto-conv" data-onstyle="success" data-offstyle="danger" data-on="SI" data-off="NO" data-size="sm" data-style="android">
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="auto-params-type" class="col-sm-2 col-form-label">Tipologia parametri <span class="text-danger">*</span></label>
                        <div class="col-sm-4">
                            <select class="custom-select col-12" id="auto-params-type" name="auto-params-type" multiple>
                                % foreach my $type (@{$types}){
                                    <option value="<%= $type->{'pm_type_id'} %>"><%= $type->{'pm_type_desc'} %></option>
                                % }
                            </select>
                        </div>
                        <label for="auto-instruments" class="col-sm-2 col-form-label diags-enabled">Categoria strumenti</label>
                        <div class="col-sm-4 diags-enabled">
                            <select class="custom-select col-12" id="auto-instruments" name="auto-instruments">
                                <option value="-1">Selezionare categoria...</option>
                                % foreach my $cat (@{$instr_categories}){
                                    <option value="<%= $cat->{'category_id'} %>"><%= $cat->{'category_name'} %></option>
                                % }
                            </select>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="auto-params" class="col-sm-2 col-form-label">Parametri</label>
                        <div class="col-sm-4">
                            <select class="custom-select col-12" id="auto-params" name="auto-params" multiple>
                            </select>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-link clear-modal-form" name="btn-cancel-auto-windows" id="btn-cancel-auto-windows" data-dismiss="modal"><i class="ti-close"></i> CHIUDI FINESTRA</button>
                <button type="submit" class="btn btn-info" name="btn-add-auto-windows" id="btn-add-auto-windows"> <i class="icon-plus"></i> Aggiungi finestre</button>
            </div>
        </div>
    </div>
</div>