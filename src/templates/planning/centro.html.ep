% layout 'default';
% title 'Tickets sul portale';

<script src="<%=url_for(helperGetFileVersion('/bobo-js/planning/centro.js'))%>" type="text/javascript"></script>

<script type="text/javascript">
    // arriving from server, id visible in page's url
    var tkid = '<%= $tkid %>';
</script>
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Tickets relativi al Centro Operativo (Portale OPAS)</h4>
                <h6 class="card-subtitle">Invia un ticket relativo alle <strong>problematiche riscontrate durante l'utilizzo del portale</strong></h6>

                <!-- Nav tabs -->
                <ul class="nav nav-tabs customtab main-tab" role="tablist">
                    <li class="nav-item"> <a class="nav-link active" data-toggle="tab" href="#task-list" role="tab"><span class="hidden-sm-up"><i class="mdi mdi-view-grid"></i></span> <span class="hidden-xs-down">Tickets</span></a> </li>
                    <!-- if user has insert grant -->
                    % if ($user_grants->{user_insert}){
                        <li class="nav-item"> <a class="nav-link text-info" data-toggle="tab" href="#new" id="new-report" role="tab"><span class="hidden-sm-up"><i class="mdi mdi-library-plus"></i></span> <span class="hidden-xs-down" id="inner-new-report">Nuovo</span></a> </li>
                    % }
                    <li class="nav-item"> <a class="nav-link nav-info" data-toggle="tab" href="#info" role="tab"> <i class="fa-sharp fa-solid fa-circle-info"></i> </a> </li>
                </ul>

                <div class="tab-content">
                    <div class="tab-pane p-20 active" id="task-list" role="tabpanel">
                        <div class="row show-space-between-med">
                            <div class="input-group col-12 col-md-6 m-b-10">
                                <input class="form-control input-daterange-datepicker" type="text" name="daterange" value="" />
                                <div class="input-group-append">
                                    <span class="input-group-text"><i class="mdi mdi-calendar-multiple"></i></span>
                                </div>
                            </div>
                            <div class="input-group col-12 col-md-6 focus-group m-b-10">
                                <div class="input-group-prepend">
                                    <span class="input-group-text"><i class="fa-regular fa-comments-question-check text-info"></i></span>
                                </div>
                                <input class="form-control" type="text" name="daterange" placeholder="Bisogno di aiuto? cerca nell'archivio per trovare una soluzione..." />
                            </div>
                        </div>
                        <div class="row show-space-between-med">
                            <div class="col-xl-3 col-md-6 m-b-10">
                                <select class="custom-select col-12" id="status" name="status">
                                    <option value="">Stato...</option>
                                    % foreach my $status (@{$status_list}){
                                        <option value="<%= $status->{'status_label'} %>"><%= $status->{'status_desc'}%></option>
                                    % }
                                </select>
                            </div>
                            <div class="col-xl-3 col-md-6 m-b-10">
                                <select class="custom-select col-12" id="urgencies" name="urgencies">
                                    <option value="-1">Priorità...</option>
                                    % foreach my $urgency (@{$urgencies}){
                                        <option value="<%= $urgency->{'ctu_id'} %>"><%= $urgency->{'ctu_name'}%></option>
                                    % }
                                </select>
                            </div>
                            <div class="col-xl-3 col-md-6 m-b-10">
                                <select class="custom-select col-12" id="types" name="types">
                                    <option value="-1">Seleziona tipologia...</option>
                                    % foreach my $type (@{$types}){
                                        <option value="<%= $type->{'ctt_id'} %>"><%= $type->{'ctt_name'}%></option>
                                    % }
                                </select>
                            </div>
                            <div class="input-group col-xl-3 col-md-6 m-b-10">
                                <label for="show-useful" class="font-bold m-t-5">Ticket da visualizzare:&nbsp;&nbsp;</label>
                                <input type="checkbox" data-onstyle="success" data-offstyle="danger" data-on="Rilevanti" data-off="Tutti" data-size="sm" data-style="android" checked id="show-useful" name="show-useful">
                            </div>
                        </div>

                        <table id="activities-table" class="display responsive table table-hover table-striped tbl-va-center resp-plus tbl-arrgd" cellspacing="0" width="100%">
                            <thead>
                                <tr>
                                    <th class="bobo-nowrap"></th>
                                    <th>ID</th>
                                    <th>Operatore</th>
                                    <th>Creato il</th>
                                    <th>Assegnato</th>
                                    <th>Priorità</th>
                                    <th>Stato</th>
                                    <!-- <th>Chiusura</th> -->
                                    <th>Tipo</th>
                                    <th>Titolo</th>
                                    <th>Rilevante</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th class="bobo-nowrap"></th>
                                    <th>ID</th>
                                    <th>Operatore</th>
                                    <th>Creato il</th>
                                    <th>Assegnato</th>
                                    <th>Priorità</th>
                                    <th>Stato</th>
                                    <!-- <th>Chiusura</th> -->
                                    <th>Tipo</th>
                                    <th>Titolo</th>
                                    <th>Rilevante</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <div class="tab-pane p-20" id="new" role="tabpanel">
                        <h4 class="box-title">Inserisci nuovo TICKET</h4>
                        <hr class="m-t-0 m-b-20">
                        <form class="form form-medium" id="newtic-form" name="newtic-form">
                            <input type="hidden" class="clear-input" id="newtic-id" name="newtic-id" value="">
                            <div class="form-group row">
                                <label for="newtic-type" class="col-md-2 col-form-label">Tipo <span class="text-danger">*</span></label>
                                <div class="col-md-4">
                                    <select class="custom-select clear-select col-md-12 select-with-desc" id="newtic-type" name="newtic-type">
                                        <option value="-1">Seleziona tipo...</option>
                                        % foreach my $type (@{$types}){
                                            <option data-desc="<%= $type->{'ctt_desc'} %>" value="<%= $type->{'ctt_id'} %>"><%= $type->{'ctt_name'}%></option>
                                        % }
                                    </select>
                                    <div class="text-info font-italic txt-desc"></div>
                                </div>
                                <label for="newtic-urgency" class="col-md-2 col-form-label">Priorità <span class="text-danger">*</span></label>
                                <div class="col-md-4">
                                    <select class="custom-select clear-select col-md-12 select-with-desc" id="newtic-urgency" name="newtic-urgency">
                                        <option value="-1">Seleziona urgenza...</option>
                                        % foreach my $urgency (@{$urgencies}){
                                            <option data-desc="<%= $urgency->{'ctu_desc'} %>" value="<%= $urgency->{'ctu_id'} %>"><%= $urgency->{'ctu_name'}%></option>
                                        % }
                                    </select>
                                    <div class="text-info font-italic txt-desc"></div>
                                </div>
                            </div>
                            <h5 class="divider-title">Dettagli del ticket</h5>
                            <div class="form-group row">
                                <label for="newtic-assigned" class="col-md-2 col-form-label">Assegnato a <span class="text-danger">*</span></label>
                                <div class="col-md-3">
                                    <select class="custom-select clear-select col-md-12" id="newtic-assigned" name="newtic-assigned">
                                        <option value="-1">Seleziona destinatario...</option>
                                        % foreach my $group (@{$groups}){
                                            <option value="<%= $group->{'gr_id'} %>"><%= $group->{'gr_name'}%></option>
                                        % }
                                    </select>
                                </div>
                                <label for="newtic-title" class="col-md-2 col-form-label">Titolo <span class="text-danger">*</span></label>
                                <div class="col-md-5">
                                    <input type="text" class="form-control clear-input" id="newtic-title" name="newtic-title" placeholder="Titolo...">
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="newtic-body" class="col-md-2 col-form-label">
                                    Descrizione <span class="text-danger">*</span>
                                <span class="text-info">
                                    <br><br><strong>Guida alla segnalazione delle problematiche:</strong>
                                    <ul class="nobull">
                                        <li>&bull; Pagina in cui ti trovavi;</li>
                                        <li>&bull; Punto esatto dell’interfaccia;</li>
                                        <li>&bull; Azione attesa;</li>
                                        <li>&bull; Risultato ottenuto;</li>
                                        <li>&bull; Hai ripetuto l’operazione?</li>
                                        <li>&bull; Allega eventuali screenshot.</li>
                                    </ul>
                                </span>
                                </label>
                                <div class="col-md-10">
                                    <!-- <textarea class="form-control clear-input" rows="10" id="newtic-body" name="newtic-body"></textarea> -->
                                    <div class="summernote" id="newtic-body" name="newtic-body" required></div>
                                </div>
                            </div>
                            <h5 class="divider-title">Aggiungi allegati</h5>
                            <div class="form-group row">
                                <label for="newtic-attach" class="col-md-2 col-form-label">Allegati</label>
                                <div class="col-md-10 m-b-5">
                                    <div id="newtic-attach" class="dropzone"></div>
                                </div>
                                <div class="col-md-10 offset-md-2 text-grey">Gli allegati aiutano a spiegare la problematica riscontrata, <strong class="text-uppercase">aggiungi degli screenshot</strong>.</div>
                            </div>
                            <div class="row report-gallery-big m-b-10">
                                <div class="col-md-10 offset-md-2" id="img-container"></div>
                            </div>
                            <hr class="m-t-30">
                            <div class="form-group row">
                                <div class="col-md-12">
                                    <button type="submit" class="btn btn-info" name="confirm-newtic-form" id="confirm-newtic-form"> <i class="ti-save"></i> Inserisci ticket</button>
                                    <button type="button" class="btn btn-primary" name="clear-newtic-form" id="clear-newtic-form"> <i class="ti-share-alt"></i> Svuota campi</button>
                                    <button type="button" class="btn btn-inverse" name="cancel-newtic-form" id="cancel-newtic-form">Annulla</button>
                                </div>
                            </div>

                        </form>
                    </div>
                    <div class="tab-pane p-20" id="info" role="tabpanel">
                        <h4 class="box-title">Informazioni relative al <strong>sistema di ticketing del Centro OPAS</strong></h4>
                        <hr class="m-t-0 m-b-20">
                        <p>Il sistema di ticketing del Centro è pensato per risolvere le problematiche del portale OPAS nel modo più semplice e nel breve periodo.</p>
                        <h5 class="text-info"><strong>Priorità</strong> dei Ticket:</h5>
                        <ul class="list-priority">
                            <li>
                                <span class="badge badge-purple">Bloccante</span><br>
                                Malfunzionamenti che <strong>impediscono il regolare svolgimento di un intero processo applicativo</strong>;<br>
                                (Esempio i moduli Portale/Autenticazione, Validazione, Statistiche, Import Dati)</li>
                            <li>
                                <span class="badge badge-danger">Alta</span><br>
                                Malfunzionamenti che <strong>impediscono l’utilizzo corretto di una singola funzionalità</strong>, pur non impedendo totalmente lo svolgimento del processo applicativo al quale la funzionalità appartiene;<br>
                                (Esempio Visualizer, Analyser , Export Dati, Web Service)</li>
                            <li>
                                <span class="badge badge-primary">Media</span><br>
                                Malfunzionamenti tali da non impedire il regolare svolgimento di un processo applicativo, ma che siano <strong>causa di inefficienza o di problemi operativi per l’utente</strong>.<br>
                                (Esempio Ticketing, Anagrafica, Mapper, Validazione Multilivello)</li>
                            <li>
                                <span class="badge badge-warning">Bassa</span><br>
                                Disfunzioni del sistema che non impediscono il regolare svolgimento di un processo applicativo, ma che siano <strong>causa di disagi nell’uso per l’utente.</strong><br>
                                (Esempio Dataview, Grafici OpenAir, Reportistica)</li>
                        </ul>
                        <h5 class="text-info"><strong>Risoluzione</strong> del ticket:</h5>
                        <table class="table table-hover table-striped tbl-va-center table-condensed">
                            <thead>
                                <tr>
                                    <th>Indicatore</th>
                                    <th>Descrizione</th>
                                    <th>Caratteristica</th>
                                    <th>SLA</th>
                                    <!-- <th>Penali</th> -->
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <th>MAC-01</th>
                                    <td>TP (Presa in carico)</td>
                                    <td>in fascia lavorativo</td>
                                    <td>Entro 1 ora lavorativa</td>
                                    <!-- <td>€ 20/ora di ritardo</td> -->
                                </tr>
                                <tr>
                                    <th>MAC-02</th>
                                    <td>TP (Presa in carico)</td>
                                    <td>fuori fascia</td>
                                    <td>Entro le ore 9 del primo giorno con orario lavorativo</td>
                                    <!-- <td>€ 20/ora di ritardo</td> -->
                            </tr>
                            <tr>
                                <th>MAC-03</th>
                                <td>TR (risoluzione)</td>
                                <td>Bloccante</td>
                                <td>Entro 4 ore lavorative dopo presa incarico</td>
                                <!-- <td>€ 50/ora di ritardo</td> -->
                            </tr>
                            <tr>
                                <th>MAC-04</th>
                                <td>TR (risoluzione)</td>
                                <td>Alta</td>
                                <td>Entro 8 ore lavorative dopo presa incarico (1 giorno lavorativo)</td>
                                <!-- <td>€ 50/ora di ritardo</td> -->
                            </tr>
                            <tr>
                                <th>MAC-05</th>
                                <td>TR (risoluzione)</td>
                                <td>Media</td>
                                <td>Entro 16 ore lavorative dopo presa incarico (2 giorni lavorativi)</td>
                                <!-- <td>€ 20/ora di ritardo</td> -->
                            </tr>
                            <tr>
                                <th>MAC-06</th>
                                <td>TR (risoluzione)</td>
                                <td>Bassa</td>
                                <td>Entro 24 ore lavorative dopo presa incarico (3 giorni lavorativi)</td>
                                <!-- <td>€ 20/ora di ritardo</td> -->
                            </tr>
                            <tr>
                                <th>MAC-07</th>
                                <td colspan="3">Tempo medio di risoluzione (TMR)</td>
                            </tr>
                            </tbody>
                        </table>
                        <p class="font-bold m-b-40 text-bigger">N.B.: l'orario del service desk è dal lunedi al venerdi dalle ore 8:00 alle ore 17:00 esclusivamente nei giorni lavorativi (esclusi festivi e prefestivi).</p>
                        <h5 class="text-info">Vademecuum per la <strong>descrizione ticket</strong>:</h5>
                        <ul>
                            <li>Indica la <strong>pagina in cui ti trovavi</strong>;</li>
                            <li>Segnala il <strong>punto esatto dell’interfaccia</strong> dove hai riscontrato il problema;</li>
                            <li>Spiega che <strong>tipi di azione ti aspettavi di ricevere</strong>;</li>
                            <li>Descrivi invece il <strong>risultato ottenuto</strong>;</li>
                            <li><strong>Hai provato a ripetere l’operazione?</strong> (riprova almeno un paio di volte prima di aprire una segnalazione);</li>
                            <li><strong>Allega tutti gli screenshot</strong> che puoi, in modo da documentare le azioni intraprese e le problematiche riscontrate.</li>
                        </ul>
                        <!-- <ul class="docs-list">
                            <li class="ico_pdf">
                                <a href="/bobo-media/cf/vigilanza/bollettino-vigilanza-avvisi.pdf" tabindex="500" title="Download file: bollettino-vigilanza-avvisi.pdf" target="_blank"><i class="mdi mdi-cloud-download"></i> Scarica il <strong>Manuale di utilizzo</strong></a>
                            </li>
                        </ul> -->
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>