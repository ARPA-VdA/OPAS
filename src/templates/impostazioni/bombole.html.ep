% layout 'default';
% title 'Impostazioni di rete - Bombole';

<script src="<%=url_for(helperGetFileVersion('/bobo-js/impostazioni/bombole.js'))%>" type="text/javascript"></script>


<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-11">
                        <h4 class="card-title">Visualizza e posiziona le bombole</h4>
                        <h6 class="card-subtitle">Da questa pagina puoi visualizzare tutte le bombole, aggiungerne di nuove oppure posizionarle nelle stazioni appartenenti alla tua rete</h6>
                    </div>
                </div>

                <!-- Nav tabs -->
                <ul class="nav nav-tabs customtab main-tab" role="tablist">
                    <li class="nav-item"> <a class="nav-link active" data-toggle="tab" href="#list" role="tab"><span class="hidden-sm-up"><i class="fas fa-th-list text-muted"></i></span> <span class="hidden-xs-down">Elenco</span></a> </li>
                    <!-- if user has insert grant -->
                    % if ($user_grants->{user_insert}){
                        <li class="nav-item"> <a class="nav-link text-info" data-toggle="tab" href="#new-element" id="new-tank" role="tab"><span class="hidden-sm-up"><i class="fas fa-plus-octagon text-danger"></i></span> <span class="hidden-xs-down" id="inner-new-tank"> Bombola</span></a> </li>
                        <li class="nav-item"> <a class="nav-link text-info" data-toggle="tab" href="#new-location" id="new-loc" role="tab"><span class="hidden-sm-up"><i class="fas fa-map-marker-plus text-danger"></i></span> <span class="hidden-xs-down" id="inner-new-loc"> Stanziamento</span></a> </li>
                    % }

                    <!-- <li class="nav-item"> <a class="nav-link" data-toggle="tab" href="#show-element" role="tab"><span class="hidden-sm-up"><i class="fa fa-file-text-o"></i></span> <span class="hidden-xs-down" id="inner-new-report">Visualizza bombole</span></a> </li> -->
                </ul>
                <!-- Tab panes -->
                <div class="tab-content">
                    <div class="tab-pane p-20 active" id="list" role="tabpanel">
                        <div class="row p-b-15">
                            <div class="col-12">
                                <label class="switch">
                                    Ricerca&nbsp;&nbsp;
                                    <input type="checkbox" class="view-pg clear-field" data-onstyle="warning" data-offstyle="success" data-on="STANZIAMENTO" data-off="BOMBOLA" data-size="sm" data-style="android" name="search-type" id="search-type">
                                    <!-- Ricerca per stanziamento -->
                                </label>
                                <div class="legend-txt">
                                    <span id="active-bomb">
                                        <i class="fa-regular fa-circle-question text-info"></i> Il periodo temporale inserito filtra le bombole in base alle date di <strong>produzione</strong> e <strong>scadenza</strong>.
                                    </span>
                                    <span id="active-loc">
                                        <i class="fa-regular fa-circle-question text-info"></i> Il periodo temporale inserito filtra le bombole in base alle date di <strong>inizio</strong> e <strong>fine stanziamento</strong>.
                                    </span>
                                </div>
                            </div>
                            <div class="input-group col-3 col-lg-3">
                                <input class="form-control input-daterange-datepicker" type="text" name="daterange" value="" />
                                <div class="input-group-append">
                                    <span class="input-group-text"><i class="mdi mdi-calendar-multiple"></i></span>
                                </div>
                            </div>
                            <div class="col-3 col-lg-3">
                                <select class="custom-select col-12" id="nets" name="nets">
                                    <option value="-1">Seleziona rete...</option>
                                    % foreach my $network (@{$networks}){
                                        <option value="<%= $network->{st_network_id}%>"><%= $network->{st_network_desc} %></option>
                                    % }
                                </select>
                            </div>
                            <div class="col-3 col-lg-3 select-place">
                                <select class="custom-select col-12" id="provinces" name="provinces" data-change="stations">
                                    <option value="-1">Seleziona provincia...</option>
                                </select>
                            </div>
                            <div class="col-3 col-lg-3 select-place">
                                <select class="custom-select col-12" id="stations" name="stations">
                                    <option value="-1">Seleziona stazione...</option>
                                </select>
                            </div>
                        </div>

                        <table id="list-table" class="display responsive table table-hover table-striped tbl-va-center table-compressed" cellspacing="0" width="100%">
                            <thead>
                                <tr>
                                    <th class="bobo-nowrap"></th>
                                    <th class="bobo-nowrap">Arpa ID</th>
                                    <th>Nome</th>
                                    <th>Miscela</th>
                                    <th>Valori</th>
                                    <th>Produzione</th>
                                    <th>Scadenza</th>
                                    <th>Location attuale</th>
                                    <th>Dal</th>
                                    <th>Al</th>
                                    <th>Esaurita</th>
                                    <th>Attiva</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th class="bobo-nowrap"></th>
                                    <th class="bobo-nowrap">Arpa ID</th>
                                    <th>Nome</th>
                                    <th>Miscela</th>
                                    <th>Valori</th>
                                    <th>Produzione</th>
                                    <th>Scadenza</th>
                                    <th>Location attuale</th>
                                    <th>Dal</th>
                                    <th>Al</th>
                                    <th>Esaurita</th>
                                    <th>Attiva</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <div class="tab-pane p-20" id="new-element" role="tabpanel">
                        <h4 class="box-title">Inserisci nuova bombola</h4>
                        <hr class="m-t-0 m-b-20">
                        <form class="form" id="tank-form" name="tank-form">
                            <input type="hidden" class="clear-input" id="tank-cy-id" name="tank-cy-id" value="">
                            <div class="form-group row">
                                <label for="tank-arpa-id" class="col-2 col-form-label">Arpa ID</label>
                                <div class="col-4">
                                    <input type="text" class="form-control clear-input" id="tank-arpa-id" name="tank-arpa-id" placeholder="Arpa ID">
                                </div>
                                <label for="tank-name" class="col-2 col-form-label">Nome</label>
                                <div class="col-4">
                                    <input type="text" class="form-control clear-input" id="tank-name" name="tank-name" placeholder="Nome">
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="tank-date-built" class="col-2 col-form-label">Produzione <span class="text-danger">*</span></label>
                                <div class="col-4 input-group">
                                    <input type="text" class="form-control clear-input" id="tank-date-built" name="tank-date-built" placeholder="mm/dd/yyyy">
                                    <div class="input-group-append">
                                        <span class="input-group-text"><i class="icon-calender"></i></span>
                                    </div>
                                </div>
                                <label for="tank-date-expiry" class="col-2 col-form-label">Scadenza <span class="text-danger">*</span></label>
                                <div class="col-4 input-group">
                                    <input type="text" class="form-control clear-input" id="tank-date-expiry" name="tank-date-expiry" placeholder="mm/dd/yyyy">
                                    <div class="input-group-append">
                                        <span class="input-group-text"><i class="icon-calender"></i></span>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="tank-category" class="col-2 col-form-label">Categoria <span class="text-danger">*</span></label>
                                <div class="col-4">
                                    <select class="custom-select clear-select col-12" id="tank-category" name="tank-category">
                                            <option value="-1">Seleziona categoria...</option>
                                            % foreach my $category (@{$categories}){
                                                <option value="<%= $category->{category_id}%>"><%= $category->{category_name} %></option>
                                            % }
                                    </select>
                                </div>
                                <label for="tank-description" class="col-2 col-form-label">Miscela <span class="text-danger">*</span></label>
                                <div class="col-4">
                                    <input type="text" class="form-control clear-input" id="tank-description" name="tank-description" placeholder="Miscela">
                                </div>
                            </div>
                            <div class="form-group row" id="values-ins">
                                <label for="val-first" class="col-2 col-form-label show-first">val. NOX</label>
                                <div class="col-2 show-first">
                                    <input type="text" class="form-control clear-input" id="val-first" name="val-first" placeholder="Sep. decimale: PUNTO">
                                </div>
                                <label for="val-second" class="col-2 col-form-label show-second">val. NO</label>
                                <div class="col-2 show-second">
                                    <input type="text" class="form-control clear-input" id="val-second" name="val-second" placeholder="Sep. decimale: PUNTO">
                                </div>
                                <label for="val-third" class="col-2 col-form-label show-third">val. NO2</label>
                                <div class="col-2 show-third">
                                    <input type="text" class="form-control clear-input" id="val-third" name="val-third" placeholder="Sep. decimale: PUNTO">
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-4 offset-2">
                                    <div class="custom-control custom-checkbox">
                                        <input type="checkbox" class="custom-control-input clear-ckb" id="tank-iszero" name="tank-iszero">
                                        <label class="custom-control-label" for="tank-iszero">Bombola di zero</label>
                                    </div>
                                </div>
                                <div class="col-4 offset-2 btn-compressed">
                                    Bombola attiva&nbsp;&nbsp;<input type="checkbox" checked data-onstyle="success" data-offstyle="danger" data-on="SI" data-off="NO" data-size="xs" data-style="android"  id="tank-active" name="tank-active" />
                                </div>
                            </div>
                            <h5 class="divider-title">Ulteriori dettagli</h5>
                            <div class="form-group row">
                                <div class="col-10 offset-2">
                                    <div class="custom-control custom-checkbox inline-ckb">
                                        <input type="checkbox" class="custom-control-input clear-ckb" id="tank-exhausted" name="tank-exhausted">
                                        <label class="custom-control-label" for="tank-exhausted">Esaurita</label>
                                    </div>
                                    <div class="custom-control custom-checkbox inline-ckb">
                                        <input type="checkbox" class="custom-control-input clear-ckb" id="tank-returned" name="tank-returned">
                                        <label class="custom-control-label" for="tank-returned">Resa</label>
                                    </div>
                                    <div class="custom-control custom-checkbox inline-ckb">
                                        <input type="checkbox" class="custom-control-input clear-ckb" id="tank-not-compliant" name="tank-not-compliant">
                                        <label class="custom-control-label" for="tank-not-compliant">Non conforme</label>
                                    </div>
                                    <div class="custom-control custom-checkbox inline-ckb">
                                        <input type="checkbox" class="custom-control-input clear-ckb" id="tank-all-stations" name="tank-all-stations">
                                        <label class="custom-control-label" for="tank-all-stations">Stanziata in tutte le stazioni</label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="tank-networks" class="col-2 col-form-label">Reti di appartenenza <span class="text-danger">*</span></label>
                                <div class="col-3">
                                    <select class="custom-select clear-select col-12" id="tank-networks" name="tank-networks" data-dest="loc-stat" multiple>
                                        % foreach my $network (@{$networks}){
                                            <option value="<%= $network->{st_network_id}%>"><%= $network->{st_network_name} %></option>
                                        % }
                                    </select>
                                </div>
                                <label for="tank-attach" class="col-2 col-form-label">Allegati</label>
                                <div class="col-5">
                                    <div id="tank-attach" class="dropzone"></div>
                                    <div class="row attachment-gallery-big m-t-10 m-b-10">
                                        <div class="col-md-12" id="img-container">
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-12 attachment-files"></div>
                                    </div>
                                </div>
                            </div>
                            <h5 class="divider-title">Eventuali annotazioni</h5>
                            <div class="form-group row">
                                <label for="tank-notes" class="col-2 col-form-label">Note bombola</label>
                                <div class="col-10">
                                    <textarea class="form-control clear-input" rows="6" id="tank-note" name="tank-note"></textarea>
                                </div>
                            </div>
                            <div id="hide-edit">
                                <div class="form-group row" id="add-location-container">
                                    <div class="col-sm-10 offset-md-2 m-b-10">
                                        <input type="checkbox" class="js-switch" data-color="#79a030" id="add-location" name="add-location"/> <strong>Aggiungi location per la bombola</strong>
                                    </div>
                                </div>
                                <div id="add-location-fields">
                                    <h5 class="divider-title">Inserisci location</h5>
                                    <div class="form-group row">
                                        <label for="loc-prov" class="col-2 col-form-label">Provincia</label>
                                        <div class="col-4">
                                            <select class="custom-select clear-select col-12" id="loc-prov" name="loc-prov" data-dest="loc-stat">
                                                <option value="-1">Seleziona provincia...</option>
                                                % my $region = '';
                                                % foreach my $province (@{$provinces}){

                                                    % if ($region eq ''){
                                                        <optgroup label="<%= $province->{'region_name'} %>">
                                                        <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                                    % }else{
                                                        % if ($region eq $province->{'region_id'}){
                                                            <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                                        % } else {
                                                            </optgroup>
                                                            <optgroup label="<%= $province->{'region_name'} %>">
                                                            <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                                        % }
                                                    % }
                                                    % $region = $province->{'region_id'};
                                                % }
                                                </optgroup>
                                            </select>

                                        </div>
                                        <label for="loc-stat" class="col-2 col-form-label">Stazione <span class="text-danger">*</span></label>
                                        <div class="col-4">
                                            <select class="custom-select clear-select col-12" id="loc-stat" name="loc-stat">
                                                <option value="-1">Seleziona...</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <label for="loc-start-date" class="col-2 col-form-label">Data/ora inizio <span class="text-danger">*</span></label>
                                        <div class="input-group col-4">
                                            <input type="text" class="form-control clear-input" id="loc-start-date" name="loc-start-date" placeholder="mm/dd/yyyy hh:mm">
                                            <div class="input-group-append">
                                                <span class="input-group-text"><i class="icon-calender"></i></span>
                                            </div>
                                        </div>
                                        <label for="loc-end-date" class="col-2 col-form-label">Data/ora fine</label>
                                        <div class="input-group col-4">
                                            <input type="text" class="form-control clear-input" id="loc-end-date" name="loc-end-date" placeholder="mm/dd/yyyy hh:mm">
                                            <div class="input-group-append">
                                                <span class="input-group-text"><i class="icon-calender"></i></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <label for="loc-notes" class="col-2 col-form-label">Note location</label>
                                        <div class="col-10">
                                            <textarea class="form-control clear-input" rows="6" id="loc-notes" name="loc-notes"></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <hr class="m-t-30">
                            <div class="form-group row">
                                <div class="col-12">
                                    <button type="submit" class="btn btn-info" name="btn-tank-form" id="btn-tank-form"> <i class="ti-save"></i> Inserisci</button>
                                    <button type="button" class="btn btn-inverse" name="cancel-tank-form" id="cancel-tank-form">Annulla</button>
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="tab-pane p-20" id="new-location" role="tabpanel">
                        <h4 class="box-title">Inserisci nuovo stanziamento</h4>
                        <hr class="m-t-0 m-b-20">
                        <form id="modal-tank-form" name="modal-tank-form">
                            <input type="hidden" class="clear-input" id="modal-loc-id" name="modal-loc-id" value="">
                            <input type="hidden" class="clear-input" id="modal-networks" name="modal-networks" value="">

                            <div class="form-group row">
                                <label for="modal-loc-tank" class="col-2 col-form-label">Bombola</label>
                                <div class="col-10">
                                    <select class="custom-select clear-select col-12" id="modal-loc-tank" name="modal-loc-tank">
                                        <option value="-1">Seleziona...</option>
                                    </select>
                                </div>
                            </div>

                            <div class="hide-loc">
                                <h5 class="divider-title">Inserisci location</h5>

                                <div class="form-group row">
                                    <label for="modal-loc-prov" class="col-2 col-form-label">Provincia</label>
                                    <div class="col-4">
                                        <select class="custom-select clear-select col-12" id="modal-loc-prov" name="modal-loc-prov" data-dest="modal-loc-stat">
                                            <option value="-1">Seleziona provincia...</option>
                                            % $region = '';
                                            % foreach my $province (@{$provinces}){

                                                % if ($region eq ''){
                                                    <optgroup label="<%= $province->{'region_name'} %>">
                                                    <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                                % }else{
                                                    % if ($region eq $province->{'region_id'}){
                                                        <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                                    % } else {
                                                        </optgroup>
                                                        <optgroup label="<%= $province->{'region_name'} %>">
                                                        <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                                    % }
                                                % }
                                                % $region = $province->{'region_id'};
                                            % }
                                            </optgroup>
                                        </select>

                                    </div>
                                    <label for="modal-loc-stat" class="col-2 col-form-label">Stazione <span class="text-danger">*</span></label>
                                    <div class="col-4">
                                        <select class="custom-select clear-select col-12" id="modal-loc-stat" name="modal-loc-stat">
                                            <option value="-1">Seleziona...</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <label for="modal-loc-start-date" class="col-2 col-form-label">Data/ora inizio <span class="text-danger">*</span></label>
                                    <div class="input-group col-4">
                                        <input type="text" class="form-control clear-input" id="modal-loc-start-date" name="modal-loc-start-date" placeholder="mm/dd/yyyy hh:mm">
                                        <div class="input-group-append">
                                            <span class="input-group-text"><i class="icon-calender"></i></span>
                                        </div>
                                    </div>
                                    <label for="modal-loc-end-date" class="col-2 col-form-label">Data/ora fine</label>
                                    <div class="input-group col-4">
                                        <input type="text" class="form-control clear-input" id="modal-loc-end-date" name="modal-loc-end-date" placeholder="mm/dd/yyyy hh:mm">
                                        <div class="input-group-append">
                                            <span class="input-group-text"><i class="icon-calender"></i></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <label for="modal-loc-notes" class="col-2 col-form-label">Note location</label>
                                    <div class="col-10">
                                        <textarea class="form-control clear-input" rows="6" id="modal-loc-notes" name="modal-loc-notes"></textarea>
                                    </div>
                                </div>
                                <hr class="m-t-30">
                                <div class="form-group row">
                                    <div class="col-12">
                                        <button type="submit" class="btn btn-info" id="modal-loc-insert"><i class="icon-location-pin"></i> Inserisci</button>
                                        <button type="button" class="btn btn-inverse" id="modal-loc-cancel">Annulla</button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>