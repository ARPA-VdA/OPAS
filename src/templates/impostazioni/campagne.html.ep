% layout 'default';
% title 'Impostazioni di rete - Campagne';

<script src="<%=url_for(helperGetFileVersion('/bobo-js/impostazioni/campagne.js'))%>" type="text/javascript"></script>


<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-11">
                        <h4 class="card-title">Visualizza e posiziona le campagne</h4>
                        <h6 class="card-subtitle">Da questa pagina puoi visualizzare tutte le campagne, aggiungerne di nuove oppure posizionarle in vari punti appartenenti alla tua rete</h6>
                    </div>
                </div>

                <!-- Nav tabs -->
                <ul class="nav nav-tabs customtab main-tab" role="tablist">
                    <li class="nav-item"> <a class="nav-link active" data-toggle="tab" href="#list" role="tab"><span class="hidden-sm-up"><i class="mdi mdi-view-grid"></i></span> <span class="hidden-xs-down">Siti</span></a> </li>
                    <!-- if user has insert grant -->
                    % if ($user_grants->{user_insert}){
                        <li class="nav-item"> <a class="nav-link text-info" data-toggle="tab" href="#new-element" id="new-bulletin" role="tab"><span class="hidden-sm-up"><i class="fas fa-plus-octagon text-danger"></i></span> <span class="hidden-xs-down" id="inner-new-bulletin">Sito</span></a> </li>
                        <li class="nav-item"> <a class="nav-link text-info" data-toggle="tab" href="#new-location" id="new-loc" role="tab"><span class="hidden-sm-up"><i class="fas fa-map-marker-plus text-danger"></i></span> <span class="hidden-xs-down" id="inner-new-loc"> Stanziamento</span></a> </li>
                    % }
                </ul>
                <!-- Tab panes -->
                <div class="tab-content">
                    <div class="tab-pane p-20 active" id="list" role="tabpanel">
                        <div class="row m-b-10">
                            <div class="col-12">
                                <label class="switch">
                                    Ricerca&nbsp;&nbsp;
                                    <input type="checkbox" class="view-pg clear-field" data-onstyle="warning" data-offstyle="success" data-on="STANZIAMENTO" data-off="SITO" data-size="sm" data-style="android" name="search-type" id="search-type">
                                    <!-- Ricerca per stanziamento -->
                                </label>
                                <div class="legend-txt">
                                    <span id="active-site">
                                        <i class="fa-regular fa-circle-question text-info"></i> Elenco di tutti i siti inseriti nel database.
                                    </span>
                                    <span id="active-loc">
                                        <i class="fa-regular fa-circle-question text-info"></i> Il periodo temporale inserito filtra gli stanziamenti in base alle date di <strong>inizio</strong> e <strong>fine stanziamento</strong>.
                                    </span>
                                </div>
                            </div>
                            <div class="input-group col-md-3 select-place">
                                <input class="form-control input-daterange-datepicker" type="text" name="daterange" value="" />
                                <div class="input-group-append">
                                    <span class="input-group-text"><i class="mdi mdi-calendar-multiple"></i></span>
                                </div>
                            </div>
                            <div class="col-lg-2">
                                <select class="custom-select col-12" id="nets" name="nets" data-dest="stations">
                                    <option value="-1">Seleziona rete...</option>
                                    % foreach my $network (@{$networks}){
                                        <option value="<%= $network->{st_network_id}%>"><%= $network->{st_network_desc} %></option>
                                    % }
                                </select>
                            </div>
                            <div class="col-lg-2">
                                <select class="custom-select col-12" id="provinces" name="provinces">
                                    <option value="-1">Seleziona provincia...</option>
                                    % my $region = '';
                                    % foreach my $province (@{$provinces}){

                                        % if ($region eq ''){
                                            <optgroup label="<%= $province->{'region_name'} %>">
                                            <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                        % }else{
                                            % if ($region eq $province->{'region_id'}){
                                                <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                            % } else {
                                                </optgroup>
                                                <optgroup label="<%= $province->{'region_name'} %>">
                                                <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                            % }
                                        % }
                                        % $region = $province->{'region_id'};
                                    % }
                                    </optgroup>
                                </select>
                            </div>
                            <div class="col-lg-3 select-place">
                                <select class="custom-select col-12" id="stations" name="stations">
                                    <option value="-1">Seleziona laboratorio...</option>
                                </select>
                            </div>
                            <div class="col-lg-2 select-place">
                                <select class="custom-select col-12" id="campaigns" name="campaigns">
                                    <option value="-1">Seleziona campagna...</option>
                                </select>
                            </div>
                        </div>

                        <table id="list-table" class="display responsive table table-hover table-striped tbl-va-center table-compressed" cellspacing="0" width="100%">
                            <thead>
                                <tr>
                                    <th class="bobo-nowrap"></th>
                                    <th>Nome sito</th>
                                    <th>Prov</th>
                                    <th>Mezzi stanziati</th>
                                    <th>Dal</th>
                                    <th>Al</th>
                                    <th>Campagna</th>
                                    <th>Reti</th>
                                    <th>Note</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th class="bobo-nowrap"></th>
                                    <th>Nome sito</th>
                                    <th>Prov</th>
                                    <th>Mezzi stanziati</th>
                                    <th>Dal</th>
                                    <th>Al</th>
                                    <th>Campagna</th>
                                    <th>Reti</th>
                                    <th>Note</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <div class="tab-pane p-20" id="new-element" role="tabpanel">
                        <h4 class="box-title">Inserisci nuovo SITO</h4>
                        <hr class="m-t-0 m-b-20">
                        <form class="form" id="site-form" name="site-form">
                            <input type="hidden" class="clear-input" id="site-id" name="site-id" value="">
                            <div class="form-group row">
                                <label for="site-name" class="col-2 col-form-label">Nome sito <span class="text-danger">*</span></label>
                                <div class="col-10">
                                    <input type="text" class="form-control clear-input" id="site-name" name="site-name" placeholder="Nome...">
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="site-networks" class="col-2 col-form-label">Reti di appartenenza <span class="text-danger">*</span></label>
                                <div class="col-3">
                                    <select class="custom-select clear-select col-12" id="site-networks" name="site-networks" data-dest="main-loc-lab" multiple>
                                        % foreach my $network (@{$networks}){
                                            <option value="<%= $network->{st_network_id}%>"><%= $network->{st_network_name} %></option>
                                        % }
                                    </select>
                                </div>
                                <label for="site-attach" class="col-2 col-form-label">Allegati</label>
                                <div class="col-5">
                                    <div id="site-attach" class="dropzone"></div>
                                    <div class="row attachment-gallery-big m-t-10 m-b-10">
                                        <div class="col-md-12" id="img-container">
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-12 attachment-files"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="site-note" class="col-2 col-form-label">Note sito</label>
                                <div class="col-10">
                                    <textarea class="form-control clear-input" rows="4" id="site-note" name="site-note"></textarea>
                                </div>
                            </div>
                            <h5 class="divider-title">Dati geografici</h5>
                            <div class="form-group row">
                                <div class="col-2">
                                    <button type="button" class="btn btn-primary" name="btn-map-selection" id="btn-map-selection"> <i class="ti-map-alt"></i> scegli da mappa</button>
                                </div>
                                <div class="col-10 map-container">
                                    <div id="map-selection" class="mini-map" tabindex="0"></div>
                                    <p class="m-b-0"><strong class="text-info">UTILIZZO:</strong> clicca sulla mappa nel punto che vuoi definire come "sito" e sposta il cursore per migliorarne la precisione.<br>Tutti <strong>i campi della geolocalizzazione si compileranno automaticamente</strong></p>
                                </div>
                            </div>
                            <hr class="hr-dashed m-b-10">
                            <div class="form-group row">
                                <label for="site-region" class="col-2 col-form-label">Regione</label>
                                <div class="col-4">
                                    <select class="custom-select clear-select col-12" id="site-region" name="site-region">
                                        <option value="-1">Seleziona...</option>
                                        % foreach my $region (@{$regions}){
                                            <option value="<%= $region->{'region_id'} %>"><%= $region->{'region_name'} %></option>
                                        % }
                                    </select>
                                </div>
                                <label for="site-prov" class="col-2 col-form-label">Provincia</label>
                                <div class="col-4">
                                    <select class="custom-select clear-select col-12" id="site-prov" name="site-prov">
                                        <option value="-1">Seleziona provincia...</option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="site-district" class="col-2 col-form-label">Comune <span class="text-danger">*</span></label>
                                <div class="col-4">
                                    <select class="custom-select clear-select col-12" id="site-district" name="site-district">
                                        <option value="-1">Seleziona comune...</option>
                                        <option value="0">Sconosciuto</option>
                                    </select>
                                </div>
                                <label for="site-locality" class="col-2 col-form-label">Località <span class="text-danger">*</span></label>
                                <div class="col-4">
                                    <input type="text" class="form-control clear-input" id="site-locality" name="site-locality" placeholder="Località...">
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="site-latitude" class="col-2 col-form-label">WGS84 latitudine <span class="text-danger">*</span></label>
                                <div class="col-4">
                                    <input type="text" class="form-control clear-input" id="site-latitude" name="site-latitude" placeholder="Latitudine...">
                                </div>
                                <label for="site-longitude" class="col-2 col-form-label">WGS84 longitudine <span class="text-danger">*</span></label>
                                <div class="col-4">
                                    <input type="text" class="form-control clear-input" id="site-longitude" name="site-longitude" placeholder="Longitudine...">
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="site-altitude" class="col-2 col-form-label">Quota</label>
                                <div class="col-4">
                                    <input type="text" class="form-control clear-input" id="site-altitude" name="site-altitude" placeholder="Quota...">
                                </div>
                            </div>

                            <div id="hide-edit">
                                <h5 class="divider-title">Stanziamento mezzo mobile</h5>
                                <div class="form-group row" id="add-location-container">
                                    <div class="col-sm-10 offset-md-2 m-b-10">
                                        <input type="checkbox" class="js-switch" data-color="#79a030" id="add-location" name="add-location"/> <strong>Aggiungi un mezzo in questa location</strong>
                                    </div>
                                </div>
                                <div id="add-location-fields">
                                    <div class="form-group row">
                                        <label for="main-loc-lab" class="col-2 col-form-label">Lab. mobile <span class="text-danger">*</span></label>
                                        <div class="col-4">
                                            <select class="custom-select clear-select col-12" id="main-loc-lab" name="main-loc-lab">
                                                <option value="-1">Seleziona laboratorio...</option>
                                            </select>
                                        </div>
                                        <label for="main-loc-campaign" class="col-2 col-form-label">Campagna</label>
                                        <div class="col-4">
                                            <select class="custom-select clear-select col-12" id="main-loc-campaign" name="main-loc-campaign">
                                                <option value="-1">Seleziona campagna...</option>
                                            </select>
                                            <a href="javascript:void(0)" data-target="#modal-campaigns" data-toggle="modal">Gestisci campagne &raquo;</a>
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <label for="main-loc-start-date" class="col-2 col-lg-2 col-form-label">Data/ora inizio <span class="text-danger">*</span></label>
                                        <div class="input-group col-4 col-lg-2">
                                            <input type="text" class="form-control clear-input" id="main-loc-start-date" name="main-loc-start-date" placeholder="mm/dd/yyyy hh:mm">
                                            <div class="input-group-append">
                                                <span class="input-group-text"><i class="icon-calender"></i></span>
                                            </div>
                                        </div>
                                        <label for="main-loc-end-date" class="col-2 col-lg-2 col-form-label">Data/ora fine</label>
                                        <div class="input-group col-4 col-lg-2">
                                            <input type="text" class="form-control clear-input" id="main-loc-end-date" name="main-loc-end-date" placeholder="mm/dd/yyyy hh:mm">
                                            <div class="input-group-append">
                                                <span class="input-group-text"><i class="icon-calender"></i></span>
                                            </div>
                                        </div>
                                        <label for="main-ext-id" class="col-2 col-lg-2 col-form-label mob-mt10">
                                            ID esterno
                                            <a class="mytooltip" href="javascript:void(0)">
                                                <i class="fa-regular fa-circle-info text-info"></i>
                                                <span class="tooltip-content5"><span class="tooltip-text3"><span class="tooltip-inner2">Id stanziamento esposto dall'API e usato per la mappatura con i sistemi interni di ciascuna ARPA</span></span></span>
                                            </a>
                                        </label>
                                        <div class="col-4 col-lg-2 mob-mt10">
                                            <input type="text" class="form-control clear-input" id="main-ext-id" name="main-ext-id" placeholder="ID esterno">
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <label for="main-loc-notes" class="col-2 col-form-label">Note location</label>
                                        <div class="col-10">
                                            <textarea class="form-control clear-input" rows="6" id="main-loc-notes" name="main-loc-notes"></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <hr class="m-t-30">
                            <div class="form-group row">
                                <div class="col-12">
                                    <button type="submit" class="btn btn-info" name="btn-site-form" id="btn-site-form"> <i class="ti-save"></i> Inserisci</button>
                                    <button type="button" class="btn btn-inverse" name="cancel-site-form" id="cancel-site-form">Annulla</button>
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="tab-pane p-20" id="new-location" role="tabpanel">
                        <h4 class="box-title">Inserisci nuovo stanziamento</h4>
                        <hr class="m-t-0 m-b-20">
                        <form id="loc-form" name="loc-form">
                            <input type="hidden" class="clear-input" id="loc-id" name="loc-id" value="">

                            <div class="form-group row">
                                <label for="loc-site" class="col-2 col-form-label">Sito <span class="text-danger">*</span></label>
                                <div class="col-10">
                                    <select class="custom-select clear-select col-12" id="loc-site" name="loc-site">
                                        <option value="-1">Seleziona...</option>
                                    </select>
                                </div>
                            </div>

                            <div class="hide-loc">
                                <h5 class="divider-title">Stanziamento mezzo mobile</h5>
                                <div class="form-group row">
                                    <label for="loc-lab" class="col-2 col-form-label">Lab. mobile <span class="text-danger">*</span></label>
                                    <div class="col-4">
                                        <select class="custom-select clear-select col-12" id="loc-lab" name="loc-lab">
                                            <option value="-1">Seleziona laboratorio...</option>
                                        </select>
                                    </div>
                                    <label for="loc-campaign" class="col-2 col-form-label">Campagna</label>
                                    <div class="col-4">
                                        <select class="custom-select clear-select col-12" id="loc-campaign" name="loc-campaign">
                                            <option value="-1">Seleziona campagna...</option>
                                        </select>
                                        <a href="javascript:void(0)" data-target="#modal-campaigns" data-toggle="modal">Gestisci campagne &raquo;</a>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <label for="loc-start-date" class="col-2 col-lg-2 col-form-label">Data/ora inizio <span class="text-danger">*</span></label>
                                    <div class="input-group col-4 col-lg-2">
                                        <input type="text" class="form-control clear-input" id="loc-start-date" name="loc-start-date" placeholder="mm/dd/yyyy hh:mm">
                                        <div class="input-group-append">
                                            <span class="input-group-text"><i class="icon-calender"></i></span>
                                        </div>
                                    </div>
                                    <label for="loc-end-date" class="col-2 col-lg-2 col-form-label">Data/ora fine</label>
                                    <div class="input-group col-4 col-lg-2">
                                        <input type="text" class="form-control clear-input" id="loc-end-date" name="loc-end-date" placeholder="mm/dd/yyyy hh:mm">
                                        <div class="input-group-append">
                                            <span class="input-group-text"><i class="icon-calender"></i></span>
                                        </div>
                                    </div>
                                    <label for="loc-ext-id" class="col-2 col-lg-2 col-form-label mob-mt10">
                                            ID esterno
                                            <a class="mytooltip" href="javascript:void(0)">
                                                <i class="fa-regular fa-circle-info text-info"></i>
                                                <span class="tooltip-content5"><span class="tooltip-text3"><span class="tooltip-inner2">Id stanziamento esposto dall'API e usato per la mappatura con i sistemi interni di ciascuna ARPA</span></span></span>
                                            </a>
                                        </label>
                                    <div class="col-4 col-lg-2 mob-mt10">
                                        <input type="text" class="form-control clear-input" id="loc-ext-id" name="loc-ext-id" placeholder="ID esterno">
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <label for="loc-notes" class="col-2 col-form-label">Note location</label>
                                    <div class="col-10">
                                        <textarea class="form-control clear-input" rows="6" id="loc-notes" name="loc-notes"></textarea>
                                    </div>
                                </div>
                                <hr class="m-t-30">
                                <div class="form-group row">
                                    <div class="col-12">
                                        <button type="submit" class="btn btn-info" id="loc-insert"><i class="icon-location-pin"></i> Inserisci</button>
                                        <button type="button" class="btn btn-inverse" id="loc-cancel">Annulla</button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL CATEGORIE CAMPAGNE -->
<div class="modal fade" id="modal-campaigns" tabindex="-1" role="dialog" aria-labelledby="modal-campaigns" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-primary"><strong>Gestisci</strong> campagne</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body one-tab-modal">
                <h5 class="text-info">Campagne esistenti</h5>
                <table id="campaigns-table" class="table table-compressed table-sm table-striped">
                    <thead>
                        <tr>
                            <th scope="col"></th>
                            <th scope="col">Nome</th>
                            <th scope="col">Reti</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
                <h5 class="text-info form-title">Aggiungi campagna</h5>
                <hr class="hr-dashed">
                <form class="form-horizontal" id="new-campaign">
                    <input type="hidden" name="camp-id" id="camp-id" value="">
                    <div class="form-group row">
                        <label for="new-camp-name" class="col-sm-3 col-form-label">Nome <span class="text-danger">*</span></label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control" id="camp-name" name="camp-name" placeholder="Nome...">
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="camp-networks" class="col-sm-3 col-form-label">Reti di appartenenza <span class="text-danger">*</span></label>
                        <div class="col-sm-9">
                            <select class="custom-select clear-select" id="camp-networks" name="camp-networks" multiple>
                                % foreach my $network (@{$networks}){
                                    <option value="<%= $network->{st_network_id}%>"><%= $network->{st_network_name} %></option>
                                % }
                            </select>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-sm-9 offset-sm-3">
                            <div class="bording"></div>
                            <button type="submit" name="btn-add-campaign" id="btn-add-campaign" class="btn btn-info"><i class="ti-save-alt"></i> Aggiungi</button>
                            <button type="button" class="btn btn-inverse" id="dismiss-camp">Annulla</button>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-link text-danger" data-dismiss="modal"><i class="ti-close"></i> CHIUDI</button>
            </div>
        </div>
    </div>
</div>