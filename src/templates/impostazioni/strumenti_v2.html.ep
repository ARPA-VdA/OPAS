% layout 'default';
% title 'Impostazioni di rete - Strumenti';

<script src="<%=url_for(helperGetFileVersion('/bobo-js/impostazioni/strumenti_v2.js'))%>" type="text/javascript"></script>
<style>
    .select2-results .select2-disabled,  .select2-results__option[aria-disabled=true] {
        display: none;
    }
</style>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-11">
                        <h4 class="card-title">Gli strumenti della tua rete</h4>
                        <h6 class="card-subtitle">Da questa pagina puoi visualizzare gli strumenti ed aggiungerne di nuovi</h6>
                    </div>
                </div>

                <!-- Nav tabs -->
                <ul class="nav nav-tabs customtab main-tab" role="tablist">
                    <li class="nav-item"> <a class="nav-link active" data-toggle="tab" href="#list" role="tab"><span class="hidden-sm-up"><i class="fa-regular fa-list-dropdown"></i></span> <span class="hidden-xs-down">Elenco</span></a> </li>
                    <!-- if user has insert grant -->
                    % if ($user_grants->{user_insert}){
                        <li class="nav-item"> <a class="nav-link text-info" data-toggle="tab" href="#new-element" id="new-bulletin" role="tab"><span class="hidden-sm-up"><i class="fa-regular fa-pen-line"></i></span> <span class="hidden-xs-down" id="inner-new-tool">Strumento</span></a></li>
                    % }
                </ul>
                <!-- Tab panes -->
                <div class="tab-content">
                    <div class="tab-pane p-20 active" id="list" role="tabpanel">

                        <div class="row m-b-10">
                            <div class="input-group col-lg-3">
                                <input class="form-control input-daterange-datepicker" type="text" name="daterange" value="" />
                                <div class="input-group-append">
                                    <span class="input-group-text"><i class="fa-regular fa-calendars"></i></span>
                                </div>
                            </div>
                            <div class="col-lg-3">
                                <select class="custom-select col-12" id="nets" name="nets">
                                    <option value="-1">Seleziona rete...</option>
                                    % foreach my $network (@{$networks}){
                                        <option value="<%= $network->{st_network_id}%>"><%= $network->{st_network_desc} %></option>
                                    % }
                                </select>
                            </div>
                            <div class="col-lg-3">
                                <select class="custom-select col-12" id="categories" name="categories">
                                    <option value="-1">Tutte le categorie</option>
                                    % foreach my $category (@{$categories}){
                                        <option value="<%= $category->{'category_id'} %>"><%= $category->{'category_name'} %></option>
                                    % }
                                </select>
                            </div>
                            <div class="col-lg-3 m-b-5">
                                <div class="custom-control custom-checkbox m-t-5">
                                    <input type="checkbox" class="custom-control-input" id="all-instruments" name="all-instruments">
                                    <label class="custom-control-label" for="all-instruments">Tutti gli strumenti</label>
                                    <a class="mytooltip" href="javascript:void(0)">
                                        <i class="fa-regular fa-circle-info text-info"></i>
                                        <span class="tooltip-content5"><span class="tooltip-text3"><span class="tooltip-inner2">Consente di disattivare il filtro calendario per estrarre <strong>TUTTI</strong> gli strumenti presenti nel sistema <strong>senza limiti temporali</strong>.</span></span></span>
                                    </a>
                                </div>
                            </div>
                        </div>

                        <table id="list-table" class="display responsive table table-hover table-striped tbl-va-center table-compressed" cellspacing="0" width="100%">
                            <thead>
                                <tr>
                                    <th class="bobo-nowrap"></th>
                                    <th class="bobo-nowrap">ID</th>
                                    <th class="bobo-nowrap">Tipo</th>
                                    <th>Nome</th>
                                    <th class="bobo-nowrap">S.N.</th>
                                    <th>Categoria</th>
                                    <th>Arpa ID</th>
                                    <th>Consegnato</th>
                                    <th>Dismesso</th>
                                    <th>Location</th>
                                    <th>Reti</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- <tr data-id="415" data-stinid="415" class="">
                                    <td class="bobo-nowrap icons-little">
                                        <a href="javascript:void(0)" class="show-element" data-toggle="tooltip" data-original-title="Visualizza strumento"> <i class="ti-zoom-in text-info"></i> </a>
                                        <a href="javascript:void(0)" class="edit-element" data-toggle="tooltip" data-original-title="Modifica strumento"> <i class="icon-pencil text-info"></i> </a>
                                        <a href="javascript:void(0)" class="delete-element" data-toggle="tooltip" data-original-title="Elimina tutto"> <i class="icon-trash text-danger"></i> </a>
                                    </td>
                                    <td>FAI Instruments SWAM 5a single</td>
                                    <td>PM10-BO-07</td>
                                    <td>222</td>
                                    <td>Campionatore polveri basso volume</td>
                                    <td>--</td>
                                    <td class="sorting_1">31/12/2008</td>
                                    <td>--</td>
                                    <td>San Pietro Capofiume (BO)</td>
                                    <td>Arpae rete regionale</td>
                                    <td></td>
                                </tr> -->
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th class="bobo-nowrap"></th>
                                    <th class="bobo-nowrap">ID</th>
                                    <th class="bobo-nowrap">Tipo</th>
                                    <th class="bobo-nowrap">Nome</th>
                                    <th class="bobo-nowrap">S.N.</th>
                                    <th>Categoria</th>
                                    <th>Arpa ID</th>
                                    <th>Consegnato</th>
                                    <th>Dismesso</th>
                                    <th>Location</th>
                                    <th>Reti</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <div class="tab-pane p-20" id="new-element" role="tabpanel">
                        <h4 class="box-title">Inserisci nuovo STRUMENTO</h4>
                        <hr class="m-t-0 m-b-20">
                        <form class="form" id="instrument-form" name="instrument-form">
                            <input type="hidden" class="clear-input" id="instr-id" name="instr-id" value="">
                            <div class="form-group row">
                                <label for="instr-type" class="col-2 col-form-label">Tipologia <span class="text-danger">*</span></label>
                                <div class="col-4">
                                    <select class="custom-select clear-select col-12" id="instr-type" name="instr-type" data-change="loc-params">
                                        <option value="-1">Seleziona...</option>
                                        % foreach my $type (@{$types}){
                                            <option value="<%= $type->{instr_type_id}%>"><%= $type->{instr_type_fullname} %> [ <%= $type->{category_name} %> ]</option>
                                        % }
                                    </select>
                                </div>
                                <label for="instr-name" class="col-2 col-form-label">Nome</label>
                                <div class="col-4">
                                    <input type="text" class="form-control clear-input" id="instr-name" name="instr-name" placeholder="Nome">
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="instr-arpa-id" class="col-2 col-form-label">Arpa ID</label>
                                <div class="col-4">
                                    <input type="text" class="form-control clear-input" id="instr-arpa-id" name="instr-arpa-id" placeholder="Arpa ID">
                                </div>
                                <label for="instr-serial-num" class="col-2 col-form-label">Numero di serie</label>
                                <div class="col-4">
                                    <input type="text" class="form-control clear-input" id="instr-serial-num" name="instr-serial-num" placeholder="Numero di serie">
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="instr-date-delivery" class="col-2 col-form-label">Consegnato il <span class="text-danger">*</span></label>
                                <div class="col-4 input-group">
                                    <input type="text" class="form-control clear-input" id="instr-date-delivery" name="instr-date-delivery" placeholder="dd/mm/yyyy">
                                    <div class="input-group-append">
                                        <span class="input-group-text"><i class="fa-regular fa-calendar-lines"></i></span>
                                    </div>
                                </div>
                                <label for="instr-date-disuse" class="col-2 col-form-label">Dismesso il</label>
                                <div class="col-4 input-group">
                                    <input type="text" class="form-control clear-input" id="instr-date-disuse" name="instr-date-disuse" placeholder="dd/mm/yyyy">
                                    <div class="input-group-append">
                                        <span class="input-group-text"><i class="fa-regular fa-calendar-lines"></i></span>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="instr-owner" class="col-2 col-form-label">Proprietario</label>
                                <div class="col-4">
                                    <input type="text" class="form-control clear-input" id="instr-owner" name="instr-owner" placeholder="Proprietario">
                                </div>
                                <div class="col-4 offset-2">
                                    Strumento attivo&nbsp;&nbsp;<input type="checkbox" checked data-onstyle="success" data-offstyle="danger" data-on="SI" data-off="NO" data-size="xs" data-style="android"  id="instr-active" name="instr-active" />
                                </div>
                            </div>
                            <h5 class="divider-title">Ulteriori dettagli</h5>
                            <div class="form-group row">
                                <label for="instr-networks" class="col-2 col-form-label">Reti di appartenenza <span class="text-danger">*</span></label>
                                <div class="col-3">
                                    <select class="custom-select clear-select col-12" id="instr-networks" name="instr-networks" data-dest="loc-stat" multiple>
                                        % foreach my $network (@{$networks}){
                                            <option value="<%= $network->{st_network_id}%>"><%= $network->{st_network_name} %></option>
                                        % }
                                    </select>
                                </div>
                                <label for="instr-attach" class="col-2 col-form-label">Allegati</label>
                                <div class="col-5">
                                    <div id="instr-attach" class="dropzone"></div>
                                    <div class="row attachment-gallery-big m-t-10 m-b-10">
                                        <div class="col-md-12" id="img-container">
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-12 attachment-files"></div>
                                    </div>
                                </div>
                            </div>
                            <h5 class="divider-title">Eventuali annotazioni</h5>
                            <div class="form-group row">
                                <label for="instr-note" class="col-2 col-form-label">Note strumento</label>
                                <div class="col-10">
                                    <textarea class="form-control clear-input" rows="6" id="instr-note" name="instr-note"></textarea>
                                </div>
                            </div>
                            <div id="hide-edit">
                                <div class="form-group row" id="add-location-container">
                                    <div class="col-sm-10 offset-md-2 m-b-10">
                                        <input type="checkbox" class="js-switch" data-color="#79a030" id="add-location" name="add-location"/> <strong>Aggiungi location per lo strumento</strong>
                                    </div>
                                </div>
                                <div id="add-location-fields">
                                    <h5 class="divider-title">Inserisci location</h5>
                                    <div class="form-group row">
                                        <label for="loc-prov" class="col-2 col-form-label">Provincia</label>
                                        <div class="col-4">
                                            <select class="custom-select clear-select col-12" id="loc-prov" name="loc-prov" data-change="loc-stat">
                                                <option value="-1">Seleziona provincia...</option>
                                                % my $region = '';
                                                % foreach my $province (@{$provinces}){

                                                    % if ($region eq ''){
                                                        <optgroup label="<%= $province->{'region_name'} %>">
                                                        <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                                    % }else{
                                                        % if ($region eq $province->{'region_id'}){
                                                            <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                                        % } else {
                                                            </optgroup>
                                                            <optgroup label="<%= $province->{'region_name'} %>">
                                                            <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                                        % }
                                                    % }
                                                    % $region = $province->{'region_id'};
                                                % }
                                                </optgroup>
                                            </select>

                                        </div>
                                        <label for="loc-stat" class="col-2 col-form-label">Stazione <span class="text-danger">*</span></label>
                                        <div class="col-4">
                                            <select class="custom-select clear-select col-12" id="loc-stat" name="loc-stat" data-change="loc-params">
                                                <option value="-1">Seleziona...</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <label for="loc-start-date" class="col-2 col-form-label">Data/ora inizio <span class="text-danger">*</span></label>
                                        <div class="input-group col-4">
                                            <input type="text" class="form-control clear-input" id="loc-start-date" name="loc-start-date" placeholder="mm/dd/yyyy hh:mm">
                                            <div class="input-group-append">
                                                <span class="input-group-text"><i class="fa-regular fa-calendar-lines"></i></span>
                                            </div>
                                        </div>
                                        <label for="loc-end-date" class="col-2 col-form-label">Data/ora fine</label>
                                        <div class="input-group col-4">
                                            <input type="text" class="form-control clear-input" id="loc-end-date" name="loc-end-date" placeholder="mm/dd/yyyy hh:mm">
                                            <div class="input-group-append">
                                                <span class="input-group-text"><i class="fa-regular fa-calendar-lines"></i></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-4 offset-2">
                                            <div class="custom-control custom-checkbox m-t-10">
                                                <input type="checkbox" class="custom-control-input" id="loc-first" name="loc-first" checked>
                                                <label class="custom-control-label" for="loc-first">Strumento primario</label>
                                            </div>
                                        </div>
                                        <label for="loc-params" class="col-2 col-form-label">Parametri collegati <span class="text-danger">*</span></label>
                                        <div class="col-4">
                                            <select class="custom-select clear-select col-12" id="loc-params" name="loc-params">
                                                <option value="-1">Seleziona...</option>
                                                <option value="0">Nessun parametro associabile</option>
                                            </select>
                                            <p class="font-italic text-primary"><strong>ATTENZIONE!</strong> Selezionando "Nessun parametro associabile" non sarà possibile risalire alla fonte di produzione dei dati.</p>
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <label for="loc-notes" class="col-2 col-form-label">Note location</label>
                                        <div class="col-10">
                                            <textarea class="form-control clear-input" rows="6" id="loc-notes" name="loc-notes"></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <hr class="m-t-30">
                            <div class="form-group row">
                                <div class="col-12">
                                    <button type="submit" class="btn btn-info" name="btn-instrument-form" id="btn-instrument-form"> <i class="fa-regular fa-arrow-down-to-arc"></i> Inserisci</button>
                                    <button type="button" class="btn btn-inverse" name="cancel-instrument-form" id="cancel-instrument-form">Annulla</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
