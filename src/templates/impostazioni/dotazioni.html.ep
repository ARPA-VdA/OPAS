% layout 'default';
% title 'Impostazioni di rete - Dotazioni';

<script src="<%=url_for(helperGetFileVersion('/bobo-js/impostazioni/dotazioni.js'))%>" type="text/javascript"></script>


<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-11">
                        <h4 class="card-title">Visualizza e posiziona le dotazioni</h4>
                        <h6 class="card-subtitle">Da questa pagina puoi visualizzare tutte le dotazioni, aggiungerne di nuove oppure posizionarle nelle stazioni appartenenti alla tua rete</h6>
                    </div>
                </div>

                <!-- Nav tabs -->
                <ul class="nav nav-tabs customtab main-tab" role="tablist">
                    <li class="nav-item"> <a class="nav-link active" data-toggle="tab" href="#list" role="tab"><span class="hidden-sm-up"><i class="fas fa-th-list text-muted"></i></span> <span class="hidden-xs-down">Dotazioni</span></a> </li>
                    <!-- if user has insert grant -->
                    % if ($user_grants->{user_insert}){
                        <li class="nav-item"> <a class="nav-link text-info" data-toggle="tab" href="#new-element" role="tab"><span class="hidden-sm-up"><i class="fas fa-plus-octagon text-danger"></i></span> <span class="hidden-xs-down">Dotazione</span></a> </li>
                        <li class="nav-item"> <a class="nav-link text-info" data-toggle="tab" href="#new-location" id="new-loc" role="tab"><span class="hidden-sm-up"><i class="fas fa-map-marker-plus text-danger"></i></span> <span class="hidden-xs-down" >Stanziamento</span></a> </li>
                    % }
                </ul>
                <!-- Tab panes -->
                <div class="tab-content">
                    <div class="tab-pane p-20 active" id="list" role="tabpanel">
                        <div class="row m-b-10">
                            <div class="col-12">
                                <label class="switch">
                                    Ricerca&nbsp;&nbsp;
                                    <input type="checkbox" class="view-pg clear-field" data-onstyle="warning" data-offstyle="success" data-on="STANZIAMENTO" data-off="DOTAZIONE" data-size="sm" data-style="android" name="search-type" id="search-type">
                                    <!-- Ricerca per stanziamento -->
                                </label>
                                <div class="legend-txt">
                                    <span id="active-instr">
                                        <i class="fa-regular fa-circle-question text-info"></i> Elenco di tutte le le dotazioni presenti nel database.
                                    </span>
                                    <span id="active-loc">
                                        <i class="fa-regular fa-circle-question text-info"></i> Il periodo temporale inserito filtra le dotazioni in base alle date di <strong>inizio</strong> e <strong>fine stanziamento</strong>.
                                    </span>
                                </div>
                            </div>
                            <div class="select-place input-group col-md-4">
                                <input class="form-control input-daterange-datepicker" type="text" name="daterange" value="" />
                                <div class="input-group-append">
                                    <span class="input-group-text"><i class="mdi mdi-calendar-multiple"></i></span>
                                </div>
                            </div>
                            <div class="select-place col-md-4">
                                <select class="custom-select col-12" id="provinces" name="provinces" data-change="stations">
                                    <option value="-1">Seleziona provincia...</option>
                                    % my $region = '';
                                    % foreach my $province (@{$provinces}){

                                        % if ($region eq ''){
                                            <optgroup label="<%= $province->{'region_name'} %>">
                                            <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                        % }else{
                                            % if ($region eq $province->{'region_id'}){
                                                <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                            % } else {
                                                </optgroup>
                                                <optgroup label="<%= $province->{'region_name'} %>">
                                                <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                            % }
                                        % }
                                        % $region = $province->{'region_id'};
                                    % }
                                    </optgroup>
                                </select>
                            </div>
                            <div class="select-place col-md-4">
                                <select class="custom-select col-12" id="stations" name="stations">
                                    <option value="-1">Seleziona stazione...</option>
                                </select>
                            </div>
                        </div>
                        <table id="list-table" class="display responsive table table-hover table-striped tbl-va-center table-compressed" cellspacing="0" width="100%">
                            <thead>
                                <tr>
                                    <th class="bobo-nowrap"></th>
                                    <th class="bobo-nowrap">Arpa ID</th>
                                    <th>Dotazione</th>
                                    <th>Dismesso</th>
                                    <th>Location attuale</th>
                                    <th>Dal</th>
                                    <th>Al</th>
                                    <th>Attiva</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th class="bobo-nowrap"></th>
                                    <th class="bobo-nowrap">Arpa ID</th>
                                    <th>Dotazione</th>
                                    <th>Dismesso</th>
                                    <th>Location attuale</th>
                                    <th>Dal</th>
                                    <th>Al</th>
                                    <th>Attiva</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <div class="tab-pane p-20" id="new-element" role="tabpanel">
                        <h4 class="box-title">Inserisci nuova DOTAZIONE</h4>
                        <hr class="m-t-0 m-b-20">
                        <form class="form" id="equipment-form" name="equipment-form">
                            <input type="hidden" class="clear-input" id="equipment-id" name="equipment-id" value="">
                            <div class="form-group row">
                                <label for="equipment-name" class="col-2 col-form-label">Dotazione <span class="text-danger">*</span></label>
                                <div class="col-4">
                                    <input type="text" class="form-control clear-input" id="equipment-name" name="equipment-name" placeholder="Dotazione">
                                </div>
                                <label for="equipment-arpa-id" class="col-2 col-form-label">Arpa ID</label>
                                <div class="col-4">
                                    <input type="text" class="form-control clear-input" id="equipment-arpa-id" name="equipment-arpa-id" placeholder="Arpa ID">
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="equipment-owner" class="col-2 col-form-label">Proprietario</label>
                                <div class="col-4">
                                    <input type="text" class="form-control clear-input" id="equipment-owner" name="equipment-owner" placeholder="Proprietario">
                                </div>
                                <label for="equipment-date-dismiss" class="col-2 col-form-label">Dismesso il</label>
                                <div class="col-4 input-group">
                                    <input type="text" class="form-control clear-input" id="equipment-date-dismiss" name="equipment-date-dismiss" placeholder="mm/dd/yyyy">
                                    <div class="input-group-append">
                                        <span class="input-group-text"><i class="icon-calender"></i></span>
                                    </div>
                                </div>
                                <!-- <div class="col-4 offset-2">
                                    Dotazione attiva&nbsp;&nbsp;<input type="checkbox" checked data-onstyle="success" data-offstyle="danger" data-on="SI" data-off="NO" data-size="xs" data-style="android"  id="equipment-active" name="equipment-active" />
                                </div> -->
                                <!-- <label for="equipment-networks" class="col-2 col-form-label">Reti di appartenenza</label>
                                <div class="col-4">
                                    <select class="custom-select clear-select col-12" id="equipment-networks" name="equipment-networks" multiple>
                                        <option value="1">Rete 1</option>
                                        <option value="2">Rete 2</option>
                                        <option value="3">Rete 3</option>
                                    </select>
                                </div> -->
                            </div>
                            <div class="form-group row">
                                <div class="col-4 offset-8">
                                    Dotazione attiva&nbsp;&nbsp;<input type="checkbox" checked data-onstyle="success" data-offstyle="danger" data-on="SI" data-off="NO" data-size="xs" data-style="android"  id="equipment-active" name="equipment-active" />
                                </div>
                            </div>
                            <h5 class="divider-title">Ulteriori dettagli</h5>
                            <div class="form-group row">
                                <label for="equipment-networks" class="col-2 col-form-label">Reti di appartenenza <span class="text-danger">*</span></label>
                                <div class="col-3">
                                    <select class="custom-select clear-select col-12" id="equipment-networks" name="equipment-networks" data-dest="loc-stat" multiple>
                                        % foreach my $network (@{$networks}){
                                            <option value="<%= $network->{st_network_id}%>"><%= $network->{st_network_name} %></option>
                                        % }
                                    </select>
                                </div>
                                <label for="equipment-attach" class="col-2 col-form-label">Allegati</label>
                                <div class="col-5">
                                    <div id="equipment-attach" class="dropzone"></div>
                                    <div class="row attachment-gallery-big m-t-10 m-b-10">
                                        <div class="col-md-12" id="img-container">
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-12 attachment-files"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="equipment-note" class="col-2 col-form-label">Note aggiuntive</label>
                                <div class="col-10">
                                    <textarea class="form-control clear-input" rows="6" id="equipment-note" name="equipment-note"></textarea>
                                </div>
                            </div>
                            <div id="hide-edit">
                                <div class="form-group row" id="add-location-container">
                                    <div class="col-sm-10 offset-md-2 m-b-10">
                                        <input type="checkbox" class="js-switch" data-color="#79a030" id="add-location" name="add-location"/> <strong>Aggiungi location per la dotazione</strong>
                                    </div>
                                </div>
                                <div id="add-location-fields">
                                    <h5 class="divider-title">Inserisci location</h5>
                                    <div class="form-group row">
                                        <label for="loc-prov" class="col-2 col-form-label">Provincia</label>
                                        <div class="col-4">
                                            <select class="custom-select clear-select col-12" id="loc-prov" name="loc-prov" data-dest="loc-stat">
                                                <option value="-1">Seleziona provincia...</option>
                                                % my $region = '';
                                                % foreach my $province (@{$provinces}){

                                                    % if ($region eq ''){
                                                        <optgroup label="<%= $province->{'region_name'} %>">
                                                        <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                                    % }else{
                                                        % if ($region eq $province->{'region_id'}){
                                                            <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                                        % } else {
                                                            </optgroup>
                                                            <optgroup label="<%= $province->{'region_name'} %>">
                                                            <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                                        % }
                                                    % }
                                                    % $region = $province->{'region_id'};
                                                % }
                                                </optgroup>
                                            </select>

                                        </div>
                                        <label for="loc-stat" class="col-2 col-form-label">Stazione <span class="text-danger">*</span></label>
                                        <div class="col-4">
                                            <select class="custom-select clear-select col-12" id="loc-stat" name="loc-stat">
                                                <option value="-1">Seleziona...</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <label for="loc-start-date" class="col-2 col-form-label">Data/ora inizio <span class="text-danger">*</span></label>
                                        <div class="input-group col-4">
                                            <input type="text" class="form-control clear-input" id="loc-start-date" name="loc-start-date" placeholder="mm/dd/yyyy hh:mm">
                                            <div class="input-group-append">
                                                <span class="input-group-text"><i class="icon-calender"></i></span>
                                            </div>
                                        </div>
                                        <label for="loc-end-date" class="col-2 col-form-label">Data/ora fine</label>
                                        <div class="input-group col-4">
                                            <input type="text" class="form-control clear-input" id="loc-end-date" name="loc-end-date" placeholder="mm/dd/yyyy hh:mm">
                                            <div class="input-group-append">
                                                <span class="input-group-text"><i class="icon-calender"></i></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <label for="loc-notes" class="col-2 col-form-label">Note location</label>
                                        <div class="col-10">
                                            <textarea class="form-control clear-input" rows="6" id="loc-notes" name="loc-notes"></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <hr class="m-t-30">
                            <div class="form-group row">
                                <div class="col-12">
                                    <button type="submit" class="btn btn-info" name="btn-equipment-form" id="btn-equipment-form"> <i class="ti-save"></i> Inserisci</button>
                                    <button type="button" class="btn btn-inverse" name="cancel-equipment-form" id="cancel-equipment-form">Annulla</button>
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="tab-pane p-20" id="new-location" role="tabpanel">
                        <h4 class="box-title">Inserisci nuovo stanziamento</h4>
                        <hr class="m-t-0 m-b-20">
                        <form id="place-equipment-form" name="place-equipment-form">
                            <input type="hidden" class="clear-input" id="place-loc-id" name="place-loc-id" value="">
                            <input type="hidden" class="clear-input" id="place-networks" name="place-networks" value="">

                            <div class="form-group row">
                                <label for="place-loc-equipment" class="col-2 col-form-label">Dotazione</label>
                                <div class="col-10">
                                    <select class="custom-select clear-select col-12" id="place-loc-equipment" name="place-loc-equipment">
                                        <option value="-1">Seleziona...</option>
                                    </select>
                                </div>
                            </div>

                            <div class="hide-loc">
                                <h5 class="divider-title">Inserisci location</h5>

                                <div class="form-group row">
                                    <label for="place-loc-prov" class="col-2 col-form-label">Provincia</label>
                                    <div class="col-4">
                                        <select class="custom-select clear-select col-12" id="place-loc-prov" name="place-loc-prov" data-dest="place-loc-stat">
                                            <option value="-1">Seleziona provincia...</option>
                                            % $region = '';
                                            % foreach my $province (@{$provinces}){

                                                % if ($region eq ''){
                                                    <optgroup label="<%= $province->{'region_name'} %>">
                                                    <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                                % }else{
                                                    % if ($region eq $province->{'region_id'}){
                                                        <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                                    % } else {
                                                        </optgroup>
                                                        <optgroup label="<%= $province->{'region_name'} %>">
                                                        <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                                    % }
                                                % }
                                                % $region = $province->{'region_id'};
                                            % }
                                            </optgroup>
                                        </select>

                                    </div>
                                    <label for="place-loc-stat" class="col-2 col-form-label">Stazione <span class="text-danger">*</span></label>
                                    <div class="col-4">
                                        <select class="custom-select clear-select col-12" id="place-loc-stat" name="place-loc-stat">
                                            <option value="-1">Seleziona...</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <label for="place-loc-start-date" class="col-2 col-form-label">Data/ora inizio <span class="text-danger">*</span></label>
                                    <div class="input-group col-4">
                                        <input type="text" class="form-control clear-input" id="place-loc-start-date" name="place-loc-start-date" placeholder="mm/dd/yyyy hh:mm">
                                        <div class="input-group-append">
                                            <span class="input-group-text"><i class="icon-calender"></i></span>
                                        </div>
                                    </div>
                                    <label for="place-loc-end-date" class="col-2 col-form-label">Data/ora fine</label>
                                    <div class="input-group col-4">
                                        <input type="text" class="form-control clear-input" id="place-loc-end-date" name="place-loc-end-date" placeholder="mm/dd/yyyy hh:mm">
                                        <div class="input-group-append">
                                            <span class="input-group-text"><i class="icon-calender"></i></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <label for="place-loc-notes" class="col-2 col-form-label">Note location</label>
                                    <div class="col-10">
                                        <textarea class="form-control clear-input" rows="6" id="place-loc-notes" name="place-loc-notes"></textarea>
                                    </div>
                                </div>
                                <hr class="m-t-30">
                                <div class="form-group row">
                                    <div class="col-12">
                                        <button type="submit" class="btn btn-info" id="place-loc-insert"><i class="icon-location-pin"></i> Inserisci</button>
                                        <button type="button" class="btn btn-inverse" id="place-loc-cancel">Annulla</button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                    <!-- <div class="tab-pane p-20" id="show-element" role="tabpanel">
                        <div class="form-body panel-report-view">
