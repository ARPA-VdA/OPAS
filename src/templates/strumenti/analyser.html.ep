<!-- MODAL INFORMAZIONI SU SCORCIATOIE TASTIERA -->
<div class="modal fade" id="keyboard-shortcuts-info" tabindex="-1" role="dialog" aria-labelledby="keyboard-shortcuts-info" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-info" id="">Informazioni sull'utilizzo della scorciatoie da tastiera (keyboard shortcuts)</h5>
                <button type="button" class="close close-val-box" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <h5>Scorciatoie da tastiera per i <strong>GRAFICI</strong></h5>
                <p>Utilizzando queste <strong>scorciatoie sui grafici</strong> potrai attivare delle funzionalità aggiuntive che potrebbero tornarti utili durante la navigazione:</p>
                <ul>
                    <li><code class="font-bold">SHIFT + click sinistro premuto</code>&nbsp;&nbsp;::&nbsp;&nbsp;sposta visualizzazione dello zoom</li>
                    <li><code class="font-bold">CTRL + click sinistro</code>&nbsp;&nbsp;::&nbsp;&nbsp;apre in una nuova pagina l'intorno del punto sul tool validazione</li>
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-link close-val-box" data-dismiss="modal" id="val-cal-cancel"><i class="ti-close"></i> CHIUDI</button>
            </div>
        </div>
    </div>
</div>