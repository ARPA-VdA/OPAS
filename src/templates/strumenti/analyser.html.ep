% layout 'tools';
% title 'Analyser';

<link  href="<%=url_for(helperGetFileVersion('/bobo-css/tools.css'))%>" rel="stylesheet">

<!-- jquery file download -->
<script type="text/javascript" src="<%= url_for('/node_modules/filedownload/jquery.fileDownload.js')%>"></script>

<script src="<%=url_for(helperGetFileVersion('/bobo-js/strumenti/analyser_layout.js'))%>" type="text/javascript"></script>
<script src="<%=url_for(helperGetFileVersion('/bobo-js/strumenti/analyser.js'))%>" type="text/javascript"></script>
<script src="<%=url_for(helperGetFileVersion('/bobo-js/strumenti/analyser_settings.js'))%>" type="text/javascript"></script>

<div class="preloader"></div>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark navbar-main" id="analyser-navbar">
    <a href="/" class="go-to-portal" data-toggle="tooltip" data-original-title="Torna al portale"><i class="ti-share-alt"></i></a>
    <a class="navbar-brand" href="/str_analyser"><i class="fa-solid fa-chart-mixed"></i> Analyser</a>
    <a href="/help/str_analyser" class="go-to-help" data-toggle="tooltip" data-original-title="Accedi alla documentazione" target="_blank"><i class="ti-help-alt"></i></a>
    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarSupportedContent">
        <ul class="navbar-nav mr-auto" id="analyser-menu">
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown-strumenti" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                Strumenti
                </a>
                <div class="dropdown-menu" aria-labelledby="navbarDropdown-strumenti">
                    <!-- <a class="dropdown-item" href="#">Imposta colori</a> -->
                    <!-- <div class="dropdown-divider"></div> -->
                    <a class="dropdown-item" href="javascript:void(0)" data-target="#settings-analyser" data-toggle="modal">Opzioni</a>
                    <div class="dropdown-divider"></div>
                    <a class="dropdown-item" id="all-tree" href="#">Carica albero completo</a>
                </div>
            </li>
            <li class="nav-item dropdown hide-windrose">
                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown-dati" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                Dati
                </a>
                <div class="dropdown-menu" aria-labelledby="navbarDropdown-dati">
                    <a class="dropdown-item label-as-link" href="" data-target="#dati-copertura" data-toggle="modal">Copertura: <strong id="copertura">75%</strong></a>
                    <div class="dropdown-divider"></div>
                    <a class="dropdown-item" href="#" data-hidenull="false" id="hide-undefined">Non definiti <em>(null)</em> : <strong>visualizzati</strong></a>
                </div>
            </li>
            <li class="nav-item dropdown" id="validity-codes">
                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown-validity" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                Validità
                </a>
                <div class="dropdown-menu valcode-menu" aria-labelledby="navbarDropdown-validity">
                    <span class="validation-operators">
                        <button><=</button>
                        <button>=</button>
                        <button class="sel default-val">>=</button>
                    </span>
                    <div class="dropdown-divider"></div>
                    <%  foreach my $val_code (@{$val_codes}){
                            if($val_code->{uvc_code_default} == 1){ %>
                                <a class="dropdown-item sel default-val" href="#" data-id="<%=$val_code->{uvc_code_id} %>"><span><%=$val_code->{uvc_code_id} %></span> <%= $val_code->{uvc_code_desc} %> <i class="mdi mdi-check text-danger"></i></a>
                            <% }
                            else { %>
                                <a class="dropdown-item" href="#" data-id="<%=$val_code->{uvc_code_id} %>"><span><%=$val_code->{uvc_code_id} %></span> <%= $val_code->{uvc_code_desc} %></a>
                            <% }
                    } %>
                    <div class="dropdown-divider"></div>
                    <a class="dropdown-item" href="#">Tutti i dati </a>
                </div>
            </li>
            <li class="nav-item dropdown hide-windrose">
                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown-macro" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                Macro
                </a>
                <div class="dropdown-menu" aria-labelledby="navbarDropdown-macro">
                    <a class="dropdown-item category-macro" href="javascript:void(0)" data-target="#category-macro" data-toggle="modal">Categorie</a>
                    % if ($user_grants->{user_insert} && $user_grants->{user_update}){
                    <a class="dropdown-item save-macro" href="#">Salva macro</a>
                    % }
                    <a class="dropdown-item update-macro" href="javascript:void(0)" data-target="#settings-macro" data-toggle="modal">Modifica macro</a>
                </div>
            </li>
        </ul>
    </div>
    <!-- <a href="#" class="navbar-right" data-toggle="tooltip" title="Apri impostazioni Analyser"><i class="ti-settings"></i></a> -->
</nav>
<div class="row bg-grey no-gutters" id="analyser-nogutters">
    <div class="col-sm-12">
        <div class="analyser-buttons clearfix">
            <!-- BOTTONI DI ESEMPIO
            <button type="button" class="btn btn-primary"><i class="ti-settings"></i></button>
            <button type="button" class="btn btn-secondary"><i class="mdi mdi-home-variant"></i></button>
            <button type="button" class="btn btn-info"><i class="ti-ruler-alt"></i></button>
            <button type="button" class="btn btn-link">Link</button> -->

            <div class="btn-set" id="btnset-time">
                <div class="input-group group-buttons">
                    <div class="input-group-prepend" id="start-date-btns">
                        <button class="btn btn-secondary dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"><i class="mdi mdi-calendar-multiple"></i></button>
                        <div class="dropdown-menu">
                            <a class="dropdown-item" id="start-date-today" href="#">Oggi</a>
                            <div role="separator" class="dropdown-divider"></div>
                            <a class="dropdown-item" id="start-date-fdm" href="#">Primo gg mese</a>
                            <a class="dropdown-item" id="start-date-fdy" href="#">Primo gg anno</a>
                            <a class="dropdown-item" id="start-date-curr-fdm" href="#">Primo gg mese corrente</a>
                            <a class="dropdown-item" id="start-date-curr-fdy" href="#">Primo gg anno corrente</a>
                            <div role="separator" class="dropdown-divider"></div>
                            <div class="dropdown-item-simple"> <button id="start-date-pd" class="btn btn-dark btn-sm">-</button><span class="centered-label">Giorno</span><button id="start-date-nd" class="btn btn-dark btn-sm">+</button> </div>
                            <div class="dropdown-item-simple"> <button id="start-date-pm" class="btn btn-dark btn-sm">-</button><span class="centered-label">Mese</span><button id="start-date-nm" class="btn btn-dark btn-sm">+</button> </div>
                            <div class="dropdown-item-simple"> <button id="start-date-pa" class="btn btn-dark btn-sm">-</button><span class="centered-label">Anno</span><button id="start-date-na" class="btn btn-dark btn-sm">+</button> </div>
                        </div>
                    </div>
                    <input type="text" class="form-control masked-input" id="date-start" placeholder="GG/MM/AAAA HH:mm">
                </div>
                <div class="input-group group-buttons">
                    <div class="input-group-prepend" id="end-date-btns">
                        <button class="btn btn-secondary dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"><i class="mdi mdi-calendar-multiple"></i></button>
                        <div class="dropdown-menu">
                            <a class="dropdown-item" id="end-date-today" href="#">Oggi</a>
                            <div role="separator" class="dropdown-divider"></div>
                            <a class="dropdown-item" id="end-date-copy" href="#">Copia data inizio</a>
                            <div role="separator" class="dropdown-divider"></div>
                            <a class="dropdown-item" id="end-date-ldm" href="#">Ultimo gg mese</a>
                            <a class="dropdown-item" id="end-date-ldy" href="#">Ultimo gg anno</a>
                            <div role="separator" class="dropdown-divider"></div>
                            <div class="dropdown-item-simple"> <button id="end-date-pd" class="btn btn-dark btn-sm">-</button><span class="centered-label">Giorno</span><button id="end-date-nd" class="btn btn-dark btn-sm">+</button> </div>
                            <div class="dropdown-item-simple"> <button id="end-date-pm" class="btn btn-dark btn-sm">-</button><span class="centered-label">Mese</span><button id="end-date-nm" class="btn btn-dark btn-sm">+</button> </div>
                            <div class="dropdown-item-simple"> <button id="end-date-pa" class="btn btn-dark btn-sm">-</button><span class="centered-label">Anno</span><button id="end-date-na" class="btn btn-dark btn-sm">+</button> </div>
                        </div>
                    </div>
                    <input type="text" class="form-control masked-input" id="date-end" placeholder="GG/MM/AAAA HH:mm">
                </div>
                <select class="form-control disabled-windrose" id="time-period">
                    <optgroup label="Serie storica">
                        <% foreach my $aggregation (@{$aggregations}){

                            my $class = '';
                            my $selected = '';
                            if( $aggregation->{'app_aggregation_default'} == 1){
                                $class = 'def';
                                $selected = 'selected';
                            }
                        %>
                            <option class="<%= $class %>" value="<%=$aggregation->{'app_aggregation_label'} %>" <%= $selected %> ><%=$aggregation->{'app_aggregation_desc'} %></option>
                        % }
                    </optgroup>
                    <optgroup label="Serie categorizzata">
                        <option class="disabled-peryear" value="rep_day">Giorno tipo</option>
                        <option class="disabled-peryear" value="rep_week">Settimana tipo</option>
                        <option class="disabled-peryear" value="rep_year">Anno tipo</option>
                    </optgroup>
                </select>
                <span class="btn btn-circle-mini" data-toggle="tooltip" data-html="true" data-placement="top" data-custom-class="custom-tooltip" data-title="<i class='fa-solid fa-bell fa-shake'></i> Novità (Beta testing)" style="margin-left: -14px"><i class="fa-solid fa-sparkle"></i></span>
                <button id="update-data" type="button" class="btn btn-secondary" data-toggle="tooltip" data-placement="top" title="Aggiorna i tab sulla base delle date e della fascia temporale richiesta">
                    <i class="icon-refresh"></i> Aggiorna
                </button>
            </div>

            <span class="btn button-divider"></span>

            <!-- <div class="btn-group" role="group">
                <button id="btnGroupDrop1" type="button" class="btn btn-secondary dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                Nuovo
                </button>
                <div class="dropdown-menu" aria-labelledby="btnGroupDrop1">
                    <a class="dropdown-item" id="add-tab-chart" href="#">Grafico</a>
                    <a class="dropdown-item" id="add-tab-table" href="#">Tabella</a>
                </div>
            </div> -->
            <div class="btn-set" id="btnset-tab">
                <div class="btn-group mr-1" role="group">
                    <button id="btnGroupDrop3" type="button" class="btn btn-primary dropdown-toggle disabled-table disabled-windrose disabled-multi" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-toggle-second="tooltip" data-placement="left" title="Modifica il tipo di grafico da visualizzare nel tab">
                    Tipo grafico
                    </button>
                    <div class="dropdown-menu" aria-labelledby="btnGroupDrop3" id="typechart">
                        <a class="dropdown-item" data-type="line" href="#"><i class="ti-pulse"></i> Linea</a>
                        <a class="dropdown-item" data-type="line_marker" href="#"><i class="icon-graph"></i> Linea con punti</a>
                        <a class="dropdown-item" data-type="point" href="#"><i class="ti-more"></i> Punti</a>
                        <a class="dropdown-item" data-type="column" href="#"><i class="ti-bar-chart"></i> Barre</a>
                        <a class="dropdown-item" data-type="area" href="#"><i class="ti-pie-chart"></i> Area</a>
                    </div>
                </div>
                <div class="btn-group" role="group">
                    <button id="btnGroupDrop3" type="button" class="btn btn-primary dropdown-toggle disabled-windrose disabled-multi" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-toggle-second="tooltip" data-placement="left" title="Modifica il tipo di trattamento applicato ai parametri">
                    Trattamento
                    </button>
                    <div class="dropdown-menu" aria-labelledby="btnGroupDrop3" id="treatment">
                        % foreach my $treatment (@{$treatments}){
                            <a class="dropdown-item" data-type="<%= $treatment->{'treatment_id'} %>" href="#"> <%= $treatment->{'treatment_name'} %></a>
                            <!-- <option value="<%= $treatment->{'treatment_id'} %>"><%= $treatment->{'treatment_name'} %></option> -->
                        % }
                    </div>
                </div>
            </div>

            <span class="btn button-divider"></span>

            <div class="btn-set" id="btnset-tab">
                <button id="add-tab-chart" type="button" class="btn btn-primary mr-1 disabled-windrose" data-toggle="tooltip" data-placement="top" title="Aggiungi tab per grafico">
                    <i class="icon-plus"></i> Grafico
                </button>
                <button id="add-tab-table" type="button" class="btn btn-primary mr-1 disabled-windrose" data-toggle="tooltip" data-placement="top" title="Aggiungi tab per tabella">
                    <i class="icon-plus"></i> Tabella
                </button>
                <div class="btn-group" role="group">
                    <button id="btnGroupDrop2" type="button" class="btn btn-danger dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-toggle-second="tooltip" data-placement="right" title="Resetta i tab (svuota)">
                    Reset
                    </button>
                    <div class="dropdown-menu" aria-labelledby="btnGroupDrop2">
                        <a class="dropdown-item" id="reset-active-tab" href="#">Tab attivo</a>
                        <a class="dropdown-item" id="reset-all-tabs" href="#">Tutti i tab</a>
                    </div>
                </div>
            </div>

            <span class="btn button-divider"></span>

            <div class="btn-set" id="btnset-advanced">
                <button type="button" class="btn btn-success mr-1" id="jq-code" data-toggle-second="tooltip" data-placement="top" title="Ottieni il codice di macro e query attive" data-target="#get-code" data-toggle="modal"><i class="fa fa-code"></i> Query</button>
            </div>
            <div class="btn-set">
                <button type="button" class="btn btn-success mr-1" data-toggle-second="tooltip" data-placement="top" data-original-title="Visualizza elenco dei codici di validazione" data-target="#validation-codes" data-toggle="modal"><i class="mdi mdi-json"></i> Validaz.</button>
            </div>
            <div class="btn-set">
                <button type="button" class="btn btn-danger" id="boost-info" data-toggle-second="tooltip" data-placement="top" data-original-title="Visualizza dettaglio impostazioni Boost" data-target="#get-boost-info" data-toggle="modal"><i class="icon-rocket"></i> Boost</button>
            </div>


            <!-- <span class="btn button-divider"></span>

            <button type="button" class="btn btn-info" data-toggle="tooltip" data-placement="top" title="Informazioni su Analyser"><i class="icon-info"></i></button> -->
        </div>
        <div class="analyser-buttons clearfix">
            <div class="btn-set" id="btnset-limit">
                <div class="input-group group-buttons-little">
                    <div class="input-group-prepend">
                        <button class="btn btn-primary disabled-table disabled-multi" type="button" data-toggle="tooltip" data-placement="top" title="range MINIMO limite grafico"><i class="ti-download"></i></button>
                    </div>
                    <input type="number" class="form-control masked-input input-success disabled-table disabled-multi" id="range-min" placeholder="min">
                </div>
                <div class="input-group group-buttons-little">
                    <div class="input-group-prepend">
                        <button class="btn btn-primary disabled-table disabled-multi" type="button" data-toggle="tooltip" data-placement="top" title="range MASSIMO limite grafico"><i class="ti-upload"></i></button>
                    </div>
                    <input type="number" class="form-control masked-input input-success disabled-table disabled-multi" id="range-max" placeholder="max">
                </div>
                <button id="update-yaxis" type="button" class="btn btn-primary disabled-table disabled-multi" data-toggle="tooltip" data-placement="top" title="Aggiorna i Grafici sulla base dei range min e max richiesti">
                    <i class="ti-angle-double-right"></i> Cambia
                </button>
                <button id="add-wind-scale" type="button" class="btn btn-primary disabled-table disabled-windrose disabled-multi disabled-peryear ml-1" data-toggle="tooltip" data-placement="top" title="Aggiungi scala vento al grafico">
                    <i class="mdi mdi-weather-windy"></i> Scala vento
                </button>
            </div>

            <div class="btn-group ml-1 mt-1" role="group">
                <button id="btnGroupAxis" type="button" class="btn btn-primary dropdown-toggle disabled-table disabled-windrose disabled-multi disabled-peryear" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-toggle-second="tooltip" data-placement="left" title="Cambia il numero degli assi verticali">
                    <i class="fa-light fa-arrow-down-up-across-line"></i> Asse Y
                </button>
                <div class="dropdown-menu" aria-labelledby="btnGroupDrop1" id="update-num-yaxis">
                    <a class="dropdown-item" data-type="single" data-num="1" href="#"><i class="fa-light fa-tally-1"></i> Uno</a>
                    <a class="dropdown-item" data-type="single" data-num="2" href="#"><i class="fa-light fa-tally-2"></i> Due</a>
                    <a class="dropdown-item" data-type="single" data-num="3" href="#"><i class="fa-light fa-tally-3"></i> Tre</a>
                    <div role="separator" class="dropdown-divider"></div>
                    <a class="dropdown-item" data-type="multi" data-num="1" href="#"><i class="fa-light fa-bars-staggered"></i> Multipli</a>
                </div>
            </div>

            <span class="btn button-divider"></span>

            <div class="btn-set" id="btnset-draw">
                <button id="add-note" type="button" class="btn btn-info mr-1 disabled-table disabled-multi" data-toggle="tooltip" data-placement="top" title="Aggiungi una nota al grafico">
                    <i class="icon-note"></i> Nota
                </button>
                <button id="add-line" type="button" class="btn btn-info mr-1 disabled-table disabled-multi" data-toggle="tooltip" data-placement="top" title="Aggiungi un asse orizzontale al grafico">
                    <i class="ti-layout-line-solid"></i> Linea
                </button>
                <button id="clear-chart" type="button" class="btn btn-danger disabled-table disabled-multi" data-toggle="tooltip" data-placement="top" title="Elimina note e linee dal grafico">
                    <i class="ti-trash"></i>
                </button>
            </div>

            <span class="btn button-divider"></span>
            <div class="btn-set">
                <div class="btn-group" role="group">
                    <button id="btnGroupZoomType" type="button" class="btn btn-secondary dropdown-toggle disabled-table disabled-windrose disabled-multi" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-toggle-second="tooltip" data-placement="left" title="Seleziona il tipo di zoom voluto sul grafico">
                        <i class="fal fa-arrows-up-down-left-right" id="icon-zoom"></i> Zoom
                    </button>
                    <div class="dropdown-menu" aria-labelledby="btnGroupDrop3" id="change-zoom">
                        <a class="dropdown-item sel" data-type="xy" href="#"><i class="fal fa-arrows-up-down-left-right"></i> Zoom Assi X e Y</a>
                        <div role="separator" class="dropdown-divider"></div>
                        <a class="dropdown-item" data-type="x" href="#"><i class="fal fa-arrows-left-right"></i> Zoom Asse X</a>
                        <a class="dropdown-item" data-type="y" href="#"><i class="fal fa-arrows-up-down"></i> Zoom Asse Y</a>
                    </div>
                </div>
                <label class="btn btn-secondary ml-1 disabled-table-opacity disabled-windrose-opacity disabled-multi-opacity" data-toggle-second="tooltip" data-placement="left" title="Ripartisce i dati sugli anni selezionati">
                    <input class="disabled-table disabled-windrose disabled-multi" name="chart-per-year" id="chart-per-year" type="checkbox" autocomplete="off"> Grafico per anno
                </label>
                <span class="btn btn-circle-mini" data-toggle="tooltip" data-html="true" data-placement="top" data-custom-class="custom-tooltip" data-title="<i class='fa-solid fa-bell fa-shake'></i> Novità (Beta testing)"><i class="fa-solid fa-sparkle"></i></span>
            </div>
            <!-- <div class="btn-set"> -->
                <!-- <label class="switch">
                    <input class="disabled-table disabled-windrose disabled-multi" type="checkbox" name="chart-per-year" id="chart-per-year">
                    <span class="slider round"></span>
                </label>
                <strong>Grafico per anno</strong> -->
            <!-- </div> -->

            <span class="btn button-divider"></span>

            <div class="btn-set" id="btnset-download">
                <button id="download-image" type="button" class="btn btn-success mr-1 disabled-table disabled-multi" data-toggle="tooltip" data-placement="top" title="Scarica immagine in .png">
                    <i class="ti-download"></i> Grafico
                </button>

                <div class="btn-group ml-1 mt-0 mr-1" role="group">
                    <button id="btnGroupCSV" type="button" class="btn btn-success dropdown-toggle disabled-multi" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-toggle-second="tooltip" data-placement="left" title="Scarica dati CSV nel modo che preferisci">
                    <i class="ti-download"></i> CSV
                    </button>
                    <div class="dropdown-menu" aria-labelledby="btnGroupCSV">
                        <a class="dropdown-item" data-type="window" href="#" id="download-csv"> Dati finestra corrente</a>
                        <a class="dropdown-item disabled-peryear" data-type="server" href="#" id="download-from-server"> Dati dal server</a>
                    </div>
                </div>

                <!-- OLD CSV BUTTONS STYLES
                    <button id="download-csv" type="button" class="btn btn-primary disabled-multi mr-1" data-toggle="tooltip" data-placement="top" title="Scarica i dati in .csv">
                        <i class="ti-download"></i> CSV
                    </button>
                    <button id="download-from-server" type="button" class="btn btn-secondary" data-toggle="tooltip" data-placement="top" title="Scarica un CSV direttamente da server sulla base delle date e della fascia temporale richiesta">
                        <i class="icon-cloud-download"></i> CSV da server
                    </button>
                -->

            </div>
            <span class="btn button-divider"></span>
            <button id="keyboard-info" type="button" class="btn btn-danger clipboard-hide rounded-circle mr-1 mt-1 circle-tool" data-toggle-second="tooltip" data-placement="top" data-original-title="Informazioni sull'utilizzo delle scorciatoie da tastiera" data-target="#keyboard-shortcuts-info" data-toggle="modal">
                <i class="icon-info"></i>
            </button>

        </div>
    </div>
</div>

<!-- MODAL IMPOSTAZIONI -->
<div class="modal fade" id="settings-analyser" tabindex="-1" role="dialog" aria-labelledby="settings-analyser" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">Opzioni degli strumenti</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row no-gutters">
                    <div class="col-sm-3">
                        <div class="nav flex-column nav-pills nav-settings" id="settings-tab" role="tablist" aria-orientation="vertical">
                            <a class="nav-link active" data-toggle="pill" href="#tab-generali" role="tab"  aria-selected="true"><i class="fa fa-cogs" aria-hidden="true"></i> Generali</a>
                            <a class="nav-link" data-toggle="pill" href="#tab-grafici" role="tab"  aria-selected="false"><i class="fa-solid fa-chart-pie"></i> Grafici &raquo; Generiche </a>
                            <a class="nav-link" data-toggle="pill" href="#tab-grafici-dim" role="tab"  aria-selected="false"><i class="fa-solid fa-table-cells"></i> Grafici &raquo; Layout</a>
                            <a class="nav-link" data-toggle="pill" href="#tab-tabelle" role="tab" aria-selected="false"><i class="fa fa-th-large" aria-hidden="true"></i> Tabelle</a>
                            <a class="nav-link" data-toggle="pill" href="#tab-filtri" role="tab" aria-selected="false"><i class="fa fa-filter" aria-hidden="true"></i> Filtri</a>
                        </div>
                    </div>
                    <div class="col-sm-9">
                        <div class="tab-content tab-settings" id="settings-tab-content">
                            <div class="tab-pane fade show active" id="tab-generali" role="tabpanel">

                                <h4>Generali</h4>
                                <div class="row no-gutters" id="settings-forms">

                                    <form class="form-horizontal">
                                        <h5>Lista delle stazioni</h5>
                                        <div class="form-group row">
                                            <label for="visible-stid" class="col-sm-4 col-form-label">Visualizza ID</label>
                                            <div class="col-sm-8 pt-1">
                                                <label class="switch">
                                                    <input type="checkbox" name="visible-stid" id="visible-stid">
                                                    <span class="slider round"></span>
                                                </label>
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label for="visible-altitude" class="col-sm-4 col-form-label">Visualizza QUOTA</label>
                                            <div class="col-sm-8 pt-1">
                                                <label class="switch">
                                                    <input type="checkbox" name="visible-altitude" id="visible-altitude">
                                                    <span class="slider round"></span>
                                                </label>
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label for="visible-limit-value" class="col-sm-4 col-form-label">Visualizza valore LIMITI</label>
                                            <div class="col-sm-8 pt-1">
                                                <label class="switch">
                                                    <input type="checkbox" name="visible-limit-value" id="visible-limit-value">
                                                    <span class="slider round"></span>
                                                </label>
                                            </div>
                                        </div>

                                        <h5>Lista delle macro</h5>
                                        <div class="form-group row">
                                            <label for="visible-params" class="col-sm-4 col-form-label">Visualizza parametri</label>
                                            <div class="col-sm-8 pt-1">
                                                <label class="switch">
                                                    <input type="checkbox" name="visible-params" id="visible-params">
                                                    <span class="slider round"></span>
                                                </label>
                                            </div>
                                        </div>

                                        <h5>Estrazione dati</h5>
                                        <div class="form-group row">
                                            <label for="date-format" class="col-sm-4 col-form-label">Formato data</label>
                                            <div class="col-sm-8">
                                                <select class="form-control clear-macro" id="date-format" name="date-format">
                                                    <option value="standard">Default</option>
                                                    <option value="basic">07/05/1991</option>
                                                    <option value="basic_range">07/05/1991 00 a 01</option>
                                                    <option value="basic_rangeMin">07/05/1991 00:00 a 01:00</option>
                                                    <option value="basic_timeStart">07/05/1991 00 [00-23]</option>
                                                    <option value="basic_timeStartMin">07/05/1991 00:00 [00-23]</option>
                                                    <option value="basic_timeEnd">07/05/1991 01 [01-24]</option>
                                                    <option value="basic_timeEndMin">07/05/1991 01:00 [01-24]</option>
                                                    <option value="text">7 maggio 1991</option>
                                                    <option value="text_range">7 maggio 1991 00 a 01</option>
                                                    <option value="text_rangeMin">7 maggio 1991 00:00 a 01:00</option>
                                                    <option value="text_timeStart">7 maggio 1991 00 [00-23]</option>
                                                    <option value="text_timeStartMin">7 maggio 1991 00:00 [00-23]</option>
                                                    <option value="text_timeEnd">7 maggio 1991 01 [01-24]</option>
                                                    <option value="text_timeEndMin">7 maggio 1991 01:00 [01-24]</option>
                                                </select>
                                                <span class="legend-settings">Seleziona il formato della data visualizzata nei grafici e nelle tabelle</span>
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label for="data-converted" class="col-sm-4 col-form-label">Visualizza dati convertiti</label>
                                            <div class="col-sm-8 pt-1">
                                                <label class="switch">
                                                    <input type="checkbox" name="data-converted" id="data-converted">
                                                    <span class="slider round"></span>
                                                </label>
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label for="visible-treatment" class="col-sm-4 col-form-label">Visualizza trattamento</label>
                                            <div class="col-sm-8 pt-1">
                                                <label class="switch">
                                                    <input type="checkbox" name="visible-treatment" id="visible-treatment">
                                                    <span class="slider round"></span>
                                                </label><br>
                                                <span class="legend-settings">Visualizza trattamento nel nome dei dati estratti</span>
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label for="wind-scale" class="col-sm-4 col-form-label">Scala vento</label>
                                            <div class="col-sm-8">
                                                <select class="form-control clear-macro" id="wind-scale" name="wind-scale">
                                                    % foreach my $scale (@{$scales}){
                                                        <option value="<%= $scale->{ws_id} %>"><%= $scale->{ws_name} %></option>
                                                    % }
                                                </select>
                                                <span class="legend-settings">La scala verrà applicata nella generazione della windrose</span>
                                            </div>
                                        </div>
                                    </form>
                                </div>

                            </div>
                            <div class="tab-pane fade" id="tab-grafici" role="tabpanel">
                                <h4>Grafici &raquo; Generiche</h4>
                                <h5>Visualizzazione dati</h5>
                                <div class="form-group row">
                                    <label for="chart-notes" class="col-sm-4 col-form-label">Recupera note</label>
                                    <div class="col-sm-8 pt-1">
                                        <label class="switch">
                                            <input type="checkbox" name="chart-notes" id="chart-notes">
                                            <span class="slider round"></span>
                                        </label>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <label for="chart-subtitle" class="col-sm-4 col-form-label">Visualizza informazioni nel sottotitolo</label>
                                    <div class="col-sm-8 pt-1">
                                        <label class="switch">
                                            <input type="checkbox" name="chart-subtitle" id="chart-subtitle">
                                            <span class="slider round"></span>
                                        </label>
                                        <br><span class="legend-settings">Visualizza periodo e aggregazione temporale di estrazione dati</span>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <label for="chart-nav" class="col-sm-4 col-form-label">Visualizza navigatore grafico</label>
                                    <div class="col-sm-8 pt-1">
                                        <label class="switch">
                                            <input type="checkbox" name="chart-nav" id="chart-nav">
                                            <span class="slider round"></span>
                                        </label>
                                    </div>
                                </div>
                                <h5>Effetti grafici</h5>
                                <div class="form-group row">
                                    <label for="chart-hover-event" class="col-sm-4 col-form-label">Trasparenze al passaggio del mouse</label>
                                    <div class="col-sm-8 pt-1">
                                        <label class="switch">
                                            <input type="checkbox" name="chart-hover-event" id="chart-hover-event">
                                            <span class="slider round"></span>
                                        </label>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <label for="chart-tooltip-type" class="col-sm-4 col-form-label">Tipologia tooltip</label>
                                    <div class="col-sm-8">
                                        <select class="form-control clear-macro" id="chart-tooltip-type" name="chart-tooltip-type">
                                            <option value="disabled">Disabilitato</option>
                                            <option value="standard">Standard</option>
                                            <option value="shared">Condiviso</option>
                                        </select>
                                        <span class="legend-settings">Seleziona tipo di tooltip visualizzato al passaggio del mouse</span>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <label for="chart-label-x-angle" class="col-sm-4 col-form-label">Angolo etichette asse X</label>
                                    <div class="col-sm-8">
                                        <input type="number" name="chart-label-x-angle" id="chart-label-x-angle" class="form-control clear-macro" min="0" max="90">
                                        <span class="legend-settings">Inserisci un valore tra 0 e 90 (gradi)</span>
                                    </div>
                                </div>
                                <h5>Esportazione immagini</h5>
                                <div class="form-group row">
                                    <label for="chart-title-font" class="col-sm-4 col-form-label">Dimensione immagine esportata</label>
                                    <div class="col-sm-4 sel-left">
                                        <input type="number" name="exp-chart-width" id="exp-chart-width" class="form-control clear-macro" min="600" max="1280">
                                        <span class="legend-settings">Inserisci un valore tra 600 e 1280</span>
                                    </div>
                                    <div class="col-sm-4 sel-right">
                                        <input type="number" name="exp-chart-height" id="exp-chart-height" class="form-control clear-macro" min="400" max="960">
                                        <span class="legend-settings">Inserisci un valore tra 400 e 960</span>
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="tab-grafici-dim" role="tabpanel">
                                <h4>Grafici &raquo; Layout</h4>
                                <h5>Impostazioni aspetto</h5>
                                <div class="form-group row">
                                    <label for="chart-minor-grid" class="col-sm-4 col-form-label">Visualizza griglia fitta</label>
                                    <div class="col-sm-8 pt-1">
                                        <label class="switch">
                                            <input type="checkbox" name="chart-minor-grid" id="chart-minor-grid">
                                            <span class="slider round"></span>
                                        </label>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="offset-sm-4 col-sm-4 sel-left">
                                        <h6 class="text-primary">Grafico</h6>
                                    </div>
                                    <div class="col-sm-4 sel-right">
                                        <h6 class="text-primary">Immagine esportata</h6>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <label for="chart-title-font" class="col-sm-4 col-form-label">Dimensione font titolo</label>
                                    <div class="col-sm-4 sel-left">
                                        <input type="number" name="chart-title-font" id="chart-title-font" class="form-control clear-macro" min="5" max="30">
                                        <span class="legend-settings">Inserisci un valore tra 5 e 30</span>
                                    </div>
                                    <div class="col-sm-4 sel-right">
                                        <input type="number" name="exp-chart-title-font" id="exp-chart-title-font" class="form-control clear-macro" min="5" max="30">
                                        <span class="legend-settings">Inserisci un valore tra 5 e 30</span>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <label for="chart-label-font" class="col-sm-4 col-form-label">Dimensione font etichette</label>
                                    <div class="col-sm-4 sel-left">
                                        <input type="number" name="chart-label-font" id="chart-label-font" class="form-control clear-macro" min="5" max="30" >
                                        <span class="legend-settings">Inserisci un valore tra 5 e 30</span>
                                    </div>
                                    <div class="col-sm-4 sel-right">
                                        <input type="number" name="exp-chart-label-font" id="exp-chart-label-font" class="form-control clear-macro" min="5" max="30">
                                        <span class="legend-settings">Inserisci un valore tra 5 e 30</span>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <label for="chart-legend-font" class="col-sm-4 col-form-label">Dimensione font legenda</label>
                                    <div class="col-sm-4 sel-left">
                                        <input type="number" name="chart-legend-font" id="chart-legend-font" class="form-control clear-macro" min="5" max="30">
                                        <span class="legend-settings">Inserisci un valore tra 5 e 30</span>
                                    </div>
                                    <div class="col-sm-4 sel-right">
                                        <input type="number" name="exp-chart-legend-font" id="exp-chart-legend-font" class="form-control clear-macro" min="5" max="30">
                                        <span class="legend-settings">Inserisci un valore tra 5 e 30</span>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <label for="chart-num-label" class="col-sm-4 col-form-label">Num. etichette asse X</label>
                                    <div class="col-sm-4 sel-left">
                                        <input type="number" name="chart-num-label" id="chart-num-label" class="form-control clear-macro" min="5" max="20">
                                        <span class="legend-settings">Inserisci un valore tra 5 e 20</span>
                                    </div>
                                    <div class="col-sm-4 sel-right">
                                        <input type="number" name="exp-chart-num-label" id="exp-chart-num-label" class="form-control clear-macro" min="5" max="20">
                                        <span class="legend-settings">Inserisci un valore tra 5 e 20</span>
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="tab-tabelle" role="tabpanel">
                                <h4>Tabelle</h4>
                                <!-- <h5>Nessuna opzione</h5>
                                Al momento non è possibile modificare le impostazioni -->
                                <h5>Layout</h5>
                                <div class="form-group row">
                                    <label for="table-codes" class="col-sm-4 col-form-label">Visualizza codici</label>
                                    <div class="col-sm-8 pt-1">
                                        <label class="switch">
                                            <input type="checkbox" name="table-codes" id="table-codes">
                                            <span class="slider round"></span>
                                        </label><br>
                                        <span class="legend-settings">I codici verranno disabilitati se presenti più di 15 parametri</span>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <label for="table-filters" class="col-sm-4 col-form-label">Visualizza filtri</label>
                                    <div class="col-sm-8 pt-1">
                                        <label class="switch">
                                            <input type="checkbox" name="table-filters" id="table-filters">
                                            <span class="slider round"></span>
                                        </label><br>
                                        <span class="legend-settings">Abilita filtri di visualizzazione</span>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <label for="table-calc" class="col-sm-4 col-form-label">Calcoli per colonna</label>
                                    <div class="col-sm-8 pt-1">
                                        <label class="switch">
                                            <input type="checkbox" name="table-calc" id="table-calc">
                                            <span class="slider round"></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="tab-filtri" role="tabpanel">
                                <h4>Filtri</h4>
                                <h5>Nessuna opzione</h5>
                                Al momento non è possibile modificare le impostazioni
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" id="reset-settings"><i class="ti-back-left"></i> Resetta impostazioni</button>
                <button type="button" class="btn btn-secondary" id="apply-settings"><i class="mdi mdi-check-all"></i> Applica in locale</button>
                <button type="button" class="btn btn-primary" id="save-settings"><i class="ti-save-alt"></i> Salva nel DB</button>
                <button type="button" class="btn btn-link" data-dismiss="modal" id="dismiss-settings"><i class="ti-close"></i> Chiudi</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL COPERTURA DATI -->
<div class="modal fade" id="dati-copertura" tabindex="-1" role="dialog" aria-labelledby="dati-copertura" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">Modifica % copertura</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form class="form-inline">
                    <div class="form-group mx-sm-1 mb-2">
                        <label for="percent-data">Percentuale</label>
                        <input type="text" class="form-control ml-2" id="percent-data" placeholder="Percentuale dati" value="75">
                    </div>
                    <button id ="percent-data-confirm" type="button" class="btn btn-primary mb-2">Conferma</button>
                    <button data-val="0"  type="button" class="btn btn-danger ml-4 mb-2 percent-data-value">0%</button>
                    <button data-val="75" type="button" class="btn btn-danger ml-2 mb-2 percent-data-value">75%</button>
                    <button type="button" class="btn btn-secondary mb-2 ml-4" data-dismiss="modal">Chiudi</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- MODAL IMPOSTAZIONI MACRO -->
<div class="modal fade" id="settings-macro" tabindex="-1" role="dialog" aria-labelledby="settings-macro" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="settings-macro-title">Modifica Macro</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row no-gutters">
                    <div class="col-sm-3">
                        <div class="nav flex-column nav-pills nav-settings" id="macro-tab" role="tablist" aria-orientation="vertical">
                            <a class="nav-link active" data-toggle="pill" href="#macro-generali" role="tab"  aria-selected="true"><i class="fa fa-cogs" aria-hidden="true"></i> Generali</a>
                            <a class="nav-link" data-toggle="pill" href="#macro-parametri" role="tab"  aria-selected="false"><i class="mdi mdi-tower-beach"></i> Parametri</a>
                        </div>
                    </div>
                    <div class="col-sm-9">
                        <div class="tab-content tab-settings" id="macro-tab-content">
                            <div class="tab-pane fade show active" id="macro-generali" role="tabpanel">

                                <h4>Generali</h4>
                                <div class="row no-gutters" id="main-macro-form">

                                    <form class="form-horizontal">
                                        <div class="form-group row">
                                            <label for="macro-category" class="col-sm-3 col-form-label">Categoria</label>
                                            <div class="col-sm-9">
                                                <select class="form-control clear-macro" id="macro-category" name="macro-category">
                                                </select>
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label for="macro-name" class="col-sm-3 col-form-label">Nome</label>
                                            <div class="col-sm-9">
                                                <input type="text" class="form-control clear-macro" id="macro-name" name="macro-name" placeholder="Nome">
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label for="macro-desc" class="col-sm-3 col-form-label">Descrizione</label>
                                            <div class="col-sm-9">
                                                <textarea rows="3" class="form-control clear-macro" id="macro-desc" name="macro-desc" placeholder="Descrizione"></textarea>
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label for="macro-integration" class="col-sm-3 col-form-label">Aggregazione</label>
                                            <div class="col-sm-9">
                                                <select class="form-control clear-macro" id="macro-aggregation" name="macro-aggregation">
                                                    <optgroup label="Serie storica">
                                                        % foreach my $aggregation (@{$aggregations}){
                                                            <option value="<%=$aggregation->{'app_aggregation_label'} %>"><%=$aggregation->{'app_aggregation_desc'} %></option>
                                                        % }
                                                    </optgroup>
                                                    <optgroup label="Serie categorizzata">
                                                        <option class="disabled-peryear" value="rep_day">Giorno tipo</option>
                                                        <option class="disabled-peryear" value="rep_week">Settimana tipo</option>
                                                        <option class="disabled-peryear" value="rep_year">Anno tipo</option>
                                                    </optgroup>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label for="macro-valid-data" class="col-sm-3 col-form-label">% dati validi</label>
                                            <div class="col-sm-9">
                                                <input type="number" class="form-control clear-macro" id="macro-valid-data" name="macro-valid-data" placeholder="Numero da 1 a 100" min="1" max="100">
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label for="macro-validity-operator" class="col-sm-3 col-form-label">Cod. validità</label>
                                            <div class="col-sm-2 sel-left">
                                                <select class="form-control clear-macro" id="macro-validity-operator" name="macro-validity-operator">
                                                    <option value="<="><=</option>
                                                    <option value="=">=</option>
                                                    <option class="default-val" value=">=">>=</option>
                                                </select>
                                            </div>
                                            <div class="col-sm-7 sel-right">
                                                <select class="form-control clear-macro" id="single-validity-code" class="macro-validity-code" name="macro-validity-code">
                                                    <option value="">Tutti i dati</option>
                                                    <%  foreach my $val_code (@{$val_codes}){
                                                        if($val_code->{uvc_code_default} == 1){ %>
                                                            <option class="default-val" value="<%=$val_code->{uvc_code_id} %>"><%= $val_code->{uvc_code_formatted} %></option>
                                                        % } else {
                                                            <option value="<%=$val_code->{uvc_code_id} %>"><%= $val_code->{uvc_code_formatted} %></option>
                                                        <% }
                                                    } %>
                                                </select>
                                                <select class="form-control clear-macro select2 select2-multiple" id="multiple-validity-code" class="macro-validity-code" name="macro-validity-code" multiple>
                                                    <%  foreach my $val_code (@{$val_codes}){
                                                        if($val_code->{uvc_code_default} == 1){ %>
                                                            <option class="default-val" value="<%=$val_code->{uvc_code_id} %>"><%= $val_code->{uvc_code_formatted} %></option>
                                                        % } else {
                                                            <option value="<%=$val_code->{uvc_code_id} %>"><%= $val_code->{uvc_code_formatted} %></option>
                                                        <% }
                                                    } %>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label for="macro-label-yaxis" class="col-sm-3 col-form-label">Etichetta asse Y</label>
                                            <div class="col-sm-6 sel-left">
                                                <input type="text" class="form-control clear-macro" id="macro-label-yaxis" name="macro-label-yaxis" placeholder="Etichetta asseY">
                                            </div>
                                            <div class="col-sm-3 sel-right">
                                                <input type="button" class="btn btn-success" name="add-cr-1" id="add-cr-1" value="&mu;" data-toggle="tooltip" data-placement="top" title="Aggiungi carattere: &mu;">
                                                <input type="button" class="btn btn-success" name="add-cr-2" id="add-cr-2" value="&sup2;" data-toggle="tooltip" data-placement="top" title="Aggiungi carattere: &sup2;">
                                                <input type="button" class="btn btn-success" name="add-cr-3" id="add-cr-3" value="&sup3;" data-toggle="tooltip" data-placement="top" title="Aggiungi carattere: &sup3;">
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label for="macro-label-y-step" class="col-sm-3 col-form-label">Step asse Y</label>
                                            <div class="col-sm-8">
                                                <input type="number" name="macro-label-y-step" id="macro-label-y-step" class="form-control clear-macro" step="0.1" min="0" placeholder="Step asseY">
                                                <span class="legend-settings">Inserisci un valore nell'unità di misura dell'asse (solo per asse principale)</span>
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label for="macro-num-yaxis" class="col-sm-3 col-form-label">Numero assi Y</label>
                                            <div class="col-sm-9">
                                                <input type="number" name="macro-num-yaxis" id="macro-num-yaxis" class="form-control clear-macro" min="1" max="3">
                                                <span class="legend-settings">Inserisci un valore tra 1 e 3</span>
                                            </div>
                                        </div>
                                    </form>
                                </div>

                            </div>
                            <div class="tab-pane fade" id="macro-parametri" role="tabpanel">
                                <h4>Parametri</h4>
                                <div class="row no-gutters" id="parameters-macro-form">

                                    <form class="form-horizontal">
                                        <h5>Seleziona parametro da modificare</h5>
                                        <div class="form-group row">
                                            <label for="macro-param-main" class="col-sm-3 col-form-label">Parametro</label>
                                            <div class="col-sm-9">
                                                <select class="form-control clear-macro" id="macro-param-main" name="macro-param-main">
                                                    <option value="-1">Seleziona...</option>

                                                </select>
                                            </div>
                                        </div>
                                        <div id="macro-param-details">
                                            <h5 class="mt-4">Modifica: <span></span></h5>
                                            <div class="form-group row">
                                                <label for="macro-param-name" class="col-sm-3 col-form-label">Nome</label>
                                                <div class="col-sm-9">
                                                    <input disabled type="text" class="form-control clear-macro" id="macro-param-name" name="macro-param-name" placeholder="Nome">
                                                </div>
                                            </div>
                                            <div class="form-group row">
                                                <label for="macro-param-legend" class="col-sm-3 col-form-label">Legenda</label>
                                                <div class="col-sm-9">
                                                    <input type="text" class="form-control clear-macro" id="macro-param-legend" name="macro-param-legend" placeholder="Legenda">
                                                </div>
                                            </div>
                                            <hr>
                                            <div class="form-group row">
                                                <label for="macro-param-formule" class="col-sm-3 col-form-label">Formula</label>
                                                <div class="col-sm-9">
                                                    <input type="text" class="form-control clear-macro" id="macro-param-formule" name="macro-param-formule" placeholder="Formula">
                                                </div>
                                            </div>
                                            <div class="form-group row">
                                                <label for="macro-param-decimal" class="col-sm-3 col-form-label">Decimali</label>
                                                <div class="col-sm-9">
                                                    <input type="number" class="form-control clear-macro" id="macro-param-decimal" name="macro-param-decimal" placeholder="Decimali dopo la virgola">
                                                </div>
                                            </div>
                                            <!-- <div class="form-group row">
                                                <label for="macro-param-unit" class="col-sm-3 col-form-label">Unità di misura</label>
                                                <div class="col-sm-9">
                                                    <input type="text" class="form-control clear-macro" id="macro-param-unit" name="macro-param-unit" placeholder="Unità di misura">
                                                </div>
                                            </div> -->
                                            <div class="form-group row">
                                                <label for="macro-param-treatment" class="col-sm-3 col-form-label">Trattamento</label>
                                                <div class="col-sm-9">
                                                    <select class="form-control clear-macro" id="macro-param-treatment" name="macro-param-treatment">
                                                        <option value="-1">Seleziona...</option>
                                                        % foreach my $treatment (@{$treatments}){
                                                            <option value="<%= $treatment->{'treatment_id'} %>"><%= $treatment->{'treatment_name'} %></option>
                                                        % }
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="form-group row" id="hide-moving-average">
                                                <label for="macro-param-moving-window" class="col-sm-5 col-form-label">Finestra media mobile</label>
                                                <div class="col-sm-7">
                                                    <input type="number" class="form-control clear-macro" id="macro-param-moving-window" name="macro-param-moving-window" min="2" max="10" placeholder="Finestra media mobile">
                                                </div>
                                            </div>
                                            <hr>
                                            <div class="form-group row">
                                                <label for="macro-param-chartype" class="col-sm-3 col-form-label">Tipo grafico</label>
                                                <div class="col-sm-9">
                                                    <select class="form-control clear-macro" id="macro-param-chartype" name="macro-param-chartype">
                                                        <option value="-1">Seleziona...</option>
                                                        <option value="line">Linea</option>
                                                        <option value="line_marker">Linea con punti</option>
                                                        <option value="column">Colonne</option>
                                                        <option value="point">Punti</option>
                                                        <option value="area">Area</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <!-- http://jscolor.com/examples/ -->
                                            <div class="form-group row">
                                                <label for="macro-param-chartcolor" class="col-sm-3 col-form-label">Colore linea</label>
                                                <div class="col-sm-9">
                                                    <input type="text" class="form-control" data-jscolor="{width:101, padding:0, shadow:false, borderWidth:0, backgroundColor:'transparent', controlBorderColor:'#ccc', hash:true}" id="macro-param-chartcolor" name="macro-param-chartcolor" placeholder="GRAFICO: colore linea" value="">
                                                </div>
                                            </div>

                                            <!-- https://rangeslider.js.org/ -->
                                            <div class="form-group row">
                                                <label for="macro-param-charline" class="col-sm-3 col-form-label">Spessore linea</label>
                                                <div class="col-sm-9">

                                                    <input type="range" min="1" max="5" step="1" class="form-control" id="macro-param-charline" name="macro-param-charline" placeholder="Spessore linea">
                                                </div>
                                            </div>
                                            <div class="form-group row">
                                                <label for="macro-param-axis" class="col-sm-3 col-form-label">Asse</label>
                                                <div class="col-sm-9">
                                                    <input type="number" min="1" class="form-control clear-macro" id="macro-param-axis" name="macro-param-axis" placeholder="Asse a cui associare il parametro" disabled>
                                                </div>
                                            </div>
                                            <hr>
                                            <div class="form-group row">
                                                <div class="col-md-9 offset-md-3">
                                                    <button type="button" class="btn btn-danger del-param"><i class="ti-trash"></i> Elimina parametro</button>
                                                </div>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="apply-macro"><i class="mdi mdi-check-all"></i> Applica in locale</button>
                % if ($user_grants->{user_insert} && $user_grants->{user_update}){
                <button type="button" class="btn btn-primary save-macro"><i class="ti-save-alt"></i> Salva nel DB</button>
                % }
                <button type="button" class="btn btn-link" data-dismiss="modal" id="dismiss-macro"><i class="ti-close"></i> Chiudi</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL CATEGORIE MACRO -->
<div class="modal fade" id="category-macro" tabindex="-1" role="dialog" aria-labelledby="category-macro" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="settings-macro-title">Categorie Macro</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body one-tab-modal">
                <h4>Categorie esistenti</h4>
                <table id="categories-table" class="table table-sm table-striped">
                    <thead>
                        <tr>
                            <th scope="col"></th>
                            <th scope="col">Nome</th>
                            <th scope="col">Pubblico</th>
                            <th scope="col">Gruppi associati</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
                % if ($user_grants->{user_insert} && $user_grants->{user_update}){
                <h4>Aggiungi categoria</h4>
                <form class="form-horizontal" id="new-category">
                    <input type="hidden" name="new-cat-id" id="new-cat-id" value="">
                    <div class="form-group row">
                        <label for="new-cat-name" class="col-sm-3 col-form-label">Nome</label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control clear-macro" id="new-cat-name" name="new-cat-name" placeholder="Nome...">
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="new-cat-public" class="col-sm-3 col-form-label">Pubblico</label>
                        <div class="col-sm-9">
                            <label class="switch">
                                <input type="checkbox" name="new-cat-public" id="new-cat-public">
                                <span class="slider round"></span>
                            </label>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="new-cat-groups" class="col-sm-3 col-form-label">Gruppi associati</label>
                        <div class="col-sm-9">
                            <select class="select2 m-b-10 select2-multiple" id="new-cat-groups" name="new-cat-groups" style="width: 100%" multiple="multiple" data-placeholder="Seleziona...">
                                % foreach my $portal_group (@{$portal_groups_list}){
                                    <option value="<%=$portal_group->{'gr_id'} %>"><%=$portal_group->{'gr_name'} %></option>
                                % }
                            </select>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-sm-9 offset-sm-3">
                            <div class="bording"></div>
                            <button type="submit" name="save-cat" id="save-cat" class="btn btn-primary"><i class="ti-save-alt"></i> Aggiungi</button>
                            <button type="button" class="btn btn-link" data-dismiss="modal" id="dismiss-cat"><i class="ti-close"></i> Annulla</button>
                        </div>
                    </div>
                </form>
                % }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-link" data-dismiss="modal" id="dismiss-cat"><i class="ti-close"></i> CHIUDI FINESTRA</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL CODICE -->
<div class="modal fade" id="get-code" tabindex="-1" role="dialog" aria-labelledby="get-code" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="settings-macro-title">Ottieni il codice</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body one-tab-modal">


                <!-- Nav tabs -->
                <ul class="nav nav-tabs nav-short" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" data-toggle="tab" href="#last-macro">Macro attiva</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-toggle="tab" href="#last-query">Ultima query</a>
                    </li>
                </ul>
                <!-- Tab panes -->
                <div class="tab-content">
                    <div id="last-macro" class="tab-pane active" style="white-space: pre">
                        <div class="editor_container">
                            <pre>
                                <code class="json add-q">
                                </code>
                            </pre>
                        </div>
                    </div>
                    <div id="last-query" class="tab-pane fade" style="white-space: pre">
                        <div class="editor_container">
                            <pre>
                                <code class="sql add-q">
                                </code>
                            </pre>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-link" data-dismiss="modal" id="dismiss-cat"><i class="ti-close"></i> CHIUDI FINESTRA</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL BOOST INFO -->
<div class="modal fade" id="get-boost-info" tabindex="-1" role="dialog" aria-labelledby="get-boost-info" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="boost-title">Informazioni Boost</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body one-tab-modal">
                <p>Il <b>Boost</b> è un modulo che permette di ignorare alcune delle funzionalità standard di Highcahrts, per effettuare il rendering di quanti più dati il <b>più rapidamente possibile</b>.</p>
                <p>Pertanto, <b>alcune funzionalità non sono disponibili</b> per i grafici con questo modulo attivo. La maggior parte di queste funzionalità riguarda <b>l'interattività</b>, come il supporto per l'animazione, ma ce ne sono alcune che riguardano anche la <b>grafica</b>.<br>Nello specifico:
                    <ul>
                        <li>La <b>larghezza della linea</b> è limitata a 1 pixel;</li>
                        <li>I rettangoli per i <b>grafici a colonne e a barre</b> vengono sempre disegnati come una singola linea larga 1 pixel;</li>
                        <li>Le <b>forme dei marker</b>, a parte i cerchi, non sono supportate;</li>
                        <li>Le <b>note</b> non sono supportate</li>
                        <li>Le <b>linee tratteggiate</b> non sono supportate;</li>
                        <li>Gli <b>eventi</b> e gli <b>effetti grafici associati al click</b> sul punto non sono supportati.</li>
                    </ul>
                    Per maggiori informazioni <a href="https://www.highcharts.com/docs/advanced-chart-features/boost-module" target="_blank">Boost Module</a>.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-link" data-dismiss="modal" id="dismiss-boost-info"><i class="ti-close"></i> CHIUDI FINESTRA</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL CODICI DI VALIDITA' -->
%= include 'include/common/codes';


<!-- MODAL Modifica CHART TITLE -->
<div class="modal fade" id="chart-titles" tabindex="-1" role="dialog" aria-labelledby="chart-titles" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Modifica titoli grafico</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body one-tab-modal">
                <form class="form-horizontal" id="new-chart-titles">
                    <div class="form-group row">
                        <label for="chart-temp-title" class="col-sm-3 col-form-label">Titolo</label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control" id="chart-temp-title" name="chart-temp-title" placeholder="Titolo">
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="chart-temp-subtitle" class="col-sm-3 col-form-label">Sottotitolo</label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control" id="chart-temp-subtitle" name="chart-temp-subtitle" placeholder="Sottotitolo">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn btn-primary" data-dismiss="modal" name="apply-chart-titles" id="apply-chart-titles"><i class="mdi mdi-check-all"></i> Applica</button>
                <button type="button" class="btn btn-link" data-dismiss="modal" id="dismiss-chart-titles"><i class="ti-close"></i> Annulla</button>
            </div>
        </div>
    </div>
</div>

