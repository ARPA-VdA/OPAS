            <div class="col-lg-3 col-md-4 order-1 order-md-2">
                <div class="card">
                    <div class="card-body">
                        <form class="form-horizontal form-material" id="login-form" action="<%= url_for('get_login')%>" method="post">
                            <a href="javascript:void(0)" class="text-center db"><img src="<%=url_for(helperGetFileVersion('/bobo-img/logo.png'))%>" alt="Home" /></a>
                            <div class="form-group m-t-40">
                                <div class="col-xs-12">
                                    <input class="form-control" type="email" name="login_mail" id="login_mail" required="" placeholder="E-mail">
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="col-xs-12 input-group">
                                    <input class="form-control" type="password" name="login_password" id="login_password" required="" placeholder="Password">
                                    <div class="input-group-append">
                                        <span toggle="#login_password" class="field-icon toggle-password input-group-text"><i class="fa-solid fa-eye"></i></span>
                                    </div>
                                </div>
                            </div>
                            <!-- <div class="form-group row">
                                <div class="col-md-12">
                                    <div class="custom-control custom-checkbox">
                                        <input type="checkbox" class="custom-control-input" id="chk-stayin">
                                        <label class="custom-control-label" for="chk-stayin">Resta connesso</label>
                                    </div>
                                </div>
                            </div> -->
                            <div class="form-group text-center m-t-20">
                                <div class="col-xs-12">
                                    <button class="btn btn-info btn-lg btn-block text-uppercase btn-rounded" type="submit">Log In</button>
                                </div>
                            </div>
                            <div class="form-group m-b-0">
                                <div class="col-sm-12 text-center">
                                    <a href="javascript:void(0)" id="to-recover" class="text-dark" href=""><i class="fa fa-lock m-r-5"></i> Recupera password</a>
                                </div>
                            </div>
                        </form>
                        <form class="form-horizontal" id="recover-form" action="<%= url_for('get_password')%>" method="post">
                            <div class="form-group ">
                                <div class="col-xs-12">
                                    <h3>Recupera Password</h3>
                                    <p class="text-muted">Inserisci la tua e-mail, ti verrà inviata una password provvisoria che potrai cambiare.</p>
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="col-xs-12">
                                    <input class="form-control" type="email" name="recover_email" id="recover_email" required="" placeholder="E-mail">
                                </div>
                            </div>
                            <div class="form-group text-center m-t-20">
                                <div class="col-xs-12">
                                    <button class="btn btn-primary btn-lg btn-block text-uppercase waves-effect waves-light" type="submit">Recupera</button>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-12">
                                    <a href="#" id="back-login"><strong>&laquo;</strong> Torna alla login</a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

    </section>
