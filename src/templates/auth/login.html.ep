% layout '';
% title 'Piattaforma OPAS';

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <!-- Tell the browser to be responsive to screen width -->
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="OPAS - Open Air System: Bobo web application">
    <meta name="author" content="Ecometer">

    <!-- icons all browsers -->
    <link rel="apple-touch-icon" sizes="180x180" href="<%= helperGetFileVersion('/bobo-icons/apple-touch-icon.png') %>">
    <link rel="icon" type="image/png" sizes="32x32" href="<%= helperGetFileVersion('/bobo-icons/favicon-32x32.png') %>">
    <link rel="icon" type="image/png" sizes="16x16" href="<%= helperGetFileVersion('/bobo-icons/favicon-16x16.png') %>">
    <link rel="manifest"  href="<%= helperGetFileVersion('/bobo-icons/site.webmanifest') %>">
    <link rel="mask-icon" href="<%= helperGetFileVersion('/bobo-icons/safari-pinned-tab.svg') %>" color="#5bbad5">
    <link rel="shortcut icon" href="<%= helperGetFileVersion('/bobo-icons/favicon.ico') %>">
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="msapplication-config" content="<%= helperGetFileVersion('/bobo-icons/browserconfig.xml') %>">
    <meta name="theme-color" content="#ffffff">

    <title><%= $self->config->{title} %></title>

    <!-- Font Awesome 6 Beta - Ecometer Kit -->
    <script rel="preload" src="https://kit.fontawesome.com/98c7a7dc62.js" crossorigin="anonymous"></script>

    <!-- Custom CSS -->
    <link href="<%=url_for(helperGetFileVersion('/css/login.css'))%>" rel="stylesheet">
    <link href="<%=url_for(helperGetFileVersion('/css/style.min.css'))%>" rel="stylesheet">

    <!-- Bobo CSS -->
    <link href="<%=url_for(helperGetFileVersion('/bobo-css/default.css'))%>" rel="stylesheet">
    <link href="<%=url_for(helperGetFileVersion('/bobo-css/login.css'))%>" rel="stylesheet">
    <!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
    <script src="https://oss.maxcdn.com/libs/html5shiv/3.7.0/html5shiv.js"></script>
    <script src="https://oss.maxcdn.com/libs/respond.js/1.4.2/respond.min.js"></script>
    <![endif]-->

    <!-- ============================================================== -->
    <!-- All Jquery -->
    <!-- ============================================================== -->
    <script src="<%=url_for('/node_modules/jquery/jquery-3.2.1.min.js')%>"></script>
    <!-- Bootstrap tether Core JavaScript -->
    <script src="<%=url_for('/node_modules/popper/popper.min.js')%>"></script>
    <script src="<%=url_for('/node_modules/bootstrap/dist/js/bootstrap.min.js')%>"></script>

    <!-- sweet alert -->
    <link  href="<%=url_for('/node_modules/sweetalert/sweetalert.css')%>" rel="stylesheet" type="text/css">
    <script src="<%=url_for('/node_modules/sweetalert/sweetalert.min.js')%>"></script>
    <script src="<%=url_for('/node_modules/sweetalert/jquery.sweet-alert.custom.js')%>"></script>

    <script src="<%=url_for('/node_modules/jquery-validate/jquery.validate.min.js')%>"></script>

    <!-- map OPAS -->
    <link  href="<%=url_for('/node_modules/map-opas/css/style.css')%>" rel="stylesheet" type="text/css">
    <script src="<%=url_for('/node_modules/map-opas/js/jquery.rwdImageMaps.js')%>"></script>
    <script src="<%=url_for('/node_modules/map-opas/js/jquery.maphilight.js')%>"></script>
    <script src="<%=url_for(helperGetFileVersion('/node_modules/map-opas/js/all-js.js'))%>"></script>

    <script src="<%=url_for(helperGetFileVersion('/bobo-js/auth/login.js'))%>" type="text/javascript"></script>
</head>

<body>
    <!-- ============================================================== -->
    <!-- Preloader - style you can find in spinners.css -->
    <!-- ============================================================== -->
    <div class="preloader">
        <div class="loader">
            <div class="loader__figure"></div>
            <p class="loader__label">In caricamento...</p>
        </div>
    </div>

    <!-- Message from server for login -->
    <% if (my $message = flash 'error_msg' ) { %>
        <script type="text/javascript">
            var msg = '<%= $message %>';
            swal("Attenzione!", msg, "error");
        </script>
    <% } %>
    <% if (my $message = flash 'recover_msg' ) { %>
        <script type="text/javascript">
            var msg = '<%= $message %>';
            swal("Richiesta inoltrata", msg, "success");
        </script>
    <% } %>

    <!-- ============================================================== -->
    <!-- Main wrapper - style you can find in pages.scss -->
    <!-- ============================================================== -->
    <section id="wrapper" class="login-register login-sidebar login-opas">
        <div class="row" id="opas-view">
            <div class="col-lg-9 col-md-8 order-2 order-md-1" id="opas-map-highlight">

                <div class="popup-place" style="display: none;">
                    <h3 class="text-danger"></h3>
                    <h6><strong class=""></strong></h6>
                    <img src="" width="120" title="" />
                </div>

                <div class="bg-image">
                    <div>
                        <div class="row" style="position:relative;">
                            <div class="col-sm-12 themaps">
                                <div class="responsive-map">
                                    <canvas></canvas>
                                    <img id="italy-opas" src="<%=url_for(helperGetFileVersion('/node_modules/map-opas/img/mappa/bg-italia.png'))%>" alt="Omni" usemap="#vdamap" width="585" height="695" />
                                    <map name="vdamap" id="vdamap">
