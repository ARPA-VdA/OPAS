                                </tr>
                                <tr>
                                    <th>Percentile 99.9</th>
                                    <td class="">0</td>
                                    <td class="">10</td>
                                    <td class="text-danger font-weight-bold">150</td>
                                    <td class="">0.4</td>
                                    <td class="">0.8</td>
                                </tr>
                                <tr>
                                    <th>Percentile 98</th>
                                    <td class="">9</td>
                                    <td class="">0</td>
                                    <td class="">4</td>
                                    <td class="">1</td>
                                    <td class="">25</td>
                                </tr>
                                <tr>
                                    <th>Percentile 95</th>
                                    <td class="">0</td>
                                    <td class="">9</td>
                                    <td class="">15</td>
                                    <td class="">0.3</td>
                                    <td class="">0.8</td>
                                </tr>
                                <tr>
                                    <th>Percentile 90</th>
                                    <td class="">14</td>
                                    <td class="">0</td>
                                    <td class="">5</td>
                                    <td class="">1</td>
                                    <td class="">13</td>
                                </tr>
                                <tr>
                                    <th>Percentile 50</th>
                                    <td class="">0</td>
