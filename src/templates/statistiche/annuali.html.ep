                                </tr>
                                <tr>
                                    <th>Media oraria</th>
                                    <td class="text-danger font-weight-bold">380</td>
                                    <td class="">0</td>
                                    <td class="">7</td>
                                    <td class="">1</td>
                                    <td class="">25</td>
                                </tr>
                                <tr>
                                    <th>Minimo orario</th>
                                    <td class="">0</td>
                                    <td class="">8</td>
                                    <td class="">15</td>
                                    <td class="">0.3</td>
                                    <td class="">0.8</td>
                                </tr>
                                <tr>
                                    <th>Massimo orario</th>
                                    <td class="">11</td>
                                    <td class="">0</td>
                                    <td class="">6</td>
                                    <td class="">1</td>
                                    <td class="">27</td>
                                </tr>
                                <tr>
                                    <th>Media medie giorn.</th>
                                    <td class="">0</td>
                                    <td class="">8</td>
                                    <td class="">15</td>
                                    <td class="">0.3</td>
                                    <td class="">0.8</td>
                                </tr>
                                <tr>
                                    <th>Min media giorn.</th>
                                    <td class="">43</td>
                                    <td class="">0</td>
                                    <td class="">8</td>
                                    <td class="">1</td>
                                    <td class="">25</td>
                                </tr>
