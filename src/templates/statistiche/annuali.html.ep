% layout 'default';
% title 'Statistiche annuali';

<script src="<%=url_for(helperGetFileVersion('/bobo-js/statistiche/annuali.js'))%>" type="text/javascript"></script>

<div class="row">
    <div class="col-lg-12">
        <!-- Nav tabs -->
        <ul class="nav nav-tabs" role="tablist">
            <!-- <li class="nav-item"> <a class="nav-link" data-toggle="tab" href="#tab-period" role="tab">Periodo</a></li> -->
            <li class="nav-item"> <a class="nav-link active" data-toggle="tab" href="#tab-pdf" role="tab">PDF annuali</a></li>
            <li class="nav-item"> <a class="nav-link" data-toggle="tab" href="#tab-pollutant" role="tab">Visualizza statistiche</a></li>
        </ul>

        <!-- Tab panes -->
        <div class="tab-content tabcontent-border tab-big mb-4 img-all-view" id="main-tab">

            <!-- Download PDF -->
            <div class="tab-pane p-20 active" id="tab-pdf" role="tabpanel">
                <h4 class="box-title text-info">Statistiche annuali <strong>scaricabili in PDF</strong></h4>
                <hr class="m-t-0 m-b-20">
                <p>Calcola le statistiche selezionando il giorno e la zona, in seguito scaricale in versione PDF.</p>
                <div class="row">
                    <div class="col-xl-3 col-lg-4 m-b-10 input-group">
                        <input type="text" class="form-control clear-input" id="stats-date" name="stats-date" placeholder="mm/yyyy">
                        <div class="input-group-append">
                            <span class="input-group-text"><i class="icon-calender"></i></span>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-4 m-b-10">
                        <select class="custom-select col-12" id="stats-network" name="stats-network">
                            <option value="-1">Seleziona rete...</option>
                            % foreach my $net (@{$networks}){
                                <option value="<%= $net->{'st_network_id'} %>"><%= $net->{'st_network_desc'} %></option>
                            % }
                        </select>
                    </div>
                    <div class="col-xl-3 col-lg-4 m-b-10">
                        <select class="custom-select col-12" id="stats-zone" name="stats-zone">
                            <option value="-1">Seleziona zona...</option>
                            <option value="1">Alto Friuli</option>
                            <option value="2">Medio Friuli</option>
                            <option value="3">Basso Friuli</option>
                        </select>
                    </div>
                    <div class="col-xl-3 col-lg-4 m-b-10 stat-buttons">
                        <button type="button" id="stats-calc" class="btn btn-rounded btn-info">Calcola STAT.</button>
                        <button type="button" id="stats-pdf" class="btn btn-rounded btn-danger">Genera PDF</button>
                    </div>
                </div>
                <table id="stats-table" class="display responsive table table-hover table-striped tbl-va-center" cellspacing="0" width="100%">
                    <thead>
                        <tr>
                            <th>Data report</th>
                            <th>Ultima modifica</th>
                            <th>Nome report</th>
                            <th>Zona</th>
                            <th>Download</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>08/2023</td>
                            <td>20-08-2023 12:37</td>
                            <td>report_mensile_MF-2023-08.pdf</td>
                            <td>Medio Friuli</td>
                            <td>
                                <a class="text-danger" href="#" target="_blank"><strong><i aria-hidden="true" class="fa fa-file-pdf-o"></i> PDF</strong></a>
                            </td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>08/2023</td>
                            <td>20-08-2023 12:41</td>
                            <td>report_mensile_AF-2023-08.pdf</td>
                            <td>Alto Friuli</td>
                            <td>
                                <a class="text-danger" href="#" target="_blank"><strong><i aria-hidden="true" class="fa fa-file-pdf-o"></i> PDF</strong></a>
                            </td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>08/2023</td>
                            <td>20-08-2023 12:55</td>
                            <td>report_mensile_BF-2023-08.pdf</td>
                            <td>Basso Friuli</td>
                            <td>
                                <a class="text-danger" href="#" target="_blank"><strong><i aria-hidden="true" class="fa fa-file-pdf-o"></i> PDF</strong></a>
                            </td>
                            <td></td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>Data report</th>
                            <th>Ultima modifica</th>
                            <th>Nome report</th>
                            <th>Zona</th>
                            <th>Download</th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- Provincia/Rete -->
            <div class="tab-pane p-20" id="tab-pollutant" role="tabpanel">
                <h4 class="box-title text-info">Statistiche annuali suddivise per <strong>Zona / Inquinante</strong></h4>
                <hr class="m-t-0 m-b-20">
                <p>Visualizza le statistiche annuali per una data zona selezionando l'inquinante.</p>
                <div class="row">
                    <div class="col-xl-3 col-lg-4 m-b-10 input-group">
                        <input type="text" class="form-control clear-input" id="show-stats-date" name="show-stats-date" placeholder="mm/yyyy">
                        <div class="input-group-append">
                            <span class="input-group-text"><i class="icon-calender"></i></span>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-4 m-b-10">
                        <select class="custom-select col-12" id="show-stats-network" name="show-stats-network">
                            <option value="-1">Seleziona rete...</option>
                            % foreach my $net (@{$networks}){
                                <option value="<%= $net->{'st_network_id'} %>"><%= $net->{'st_network_desc'} %></option>
                            % }
                        </select>
                    </div>
                    <div class="col-xl-3 col-lg-4 m-b-10">
                        <select class="custom-select col-12" id="show-stats-station" name="show-stats-station">
                            <option value="-1">Seleziona zona...</option>
                            <option value="1">Alto Friuli</option>
                            <option value="2">Medio Friuli</option>
                            <option value="3">Basso Friuli</option>
                        </select>
                    </div>
                    <div class="col-xl-3 col-lg-4 m-b-10 stat-buttons">
                        <select class="custom-select col-12" id="show-stats-pollutant" name="show-stats-pollutant">
                            <option value="-1">Seleziona inquinante...</option>
                            <option value="1">Inquinante 1</option>
                            <option value="2">Inquinante 2</option>
                            <option value="3">Inquinante 3</option>
                        </select>
                    </div>
                </div>
                <div id="tab-staz-data">
                    <h5 class="subtitle-tabbing">Hai selezionato <strong>Ozono</strong> per la zona <strong>Medio Friuli</strong></h5>
                    <div class="table-scroll tbl-scroll-modal m-t-5">
                        <table cellspacing="0" id="dynamic-staz-table">
                            <thead>
                                <tr class="text-center">
                                    <th></th>
                                    <th class="">Stazione 1</th>
                                    <th class="">Stazione 2</th>
                                    <th class="">Stazione 3</th>
                                    <th class="">Stazione 4</th>
                                    <th class="">Stazione 5</th>
                                </tr>
                            </thead>
                            <tbody class="text-center">
                                <tr>
                                    <th>Dati teorici</th>
                                    <td class="">43</td>
                                    <td class="">0</td>
                                    <td class="">8</td>
                                    <td class="">1</td>
                                    <td class="">25</td>
                                </tr>
                                <tr>
                                    <th>Dati reali</th>
                                    <td class="">0</td>
                                    <td class="">11</td>
                                    <td class="">15</td>
                                    <td class="text-muted font-italic">nd</td>
                                    <td class="text-muted font-italic">nd</td>
                                </tr>
                                <tr>
                                    <th>Percentuale</th>
                                    <td class="">13</td>
