% layout 'default';
% title 'Statistiche mensili';

<script src="<%=url_for(helperGetFileVersion('/bobo-js/statistiche/reportistica.js'))%>" type="text/javascript"></script>

<div class="row">
    <div class="col-lg-12">
        <!-- Nav tabs -->
        <ul class="nav nav-tabs" role="tablist">
            <!-- <li class="nav-item"> <a class="nav-link" data-toggle="tab" href="#tab-period" role="tab">Periodo</a></li> -->
            <li class="nav-item"> <a class="nav-link active" data-toggle="tab" href="#tab-pdf" role="tab"><i class="fa-regular fa-file-circle-plus"></i> Genera PDF</a></li>
            <li class="nav-item"> <a class="nav-link" data-toggle="tab" href="#tab-tables" role="tab"><i class="fa-regular fa-table-columns"></i> Statistiche tabellari</a></li>
        </ul>

        <!-- Tab panes -->
        <div class="tab-content tabcontent-border tab-big mb-4 img-all-view" id="main-tab">

            <!-- Genera PDF -->
            <div class="tab-pane p-20 active" id="tab-pdf" role="tabpanel">
                <div class="last-reporting" data-id="">
                    <h4 class="box-title"><strong>Calcola e scarica</strong> le statistiche della tua rete</h4>
                    <hr class="m-t-0 m-b-10">
                    <p>Calcola le statistiche selezionando il giorno e la zona, in seguito scaricale in versione PDF.</p>
                    <form class="form" id="stats-form" name="stats-form">
                        <div class="form-group row">
                            <label for="stats-type" class="col-md-2 col-form-label">Tipologia <span class="text-danger">*</span></label>
                            <div class="col-md-4">
                                <select  class="custom-select col-12 clear-select" name="stats-type" id="stats-type">
                                    <option value="-1">Seleziona tipologia...</option>
                                    <option value="1">Giornaliere</option>
                                    <option value="2">Mensili</option>
                                    <option value="3">Annuali</option>
                                </select>
                            </div>
                            <label for="stats-day" class="col-md-2 col-form-label hide-day">Giorno <span class="text-danger">*</span></label>
                            <div class="col-md-4 input-group hide-day">
                                <input type="text" class="form-control clear-input" id="stats-day" name="stats-day" placeholder="mm/dd/yyyy">
                                <div class="input-group-append">
                                    <span class="input-group-text"><i class="icon-calender"></i></span>
                                </div>
                            </div>
                            <label for="stats-month" class="col-md-2 col-form-label hide-month">Mese <span class="text-danger">*</span></label>
                            <div class="col-md-4 input-group hide-month">
                                <input type="text" class="form-control clear-input" id="stats-month" name="stats-month" placeholder="mm/yyyy">
                                <div class="input-group-append">
                                    <span class="input-group-text"><i class="icon-calender"></i></span>
                                </div>
                            </div>
                            <label for="stats-year" class="col-md-2 col-form-label hide-year">Anno <span class="text-danger">*</span></label>
                            <div class="col-md-4 input-group hide-year">
                                <input type="text" class="form-control clear-input" id="stats-year" name="stats-year" placeholder="yyyy">
                                <div class="input-group-append">
                                    <span class="input-group-text"><i class="icon-calender"></i></span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="stats-zone" class="col-md-2 col-form-label">Zona <span class="text-danger">*</span></label>
                            <div class="col-md-4">
                                <select class="custom-select clear-select col-12" id="stats-zone" name="stats-zone" data-dest="stats-param">
                                    <option value="-1">Seleziona zona...</option>
                                    % foreach my $zone (@{$zones}){
                                        <option value="<%= $zone->{'sz_id'} %>"><%= $zone->{'sz_name'} %></option>
                                    % }
                                </select>
                            </div>
                            <label for="stats-param" class="col-md-2 col-form-label hide-year hide-month">Inquinante <span class="text-danger">*</span></label>
                            <div class="col-md-4 hide-year hide-month">
                                <select  class="custom-select col-12 clear-select" name="stats-param" id="stats-param">
                                    <option value="-1">Seleziona inquinante...</option>
                                </select>
                            </div>

                        </div>
                        <div class="form-group row">
                            <label for="stats-signature" class="col-md-2 col-form-label hide-year hide-month">Firmatario <span class="text-danger">*</span></label>
                            <div class="col-md-4 hide-year hide-month">
                                <select  class="custom-select col-12 clear-select" name="stats-signature" id="stats-signature">
                                    <option value="-1">Seleziona firmatario...</option>
                                    % foreach my $user (@{$users}){
                                        <option value="<%= $user->{'us_id'} %>"><%= $user->{'us_fullname'} %></option>
                                    % }
                                </select>
                            </div>
                            <label for="stats-note" class="col-md-2 col-form-label">Note</label>
                            <div class="col-md-4">
                                <textarea class="form-control clear-input" rows="6" id="stats-note" name="stats-note"></textarea>
                            </div>
                        </div>
                        <div class="form-group row m-b-0">
                            <div class="col-12 text-right">
                                <button type="submit" class="btn btn-rounded btn-info" id="stats-status"><i class="fa-solid fa-magnifying-glass"></i> Verifica stato</button>
                                <button type="submit" class="btn btn-rounded btn-primary" id="stats-calc"><i class="fa-solid fa-calculator"></i> Calcola STAT.</button>
                                <button type="submit" class="btn btn-rounded btn-danger" id="stats-pdf"><i class="fa-solid fa-file-pdf"></i> Genera PDF</button>
                                <button type="button" class="btn btn-rounded btn-inverse" id="stats-cancel">Annulla</button>
                            </div>
                        </div>
                    </form>
                </div>

                <hr class="m-t-20 m-b-20">
                <h4 class="box-title text-success m-b-10">Archivio  <strong>statistiche create</strong></h4>
                <div class="row m-b-10">
                    <div class="input-group col-md-4">
                        <input class="form-control input-daterange-datepicker" type="text" id="filter-date" name="filter-date" value="" />
                        <div class="input-group-append">
                            <span class="input-group-text"><i class="mdi mdi-calendar-multiple"></i></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <select class="custom-select col-12" id="filter-type" name="filter-type">
                            <option value="-1">Tipologia..</option>
                            <option value="1">Giornaliero</option>
                            <option value="2">Mensile</option>
                            <option value="3">Annuale</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <select class="custom-select col-12" id="filter-zone" name="filter-zone">
                            <option value="-1">Zona..</option>
                            % foreach my $zone (@{$zones}){
                                <option value="<%= $zone->{'sz_id'} %>"><%= $zone->{'sz_name'} %></option>
                            % }
                        </select>
                    </div>
                </div>
                <table id="stats-table" class="display responsive table table-hover table-striped tbl-va-center" cellspacing="0" width="100%">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Data report</th>
                            <th>Tipologia</th>
                            <th>Nome report</th>
                            <th>Zona</th>
                            <th>Parametro</th>
                            <th>Firmatario</th>
                            <th>Note</th>
                            <th>Ultima modifica</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                    <tfoot>
                        <tr>
                            <th></th>
                            <th>Data report</th>
                            <th>Tipologia</th>
                            <th>Nome report</th>
                            <th>Zona</th>
                            <th>Parametro</th>
                            <th>Firmatario</th>
                            <th>Note</th>
                            <th>Ultima modifica</th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- Statistiche tabellari -->
            <div class="tab-pane p-20" id="tab-tables" role="tabpanel">

                <h4 class="box-title text-info">Statistiche giornaliere suddivise per <strong>Stazione</strong></h4>
                <hr class="m-t-0 m-b-20">
                <p>Visualizza le statistiche giornaliere per una data zona selezionandola assieme al periodo temporale.</p>
                <div class="row">
                    <div class="col-xl-3 col-lg-4 m-b-10 input-group">
                        <input class="form-control input-daterange-datepicker" type="text" name="daterange" id="show-stats-day" name="show-stats-day" placeholder="mm/dd/yyyy - mm/dd/yyyy" />
                        <div class="input-group-append">
                            <span class="input-group-text"><i class="mdi mdi-calendar-multiple"></i></span>
                        </div>
                    </div>
                    <!-- <div class="col-xl-3 col-lg-4 m-b-10">
                        <select class="custom-select col-12" id="show-stats-network-day" name="show-stats-network-day">
                            <option value="-1">Seleziona rete...</option>
                            % foreach my $net (@{$networks}){
                                <option value="<%= $net->{'st_network_id'} %>"><%= $net->{'st_network_desc'} %></option>
                            % }
                        </select>
                    </div> -->
                    <div class="col-xl-3 col-lg-4 m-b-10">
                        <select class="custom-select col-12" id="show-stats-zone-day" name="show-stats-zone-day">
                            <option value="-1">Seleziona zona...</option>
                            % foreach my $zone (@{$zones}){
                                <option value="<%= $zone->{'sz_id'} %>"><%= $zone->{'sz_name'} %></option>
                            % }
                        </select>
                    </div>
                    <div class="col-xl-3 col-lg-4 m-b-10 stat-buttons">
                        <select class="custom-select col-12" id="show-stats-station-day" name="show-stats-station-day">
                            <option value="-1">Seleziona stazione...</option>
                        </select>
                    </div>
                </div>
                <div id="tab-staz-data-day">
                    <h5 class="subtitle-tabbing">Hai selezionato: <strong>Monfalcone - via Natisone</strong></h5>
