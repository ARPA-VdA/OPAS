<!-- MODAL DETTAGLIO CHECK DATI -->
<div class="modal fade" id="check-data-res" tabindex="-1" role="dialog" aria-labelledby="check-data-res" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="">Risultati della procedura di controllo dati</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <h3>Controllo completato</h3>
                <div class="lightbox-txt">
                    <p class="text-danger">I dati sono stati controllati e sono emerse <strong>le seguenti anomalie</strong>:</p>
                    <div id="check-results"></div>
                </div>
            </div>
            <div class="modal-footer">
                <!-- <button type="button" class="btn btn-info" id="check-data-copy"><i class="fa-sharp fa-light fa-copy"></i> Copia risultati</button> -->
                <button type="button" class="btn btn-link text-danger" data-dismiss="modal" id="check-data-cancel"><i class="ti-close"></i> CHIUDI</button>
            </div>
        </div>
    </div>
</div>