% layout 'default';
% title 'Dati - Validazione multilivello';

<script src="<%=url_for(helperGetFileVersion('/bobo-js/dati/validaz_finale.js'))%>" type="text/javascript"></script>

<script type="text/javascript">
    var closureDate = "<%= $page_options->{'closure'} %>";
    if(closureDate)
        closureDate = moment(closureDate).format('DD/MM/YYYY');
</script>

<div class="row">
    <div class="col-sm-12">

        <!-- Nav tabs -->
        <ul class="nav nav-tabs" role="tablist" id="main-list">
            <li class="nav-item"> <a class="nav-link active" data-toggle="tab" href="#status-tab" role="tab"><span class="hidden-sm-up"><i class="fa-regular fa-eye"></i></span> <span class="hidden-xs-down">Stato validazione dati</span></a> </li>
            <!-- if user has insert grant -->
            % if ($user_grants->{user_insert}){
                <li class="nav-item"> <a class="nav-link" data-toggle="tab" href="#change-tab" role="tab"><span class="hidden-sm-up"><i class="fa-regular fa-shield-check"></i></span> <span class="hidden-xs-down">Valida i dati</span></a> </li>
            % }
            <li class="nav-item"> <a class="nav-link" data-toggle="tab" href="#register-tab" role="tab"><span class="hidden-sm-up"><i class="fa-regular fa-cash-register"></i></span> <span class="hidden-xs-down">Registro attività</span></a> </li>
        </ul>

        <!-- Tab panes -->
        <div class="tab-content tabcontent-border tab-big m-b-25" id="main-tab">
            <div class="tab-pane active" id="status-tab" role="tabpanel">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title text-success">STATO - Validazione multilivello</h4>
                        <h6 class="card-subtitle">Visualizza le percentuali per livello e parametro dello stato di validazione multilivello. La visualizzazione è sia grafica che tabellare.</h6>

                        <div class="row">
                            <div class="input-group col-md-3 m-b-5">
                                <input class="form-control input-year-datepicker" type="text" data-date-format="yyyy" name="show-daterange" id="show-daterange" value="" />
                                <div class="input-group-append">
                                    <span class="input-group-text"><i class="mdi mdi-calendar-multiple"></i></span>
                                </div>
                            </div>
                            <div class="col-md-3 m-b-5">
                                <select class="custom-select col-12" id="show-networks" name="show-networks" data-dest="show">
                                    <option value="-1">Seleziona rete...</option>
                                    % foreach my $net (@{$networks}){
                                        <option value="<%= $net->{'st_network_id'} %>"><%= $net->{'st_network_desc'} %></option>
                                    % }
                                </select>
                            </div>
                            <div class=" col-md-3 m-b-5">
                                <select class="custom-select col-12" id="show-provinces" name="show-provinces" data-dest="show">
                                    <option value="-1">Seleziona provincia...</option>
                                    % my $region = '';
                                    % foreach my $province (@{$provinces}){

                                        % if ($region eq ''){
                                            <optgroup label="<%= $province->{'region_name'} %>">
                                            <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                        % }else{
                                            % if ($region eq $province->{'region_id'}){
                                                <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                            % } else {
                                                </optgroup>
                                                <optgroup label="<%= $province->{'region_name'} %>">
                                                <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                            % }
                                        % }
                                        % $region = $province->{'region_id'};
                                    % }
                                    </optgroup>
                                </select>
                            </div>
                            <div class=" col-md-3 m-b-5">
                                <select class="custom-select col-12" id="show-stations" name="show-stations">
                                    <option value="-1">Seleziona stazione...</option>
                                </select>
                            </div>
                        </div>

                        <div id="show-container">
                            <div class="row m-t-10">
                                <div class="col-md-12">
                                    <h3 class="text-info m-b-5">
                                        Stazione selezionata: <strong></strong>
                                        <button type="button" class="btn btn-primary btn-rounded btn-sm pull-right" id="show-refresh"><i class="icon-refresh"></i> Aggiorna dati</button>
                                    </h3>
                                </div>
                            </div>

                            <!-- Nav tabs -->
                            <ul class="nav nav-tabs customtab main-tab" role="tablist">
                                <li class="nav-item"> <a class="nav-link active" data-toggle="tab" href="#status-tbl" id="new-bulletin" role="tab"><span class="hidden-sm-up"><i class="mdi mdi-table"></i></span> <span class="hidden-xs-down" id="inner-new-bulletin">Tabelle</span></a> </li>
                                <li class="nav-item"> <a class="nav-link" data-toggle="tab" href="#status-charts" role="tab"><span class="hidden-sm-up"><i class="mdi mdi-chart-areaspline"></i></span> <span class="hidden-xs-down">Grafici</span></a> </li>
                            </ul>

                            <!-- Tab panes -->
                            <div class="tab-content">
                                <div class="tab-pane p-20 active" id="status-tbl" role="tabpanel">

                                    <div id="station-coverage-legend" class="legend">
                                        <h5 class="text-primary">Legenda: percentuale mensile di validazione dei dati</strong></h5>
                                      <!--   <span>
                                            <button type="button" class="btn waves-effect waves-light btn-rounded btn-sm few-data">&nbsp;&nbsp;&nbsp;</button> Nessun dato
                                        </span>
                                        <span>
                                            <button type="button" class="btn waves-effect waves-light btn-rounded btn-sm few-data">&nbsp;&nbsp;&nbsp;</button> Da 1% al 90%
                                        </span> -->
                                        <span>
                                            <button type="button" class="btn waves-effect waves-light btn-rounded btn-sm few-data">&nbsp;&nbsp;&nbsp;</button> Dal 0% al 99%
                                        </span>
                                        <span>
                                            <button type="button" class="btn waves-effect waves-light btn-rounded btn-sm all-data">&nbsp;&nbsp;&nbsp;</button> 100%
                                        </span>
                                    </div>

                                    <div class="station-validation">
                                        <h4 class="text-success m-b-10">Validazione <strong id="title-validation-tbl-1">Livello 1</strong> in percentuale</h4>
                                        <div class="table-responsive">
                                            <table class="table tbl-centered table-compressed tbl-validation" id="add-validation-tbl-1">
                                                <thead>
                                                    <tr>
                                                        <th></th>
                                                        <th>Gen</th>
                                                        <th>Feb</th>
                                                        <th>Mar</th>
                                                        <th>Apr</th>
                                                        <th>Mag</th>
                                                        <th>Giu</th>
                                                        <th>Lug</th>
                                                        <th>Ago</th>
                                                        <th>Set</th>
                                                        <th>Ott</th>
                                                        <th>Nov</th>
                                                        <th>Dic</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                </tbody>
                                                <tfoot>
                                                    <tr>
                                                        <th></th>
                                                        <th>Gen</th>
                                                        <th>Feb</th>
                                                        <th>Mar</th>
                                                        <th>Apr</th>
                                                        <th>Mag</th>
                                                        <th>Giu</th>
                                                        <th>Lug</th>
                                                        <th>Ago</th>
                                                        <th>Set</th>
                                                        <th>Ott</th>
                                                        <th>Nov</th>
                                                        <th>Dic</th>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        </div>

                                        <!-- <div class="download-buttons-nopag">
                                            <button id="download-csv" type="button" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Download CSV">
                                                <i class="ti-download"></i> CSV
                                            </button>
                                            <button id="download-xlsx" type="button" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Download XLSX">
                                                <i class="ti-download"></i> XLSX
                                            </button>
                                        </div> -->
                                    </div>

                                    <div class="station-validation">
                                        <h4 class="text-success m-b-10 m-t-30">Validazione <strong id="title-validation-tbl-2">Livello 2</strong> in percentuale</h4>
                                        <div class="table-responsive">
                                            <table class="table tbl-centered table-compressed tbl-validation" id="add-validation-tbl-2">
                                                <thead>
                                                    <tr>
                                                        <th></th>
                                                        <th>Gen</th>
                                                        <th>Feb</th>
                                                        <th>Mar</th>
                                                        <th>Apr</th>
                                                        <th>Mag</th>
                                                        <th>Giu</th>
                                                        <th>Lug</th>
                                                        <th>Ago</th>
                                                        <th>Set</th>
                                                        <th>Ott</th>
                                                        <th>Nov</th>
                                                        <th>Dic</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                </tbody>
                                                <tfoot>
                                                    <tr>
                                                        <th></th>
                                                        <th>Gen</th>
                                                        <th>Feb</th>
                                                        <th>Mar</th>
                                                        <th>Apr</th>
                                                        <th>Mag</th>
                                                        <th>Giu</th>
                                                        <th>Lug</th>
                                                        <th>Ago</th>
                                                        <th>Set</th>
                                                        <th>Ott</th>
                                                        <th>Nov</th>
                                                        <th>Dic</th>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        </div>

                                        <!-- <div class="download-buttons-nopag">
                                            <button id="download-csv" type="button" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Download CSV">
                                                <i class="ti-download"></i> CSV
                                            </button>
                                            <button id="download-xlsx" type="button" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Download XLSX">
                                                <i class="ti-download"></i> XLSX
                                            </button>
                                        </div> -->
                                    </div>

                                    <div class="station-validation">
                                        <h4 class="text-success m-b-10 m-t-30">Validazione <strong id="title-validation-tbl-4">Livello 3</strong> in percentuale</h4>
                                        <div class="table-responsive">
                                            <table class="table tbl-centered table-compressed tbl-validation" id="add-validation-tbl-4">
                                                <thead>
                                                    <tr>
                                                        <th></th>
                                                        <th>Gen</th>
                                                        <th>Feb</th>
                                                        <th>Mar</th>
                                                        <th>Apr</th>
                                                        <th>Mag</th>
                                                        <th>Giu</th>
                                                        <th>Lug</th>
                                                        <th>Ago</th>
                                                        <th>Set</th>
                                                        <th>Ott</th>
                                                        <th>Nov</th>
                                                        <th>Dic</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                </tbody>
                                                <tfoot>
                                                    <tr>
                                                        <th></th>
                                                        <th>Gen</th>
                                                        <th>Feb</th>
                                                        <th>Mar</th>
                                                        <th>Apr</th>
                                                        <th>Mag</th>
                                                        <th>Giu</th>
                                                        <th>Lug</th>
                                                        <th>Ago</th>
                                                        <th>Set</th>
                                                        <th>Ott</th>
                                                        <th>Nov</th>
                                                        <th>Dic</th>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        </div>

                                        <!-- <div class="download-buttons-nopag">
                                            <button id="download-csv" type="button" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Download CSV">
                                                <i class="ti-download"></i> CSV
                                            </button>
                                            <button id="download-xlsx" type="button" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Download XLSX">
                                                <i class="ti-download"></i> XLSX
                                            </button>
                                        </div> -->
                                    </div>

                                    <div class="station-validation">
                                        <h4 class="text-success m-b-10 m-t-30">Validazione <strong id="title-validation-tbl-8">Livello 4</strong> in percentuale</h4>
                                        <div class="table-responsive">
                                            <table class="table tbl-centered table-compressed tbl-validation" id="add-validation-tbl-8">
                                                <thead>
                                                    <tr>
                                                        <th></th>
                                                        <th>Gen</th>
                                                        <th>Feb</th>
                                                        <th>Mar</th>
                                                        <th>Apr</th>
                                                        <th>Mag</th>
                                                        <th>Giu</th>
                                                        <th>Lug</th>
                                                        <th>Ago</th>
                                                        <th>Set</th>
                                                        <th>Ott</th>
                                                        <th>Nov</th>
                                                        <th>Dic</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                </tbody>
                                                <tfoot>
                                                    <tr>
                                                        <th></th>
                                                        <th>Gen</th>
                                                        <th>Feb</th>
                                                        <th>Mar</th>
                                                        <th>Apr</th>
                                                        <th>Mag</th>
                                                        <th>Giu</th>
                                                        <th>Lug</th>
                                                        <th>Ago</th>
                                                        <th>Set</th>
                                                        <th>Ott</th>
                                                        <th>Nov</th>
                                                        <th>Dic</th>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        </div>

                                        <!-- <div class="download-buttons-nopag">
                                            <button id="download-csv" type="button" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Download CSV">
                                                <i class="ti-download"></i> CSV
                                            </button>
                                            <button id="download-xlsx" type="button" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Download XLSX">
                                                <i class="ti-download"></i> XLSX
                                            </button>
                                        </div> -->
                                    </div>


                                </div>
                                <div class="tab-pane p-20" id="status-charts" role="tabpanel">
                                    <div class="row" id="charts">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <div class="tab-pane" id="change-tab" role="tabpanel">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title text-success">Validazione multilivello dei dati</h4>
                        <h6 class="card-subtitle">Seleziona: date, stazioni, parametri e livello di validazione - ricontrolla e poi decidi se validare o meno i dati</h6>
                        % if( defined $page_options->{'closure'} ){
                        <div class="blocked-right text-danger">Dati bloccati prima del <strong data-toggle="tooltip" title="Dati non editabili prima di questa data (impostata dagli amministratori del sistema)"></strong></div>
                        % }
                        <div class="row m-b-5">
                            <div class="input-group col-lg-3">
                                <input class="form-control input-daterange-datepicker" type="text" name="final-daterange" id="final-daterange" value=""/>
                                <div class="input-group-append">
                                    <span class="input-group-text"><i class="mdi mdi-calendar-multiple"></i></span>
                                </div>
                            </div>
                            <div class="col-lg-3">
                                <select class="custom-select col-12" id="levels" name="levels">
                                    <option value="-1">Seleziona livello validaz...</option>
                                    % foreach my $code (@{$codes}){
                                        <option value="<%= $code->{'fvc_code_id'} %>"><%= $code->{'fvc_code_desc'} %></option>
                                    % }
                                </select>
                            </div>
                            <div class="col-lg-3">
                                <select class="custom-select col-12" id="provinces" name="provinces" data-dest="stations">
                                    <option value="-1">Seleziona provincia...</option>
                                    % $region = '';
                                    % foreach my $province (@{$provinces}){

                                        % if ($region eq ''){
                                            <optgroup label="<%= $province->{'region_name'} %>">
                                            <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                        % }else{
                                            % if ($region eq $province->{'region_id'}){
                                                <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                            % } else {
                                                </optgroup>
                                                <optgroup label="<%= $province->{'region_name'} %>">
                                                <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                            % }
                                        % }
                                        % $region = $province->{'region_id'};
                                    % }
                                    </optgroup>
                                </select>
                            </div>
                            <div class="col-lg-3">
                                <strong>Conversione dati</strong>&nbsp;&nbsp;
                                <input type="checkbox" class="form-control input-showconv" name="showconv" id="showconv" checked data-onstyle="success" data-offstyle="danger" data-on="SI" data-off="NO" data-size="sm" data-style="android">
                            </div>
                        </div>
                        <div class="row m-b-15">
                            <div class="col-lg-5">
                                <select class="custom-select col-12" id="stations" name="stations" multiple placeholder="Seleziona stazioni...">
                                </select>
                            </div>
                            <div class="col-lg-7">
                                <!-- <div class="input-group">
                                    <select class="custom-select" id="parameters" name="parameters" multiple placeholder="Seleziona parametri...">
                                        % foreach my $param (@{$page_options->{'params'}}){
                                            <option value="<%= $param->{'value'} %>"><%= $param->{'label'} %></option>
                                        % }
                                    </select>
                                    <div class="input-group-append">

                                    </div>
                                </div> -->


                                <div class="input-group">
                                    <select class="custom-select" id="parameters" name="parameters" multiple placeholder="Seleziona parametri...">
                                        % foreach my $param (@{$page_options->{'params'}}){
                                            <option value="<%= $param->{'value'} %>"><%= $param->{'label'} %></option>
                                        % }
                                    </select>
                                    <div class="input-group-append">
                                      <!-- <button class="btn btn-outline-secondary" type="button">Button</button> -->
                                      <button type="button" class="btn btn-outline-secondary btn-sm" id="reset-params">SVUOTA CAMPO</button>
                                    </div>
                                </div>

                            </div>
                        </div>


                        <div class="hide-el row m-t-10">
                            <div class="col-md-12">
                                <h3 class="text-info m-b-5">
                                    Validazione livello: <strong id="title-lvl">Livello 4</strong>
                                    <button type="button" class="btn btn-primary btn-rounded btn-sm pull-right" id="refresh"><i class="icon-refresh"></i> Aggiorna dati</button>
                                </h3>
                            </div>
                        </div>

                        <!-- <h5 class="title-multi">Staz.: <strong>Castelluccio (BO), Parco Resistenza (FC)</strong></h5>
                        <h5 class="title-multi">Param.: <strong>PM10, SO2, NOX, NO2</strong></h5> -->
                        <!-- <h5 class="hide-el title-multi m-b-10">Validazione livello: <strong id="title-lvl">Livello 4</strong></h5> -->
                        <div class="hide-el table-responsive">
                            <table class="table tbl-centered table-compressed tbl-validation" id="add-validation-tbl">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th class="name-place">Stazione</th>
                                        <th class="name-place">Parametro</th>
                                        <th data-toggle="tooltip" data-original-title="Percentuale di dati presenti sul totale dei dati attesi">Copertura <i class="text-danger icon-info"></i></th>
                                        <th data-toggle="tooltip" data-original-title="Percentuale di dati validi sul totale dei dati attesi">% Validi <i class="text-danger icon-info"></i></th>
                                        <th>Min</th>
                                        <th>Max</th>
                                        <th>Avg</th>
                                        % my $cnt = 0;
                                        % foreach my $code (@{$page_options->{'codes'}}){
                                        %   $cnt++;
                                            <th data-toggle="tooltip" data-original-title="<%= $code->{'label'} %>" data-lvl="<%= $code->{'value'} %>"><span class="valid-level code-<%= $code->{'value'} %>"></span> <%= $cnt %></th>
                                        % }
                                        <!-- <th data-lvl="1"><span class="valid-level code-1"></span> L1</th>
                                        <th data-lvl="2"><span class="valid-level code-2"></span> L2</th>
                                        <th data-lvl="3"><span class="valid-level code-4"></span> L3</th>
                                        <th data-lvl="4"><span class="valid-level code-8"></span> L4</th> -->
                                        <th class="text-right"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th class="name-place">Stazione</th>
                                        <th class="name-place">Parametro</th>
                                        <th data-toggle="tooltip" data-original-title="Percentuale di dati presenti sul totale dei dati attesi">Copertura <i class="text-danger icon-info"></i></th>
                                        <th data-toggle="tooltip" data-original-title="Percentuale di dati validi sul totale dei dati attesi">% Validi <i class="text-danger icon-info"></i></th>
                                        <th>Min</th>
                                        <th>Max</th>
                                        <th>Avg</th>
                                        % $cnt = 0;
                                        % foreach my $code (@{$page_options->{'codes'}}){
                                        %   $cnt++;
                                            <th data-toggle="tooltip" data-original-title="<%= $code->{'label'} %>" data-lvl="<%= $code->{'value'} %>"><span class="valid-level code-<%= $code->{'value'} %>"></span> <%= $cnt %></th>
                                        % }
                                        <!-- <th data-lvl="1"><span class="valid-level code-1"></span> L1</th>
                                        <th data-lvl="2"><span class="valid-level code-2"></span> L2</th>
                                        <th data-lvl="3"><span class="valid-level code-4"></span> L3</th>
                                        <th data-lvl="4"><span class="valid-level code-8"></span> L4</th> -->
                                        <th class="text-right"></th>
                                    </tr>
                                </thead>
                            </table>
                        </div>

                        <div id="lightbox-chart" class="white-popup mfp-hide">
                            <div id="container-chart"></div>
                        </div>

                    </div>
                </div>
            </div>

            <div class="tab-pane" id="register-tab" role="tabpanel">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title text-success">Registro delle attività</h4>
                        <h6 class="card-subtitle">Registro delle attività eseguite dagli utenti relative alla validazione multilivello</h6>

                        <div class="row">
                            <div class="input-group col-xl-3 col-md-6 m-b-5">
                                <input class="form-control input-daterange-datepicker" type="text" data-date-format="yyyy" name="register-daterange" id="register-daterange" value="" />
                                <div class="input-group-append">
                                    <span class="input-group-text"><i class="mdi mdi-calendar-multiple"></i></span>
                                </div>
                            </div>
                            <!-- <div class="col-xl-2 col-md-3 m-b-5">
                                <select class="custom-select col-12" id="register-networks" name="register-networks" data-dest="register">
                                    <option value="-1">Seleziona rete...</option>
                                    % foreach my $net (@{$networks}){
                                        <option value="<%= $net->{'st_network_id'} %>"><%= $net->{'st_network_desc'} %></option>
                                    % }
                                </select>
                            </div> -->
                            <div class="col-xl-2 col-md-3 m-b-5">
                                <select class="custom-select col-12" id="register-levels" name="register-levels">
                                    <option value="-1">Seleziona tipo validaz...</option>
                                    % foreach my $code (@{$codes}){
                                        <option value="<%= $code->{'fvc_code_id'} %>"><%= $code->{'fvc_code_desc'} %></option>
                                    % }
                                </select>
                            </div>
                            <div class=" col-xl-2 col-md-6 m-b-5">
                                <select class="custom-select col-12" id="register-user" name="register-user">
                                    <option value="-1">Seleziona utente...</option>
                                    % foreach my $user (@{$users}){
                                        <option value="<%= $user->{'us_id'} %>"><%= $user->{'us_fullname'} %></option>
                                    % }
                                </select>
                            </div>
                            <div class=" col-xl-2 col-md-3 m-b-5">
                                <select class="custom-select col-12" id="register-provinces" name="register-provinces" data-dest="register-stations">
                                    <option value="-1">Seleziona provincia...</option>
                                    % $region = '';
                                    % foreach my $province (@{$provinces}){

                                        % if ($region eq ''){
                                            <optgroup label="<%= $province->{'region_name'} %>">
                                            <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                        % }else{
                                            % if ($region eq $province->{'region_id'}){
                                                <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                            % } else {
                                                </optgroup>
                                                <optgroup label="<%= $province->{'region_name'} %>">
                                                <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                            % }
                                        % }
                                        % $region = $province->{'region_id'};
                                    % }
                                    </optgroup>
                                </select>
                            </div>
                            <div class=" col-xl-3 col-md-6 m-b-5">
                                <select class="custom-select col-12" id="register-stations" name="register-stations">
                                    <option value="-1">Seleziona stazione...</option>
                                </select>
                            </div>
                        </div>

                        <!-- <h3 class="hide-register-el text-info m-t-10 m-b-10">Stazione selezionata: <strong>Savona - Ecosavona Boscaccio</strong></h3> -->
                        <div class="hide-register-el">
                            <table id="register-table" class="display responsive table table-hover table-striped tbl-va-center" cellspacing="0" width="100%">
                                <thead>
                                    <tr>
                                        <th class="bobo-nowrap">GG/HH Validaz.</th>
                                        <th>Tipo validazione</th>
                                        <th>Operatore</th>
                                        <th>Stazione</th>
                                        <th>Parametro</th>
                                        <th>Periodo validato</th>
                                        <th>N° dati validati</th>
                                        <th class="dtr-control"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th class="bobo-nowrap">GG/HH Validaz.</th>
                                        <th>Tipo validazione</th>
                                        <th>Operatore</th>
                                        <th>Stazione</th>
                                        <th>Parametro</th>
                                        <th>Periodo validato</th>
                                        <th>N° dati validati</th>
                                        <th class="dtr-control"></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>