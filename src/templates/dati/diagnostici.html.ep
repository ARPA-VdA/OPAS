% layout 'default';
% title 'Dati - diagnostici';

<script src="<%=url_for(helperGetFileVersion('/bobo-js/dati/diagnostici.js'))%>" type="text/javascript"></script>

<script type="text/javascript">
    var stid      = '<%= $stid %>';
</script>

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-12">
                        <h4 class="card-title">Diagnostici</h4>
                        <h6 class="card-subtitle">Pagina con i dati dei diagnostici per ogni stazione in un determinato periodo</h6>
                    </div>
                </div>
                <div class="row">
                    <div class="input-group col-md-3" style="margin-bottom: 20px;">
                        <input class="form-control input-daterange-datepicker" type="text" data-date-format="yyyy"  name="daterange" value="" />
                        <div class="input-group-append">
                            <span class="input-group-text"><i class="mdi mdi-calendar-multiple"></i></span>
                        </div>
                    </div>
                    <div class=" col-md-3">
                        <select class="custom-select col-12" id="networks" name="networks">
                            <option value="-1">Seleziona rete...</option>
                            % foreach my $net (@{$networks}){
                                <option value="<%= $net->{'st_network_id'} %>"><%= $net->{'st_network_desc'} %></option>
                            % }
                        </select>
                    </div>
                    <div class=" col-md-3">
                        <select class="custom-select col-12" id="provinces" name="provinces">
                            <option value="-1">Seleziona provincia...</option>
                        </select>
                    </div>
                    <div class=" col-md-3">
                        <select class="custom-select col-12" id="stations" name="stations">
                            <option value="-1">Seleziona stazione...</option>
                        </select>
                    </div>
                </div>

                <div id="diag-legend" class="legend">
                    <h5 class="text-primary">Legenda: <strong>valore orario del singolo diagnostico</strong></strong></h5>
                    <span>
                        <button type="button" class="btn waves-effect waves-light btn-rounded btn-sm no-data">&nbsp;&nbsp;&nbsp;</button> Maggiore del MASSIMO
                    </span>
                    <span>
                        <button type="button" class="btn waves-effect waves-light btn-rounded btn-sm few-data">&nbsp;&nbsp;&nbsp;</button> Minore del MINIMO
                    </span>
                    <span>
                        <button type="button" class="btn waves-effect waves-light btn-rounded btn-sm all-data">&nbsp;&nbsp;&nbsp;</button> Normale
                    </span>
                </div>

                <div class="diag">
                    <h4 class="tbl-title text-info m-b-10">Stazione di: <strong id="sel-station"></strong></h4>
                    <div id="diag-table" class="table tbl-data">
                    </div>
                    <div class="download-buttons">
                        <button id="download-csv" type="button" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Download CSV">
                            <i class="ti-download"></i> CSV
                        </button>
                        <button id="download-xlsx" type="button" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="Download XLSX">
                            <i class="ti-download"></i> XLSX
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>