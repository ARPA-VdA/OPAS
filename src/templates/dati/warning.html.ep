                            <button class="btn btn-danger btn-sm btn-hide-all-children" data-idx="4" type="button"><i class="icon-arrow-up-circle"></i> Chiudi tutti</button>
                        </div>
                    </div>
                    <hr class="m-t-10 m-b-20">
                    <div class="row">
