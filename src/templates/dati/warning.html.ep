                    <hr class="m-t-10 m-b-20">
                    <div class="row">
                        <div class="col-lg-12">
                            <table id="tbl-metone" class="tbl-5 display nowrap table table-hover table-striped tbl-details" style="width:100%">
                                <thead>
                                    <tr>
