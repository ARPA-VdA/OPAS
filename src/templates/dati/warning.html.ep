                    <hr class="m-t-10 m-b-20">
                    <div class="row">
                        <div class="col-lg-12">
                            <table id="tbl-fidas" class="tbl-6 display nowrap table table-hover table-striped tbl-details" style="width:100%">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Data ora</th>
                                        <th>Prov.</th>
