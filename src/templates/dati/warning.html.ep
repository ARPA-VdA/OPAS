                            <h4 class="text-info m-b-0 p-t-5">Warning dai <strong>Teledyne API</strong></h4>
                        </div>
                        <div class="col-sm-6 text-right">
                            <button class="btn btn-info btn-sm btn-show-all-children" data-idx="7" type="button"><i class="icon-arrow-down-circle"></i> Espandi tutti</button>
                            <button class="btn btn-danger btn-sm btn-hide-all-children" data-idx="7" type="button"><i class="icon-arrow-up-circle"></i> Chiudi tutti</button>
