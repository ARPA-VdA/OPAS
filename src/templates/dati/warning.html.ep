                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Data ora</th>
                                        <th>Prov.</th>
                                        <th>Stazione</th>
                                        <th>ID staz.</th>
                                        <th>N° warning</th>
                                        <th>Codice</th>
                                        <th class="none">Dettagli&nbsp;&nbsp;<i class="ti-support"></i></th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th></th>
                                        <th>Data ora</th>
                                        <th>Prov.</th>
                                        <th>Stazione</th>
                                        <th>ID staz.</th>
                                        <th>N° warning</th>
                                        <th>Codice</th>
                                        <th class="none">Dettagli&nbsp;&nbsp;<i class="ti-support"></i></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="hidden-container cont-5" id="metone">
                    <div class="row">
                        <div class="col-sm-6">
