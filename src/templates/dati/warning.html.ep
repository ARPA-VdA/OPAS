% layout 'default';
% title 'Dati - warning dagli strumenti';

<script src="<%=url_for(helperGetFileVersion('/bobo-js/dati/warning.js'))%>" type="text/javascript"></script>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-11">
                        <h4 class="card-title">Visualizza tutti i WARNING provenienti DAGLI STRUMENTI</h4>
                        <h6 class="card-subtitle">Visualizza i warning degli strumenti suddivisi per CATEGORIA e poi per STAZIONE</h6>
                    </div>
                </div>

                <div class="row m-b-10">
                    <div class="input-group col-md-3">
                        <input class="form-control input-daterange-datepicker" type="text" name="daterange" value="" />
                        <div class="input-group-append">
                            <span class="input-group-text"><i class="mdi mdi-calendar-multiple"></i></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select class="custom-select col-12" id="types" name="types">
                            <option value="-1">Seleziona strumento...</option>
                            % if(defined $page_options->{'warnings'}){
                                % foreach my $warn (@{$page_options->{'warnings'}}){
                                    <option value="<%= $warn->{'value'} %>"><%= $warn->{'label'} %></option>
                                % }
                            % }
                            % else{
                                <option value="1">FAI Swam</option>
                                <option value="2">Tecora Skypost</option>
                                <option value="3">COMDE Derenda</option>
                                <option value="4">Envea MP101M</option>
                                <option value="5">MetOne BC1054</option>
                                <option value="6">Palas Fidas200</option>
                                <option value="7">Teledyne API</option>
                            % }
                        </select>
                    </div>
                    <div class=" col-md-3">
                        <select class="custom-select col-12" id="provinces" name="provinces">
                            <option value="-1">Seleziona provincia...</option>
                            % my $region = '';
                            % foreach my $province (@{$provinces}){

                                % if ($region eq ''){
                                    <optgroup label="<%= $province->{'region_name'} %>">
                                    <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                % }else{
                                    % if ($region eq $province->{'region_id'}){
                                        <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                    % } else {
                                        </optgroup>
                                        <optgroup label="<%= $province->{'region_name'} %>">
                                        <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                    % }
                                % }
                                % $region = $province->{'region_id'};
                            % }
                            </optgroup>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select class="custom-select col-12" id="stations" name="stations">
                            <option value="-1">Seleziona stazione...</option>
                        </select>
                    </div>
                </div>

                <div class="hidden-container cont-1" id="swam">
                    <div class="row m-b-10">
                        <div class="col-sm-6">
                            <h4 class="text-info m-b-0 p-t-5">Warning dai <strong>FAI Swam</strong></h4>
                        </div>
                        <div class="col-sm-6 text-right">
                            <button class="btn btn-info btn-sm btn-show-all-children" data-idx="1" type="button"><i class="icon-arrow-down-circle"></i> Espandi tutti</button>
                            <button class="btn btn-danger btn-sm btn-hide-all-children" data-idx="1" type="button"><i class="icon-arrow-up-circle"></i> Chiudi tutti</button>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-12">
                            <table id="tbl-swam" class="tbl-1 display nowrap table table-hover table-striped tbl-details" style="width:100%">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Data ora</th>
                                        <th>Prov.</th>
                                        <th>Stazione</th>
                                        <th>Linea</th>
                                        <th>N° warning</th>
                                        <th>Codice</th>
                                        <th class="none">Dettagli&nbsp;&nbsp;<i class="ti-support"></i></th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th></th>
                                        <th>Data ora</th>
                                        <th>Prov.</th>
                                        <th>Stazione</th>
                                        <th>Linea</th>
                                        <th>N° warning</th>
                                        <th>Codice</th>
                                        <th class="none">Dettagli&nbsp;&nbsp;<i class="ti-support"></i></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="hidden-container cont-2" id="tecora">
                    <div class="row">
                        <div class="col-sm-6">
                            <h4 class="text-info m-b-0 p-t-5">Warning dai <strong>Tecora Skypost</strong></h4>
                        </div>
                        <!-- <div class="col-sm-6 text-right">
                            <button class="btn btn-info btn-sm btn-show-all-children" data-idx="2" type="button"><i class="icon-arrow-down-circle"></i> Espandi tutti</button>
                            <button class="btn btn-danger btn-sm btn-hide-all-children" data-idx="2" type="button"><i class="icon-arrow-up-circle"></i> Chiudi tutti</button>
                        </div> -->
                    </div>
                    <hr class="m-t-10 m-b-20">
                    <div class="row">
                        <div class="col-lg-12">
                            <table id="tbl-tecora" class="tbl-2 display nowrap table table-hover table-striped tbl-details" style="width:100%">
                                <thead>
                                    <tr>
                                        <th>Data ora</th>
                                        <th>Prov.</th>
                                        <th>Stazione</th>
                                        <th>N° warning</th>
                                        <th>Warning</th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th>Data ora</th>
                                        <th>Prov.</th>
                                        <th>Stazione</th>
                                        <th>N° warning</th>
                                        <th>Warning</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="hidden-container cont-3" id="derenda">
                    <div class="row">
                        <div class="col-sm-6">
                            <h4 class="text-info m-b-0 p-t-5">Warning dai <strong>COMDE Derenda</strong></h4>
                        </div>
                        <div class="col-sm-6 text-right">
                            <button class="btn btn-info btn-sm btn-show-all-children" data-idx="3" type="button"><i class="icon-arrow-down-circle"></i> Espandi tutti</button>
                            <button class="btn btn-danger btn-sm btn-hide-all-children" data-idx="3" type="button"><i class="icon-arrow-up-circle"></i> Chiudi tutti</button>
                        </div>
                    </div>
                    <hr class="m-t-10 m-b-20">
                    <div class="row">
                        <div class="col-lg-12">
                            <table id="tbl-derenda" class="tbl-3 display nowrap table table-hover table-striped tbl-details" style="width:100%">
                                <thead>
                                    <tr>
                                        <th>Data ora</th>
                                        <th>Prov.</th>
                                        <th>Stazione</th>
                                        <th>N° warning</th>
                                        <th>Warning</th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th>Data ora</th>
                                        <th>Prov.</th>
                                        <th>Stazione</th>
                                        <th>N° warning</th>
                                        <th>Warning</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="hidden-container cont-4" id="envea">
                    <div class="row">
                        <div class="col-sm-6">
