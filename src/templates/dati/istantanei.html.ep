% layout 'default';
% title 'Dati - istantanei';

<script src="<%=url_for(helperGetFileVersion('/bobo-js/dati/istantanei.js'))%>" type="text/javascript"></script>

<script type="text/javascript">
    var stid = '<%= $stid %>';
</script>
<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-12">
                        <h4 class="card-title">Dati istantanei</h4>
                        <h6 class="card-subtitle">Visualizza in tempo reale i dati che arrivano dalle tue stazioni periferiche.</h6>
                    </div>
                </div>
                <div class="row m-b-10">
                    <div class="col-lg-4 m-b-10">
                        <select class="custom-select col-12" id="networks" name="networks">
                            <option value="-1">Seleziona rete...</option>
                            % foreach my $net (@{$networks}){
                                <option value="<%= $net->{'st_network_id'} %>"><%= $net->{'st_network_desc'} %></option>
                            % }
                        </select>
                    </div>
                    <div class="col-md-4 m-b-10">
                        <select class="custom-select col-12" id="provinces" name="provinces">
                            <option value="-1">Seleziona provincia...</option>
                            </optgroup>
                        </select>
                    </div>
                    <div class="col-md-4 m-b-10">
                        <select class="custom-select col-12" id="stations" name="stations">
                            <option value="-1">Seleziona stazione...</option>
                        </select>
                    </div>
                </div>
                <div class="to-hide">
                    <div class="row">
                        <div class="col-md-10">
                            <h5 class="text-info" id="table-title"></h5>
                        </div>
                        <div class="col-md-2">
                            <button type="button" class="btn btn-primary btn-rounded btn-sm pull-right" id="refresh"><i class="icon-refresh"></i> Aggiorna dati</button>
                        </div>
                    </div>
                    <table id="insta-table" class="display responsive table table-hover table-striped tbl-va-center" cellspacing="0" width="100%">
                        <thead>
                            <tr>
                                <th>Tipo</th>
                                <th>Strumento</th>
                                <th>Parametro</th>
                                <th>Valore</th>
                                <th>Unità Misura</th>
                                <th>Cod. Misura</th>
                                <th>Cod. Stazione</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                        <tfoot>
                            <tr>
                                <th>Tipo</th>
                                <th>Strumento</th>
                                <th>Parametro</th>
                                <th>Valore</th>
                                <th>Unità Misura</th>
                                <th>Cod. Misura</th>
                                <th>Cod. Stazione</th>
                                <th></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>