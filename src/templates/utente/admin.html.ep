                                        <div class="row">
                                            <div class="col-lg-6">
                                                <h5 class="text-success p-t-10 p-b-5">Di seguito il <strong>menu principale</strong> che verrà visualizzato dall'utente che stai inserendo con i relativi permessi</h5>
                                                <div id="user-menu-list" class="usr-list">
                                                </div>
                                            </div>
                                            <div class="col-lg-6">
                                                <h5 class="text-success p-t-10 p-b-5">Di seguito il <strong>menu utente</strong> che gli verrà mostrato con i relativi permessi</h5>
                                                <div id="user-secondary-menu-list" class="usr-list">
                                                    <ul>
                                                        <!-- @hilla: da modificare, non è se tu sei admin ma se l'utente inserito è admin allora aggiungo la relativa voce di menu -->
                                                        <li id="show-admin"><strong>Admin</strong>
                                                            <a href="javascript:void(0)" data-toggle="tooltip" data-original-title="Aggiunta nuovi elementi"> <i class=" icon-plus text-info"></i> </a>
                                                            <a href="javascript:void(0)" data-toggle="tooltip" data-original-title="Modifica degli elementi"> <i class="icon-pencil text-info"></i> </a>
                                                            <a href="javascript:void(0)" data-toggle="tooltip" data-original-title="Eliminazione degli elementi"> <i class="icon-trash text-danger"></i> </a>
                                                        </li>
