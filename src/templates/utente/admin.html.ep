                                                            <a href="javascript:void(0)" data-toggle="tooltip" data-original-title="Aggiunta nuovi elementi"> <i class=" icon-plus text-info"></i> </a>
                                                            <a href="javascript:void(0)" data-toggle="tooltip" data-original-title="Modifica degli elementi"> <i class="icon-pencil text-info"></i> </a>
                                                        </li>
                                                        <li>Mappa portale</li>
                                                        <li class="text-danger">Esci</li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="tab-pane p-10" id="statuser" role="tabpanel">
                                        <h4>Di seguito le stazioni che verranno visualizzate dall'utente che stai inserendo</h4>

                                        <table class="table table-striped table-compressed" id="table-user-stations" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th>ID</th>
