                                            <td><h6>Tutte le stazioni</h6></td>
                                            <td class="sho"><input type="checkbox" class="view-st" data-onstyle="info" data-offstyle="danger" data-on="SI" data-off="NO" data-size="sm" data-style="android"></td>
                                            <td class="ins"><span class="hide-el"><input type="checkbox" class="mody-st" data-onstyle="success" data-offstyle="danger" data-on="SI" data-off="NO" data-size="sm" data-style="android"></span></td>
                                            <td class="mod"><span class="hide-el"><input type="checkbox" class="mody-st" data-onstyle="success" data-offstyle="danger" data-on="SI" data-off="NO" data-size="sm" data-style="android"></span></td>
                                            <td class="del"><span class="hide-el"><input type="checkbox" class="mody-st" data-onstyle="success" data-offstyle="danger" data-on="SI" data-off="NO" data-size="sm" data-style="android"></span></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
