% layout 'default';
% title 'Admin';

<script src="<%=url_for(helperGetFileVersion('/bobo-js/utente/admin_permissions.js'))%>" type="text/javascript"></script>
<script src="<%=url_for(helperGetFileVersion('/bobo-js/utente/admin_settings.js'))%>" type="text/javascript"></script>

<script>
    var system_admin = parseInt('<%= $user->{user_sys_admin} %>');
</script>
<div class="row">
    <div class="col-md-12">

        <!-- Nav tabs -->
        <ul class="nav nav-tabs" role="tablist" id="main-list">
            <li class="nav-item"> <a class="nav-link active" data-toggle="tab" href="#pu-tab" role="tab"><span class="hidden-sm-up"><i class="fa-regular fa-universal-access"></i></span> <span class="hidden-xs-down">Profilazione utenze</span></a> </li>
            <li class="nav-item"> <a class="nav-link" data-toggle="tab" href="#ig-tab" role="tab"><span class="hidden-sm-up"><i class="fa-regular fa-gear-complex"></i></span> <span class="hidden-xs-down">Impostazioni generali</span></a> </li>
        </ul>

        <!-- Tab panes -->
        <div class="tab-content tabcontent-border tab-big m-b-25" id="main-tab">
            <div class="tab-pane active" id="pu-tab" role="tabpanel">
                <!-- Nav tabs -->
                <ul class="nav nav-tabs customtab p-t-5" role="tablist">
                    <li class="nav-item"> <a class="nav-link active" data-toggle="tab" href="#group-tab" role="tab"><span class="hidden-sm-up"><i class="fa-regular fa-user-group"></i></span> <span class="hidden-xs-down">Gruppi</span></a> </li>
                    <li class="nav-item"> <a class="nav-link" data-toggle="tab" href="#user-tab" role="tab"><span class="hidden-sm-up"><i class="fa-regular fa-user-cowboy"></i></span> <span class="hidden-xs-down">Utenti</span></a> </li>
                    <li class="nav-item"> <a class="nav-link" data-toggle="tab" href="#page-tab" role="tab"><span class="hidden-sm-up"><i class="fa-regular fa-file"></i></span> <span class="hidden-xs-down">Pagine</span></a> </li>
                    <li class="nav-item"> <a class="nav-link" data-toggle="tab" href="#station-tab" role="tab"><span class="hidden-sm-up"><i class="fa-regular fa-house"></i></span> <span class="hidden-xs-down">Stazioni</span></a> </li>
                    <li class="nav-item"> <a class="nav-link" data-toggle="tab" href="#other-tab" role="tab"><span class="hidden-sm-up"><i class="fa-regular fa-circle-ellipsis"></i></span> <span class="hidden-xs-down">Altro</span></a> </li>
                </ul>
                <!-- Tab panes -->
                <div class="tab-content" id="main-tab">
                    <div class="tab-pane p-20 active" id="group-tab" role="tabpanel">
                        <h4 class="tab-title">Amministrazione GRUPPI</h4>
                        <h6 class="tab-subtitle">Creazione, modifica e disabilitazione dei gruppi relativi al portale</h6>

                        <div class="row">
                            <div class="col-lg-7">
                                <table class="table responsive table-striped" id="group-table" width="100%">
                                    <thead>
                                        <tr>
                                            <th></th>
                                            <th>ID</th>
                                            <th>Nome</th>
                                            <th>Descrizione</th>
                                            <th>Admin</th>
                                            <th>Portali</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <th></th>
                                            <th>ID</th>
                                            <th>Nome</th>
                                            <th>Descrizione</th>
                                            <th>Admin</th>
                                            <th>Portali</th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                            <div class="col-lg-5">
                                <div class="light-bg">
                                    <h4 class="box-title">Inserisci <strong>nuovo gruppo</strong></h4>
                                    <hr class="m-t-0 m-b-20">
                                    <form class="form" name="form_group_new" id="form_group_new">
                                        <h5 class="divider-title">Aggiungi dettagli</h5>
                                        <input type="hidden" id="new-group-id" name="new-group-id" class="clear-input" value="">
                                        % if( $user->{user_sys_admin} == 1 ){
                                        <div class="form-group row">
                                            <label for="new-group-portals" class="col-3 col-form-label">Portale di riferimento <span class="text-danger">*</span></label>
                                            <div class="col-9">
                                                <select class="select2 select2-multiple col-12 " id="new-group-portals" name="new-group-portals"  multiple="multiple" data-placeholder="Seleziona...">
                                                    % foreach my $portal (@{$portals}){
                                                        <option value="<%= $portal->{'portal_id'} %>"><%= $portal->{'portal_name'} %></option>
                                                    % }
                                                </select>
                                            </div>
                                            <!-- <div class="col-2">
                                                <a id="selected-azienda-detail" href="#info-portale" role="button" data-toggle="modal" class="info-box"><i class="icon-info"></i> Info portale</a>
                                            </div> -->
                                        </div>
                                        % }
                                        <div class="form-group row">
                                            <label for="new-group-name" class="col-3 col-form-label">Nome <span class="text-danger">*</span></label>
                                            <div class="col-9">
                                                <input class="form-control clear-input" type="text" id="new-group-name" name="new-group-name" placeholder="">
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label for="new-group-desc" class="col-3 col-form-label">Descrizione</label>
                                            <div class="col-9">
                                                <textarea class="form-control clear-input" rows="4" id="new-group-desc" name="new-group-desc"></textarea>
                                            </div>
                                        </div>
                                        <hr class="m-t-0 m-b-20">
                                        <div class="form-group row">
                                            <div class="col-12">
                                                <button type="submit" class="btn btn-info" name="btn-group-form" id="btn-group-form"> <i class="ti-save"></i> Salva</button>
                                                <button type="button" class="btn btn-inverse" name="cancel-group-form" id="cancel-group-form">Annulla</button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="tab-pane p-20" id="user-tab" role="tabpanel">

                        <h4 class="tab-title">Amministrazione utenti</h4>
                        <h6 class="tab-subtitle">Creazione, modifica e disabilitazione degli utenti relativi al portale</h6>

                        <!-- Nav tabs -->
                        <ul class="nav nav-tabs big-nav customtab" role="tablist">
                            <li class="nav-item"> <a class="nav-link active" data-toggle="tab" href="#users_list" role="tab"><span class="hidden-sm-up"><i class="mdi mdi-view-grid"></i></span> <span class="hidden-xs-down">Utenti</span></a> </li>
                            <!-- if user has insert grant -->
                            % if ($user_grants->{user_insert}){
                                <li class="nav-item"> <a class="nav-link text-info" data-toggle="tab" href="#new" role="tab"><span class="hidden-sm-up"><i class="mdi mdi-library-plus"></i></span> <span class="hidden-xs-down">Nuovo</span></a> </li>
                            % }
                        </ul>

                        <!-- Tab panes -->
                        <div class="tab-content big-tab">
                            <div class="tab-pane p-20 active" id="users_list" role="tabpanel">
                                <div class="row m-b-10 row-filter">
                                    <div class="col-lg-6">
                                        <select class="custom-select col-12" id="filter-group" name="filter-group">
                                        </select>
                                    </div>
                                </div>
                                <table class="table responsive table-striped" id="user-table" width="100%">
                                    <thead>
                                        <tr>
                                            <th></th>
                                            <th>ID</th>
                                            <th>Nome</th>
                                            <th>Cognome</th>
                                            <th>Email</th>
                                            <th>Portale</th>
                                            <th>Società</th>
                                            <th>Admin</th>
                                            <th>Attivo</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <th></th>
                                            <th>ID</th>
                                            <th>Nome</th>
                                            <th>Cognome</th>
                                            <th>Email</th>
                                            <th>Portale</th>
                                            <th>Società</th>
                                            <th>Admin</th>
                                            <th>Attivo</th>
                                        </tr>
                                    </tfoot>
                                </table>

                            </div>
                            <div class="tab-pane p-20" id="new" role="tabpanel">
                                <h4 class="box-title">Inserisci nuovo utente</h4>
                                <hr class="m-t-0 m-b-20">
                                <form class="form" id="form_user_new">
                                    <h5 class="divider-title">Informazioni personali</h5>
                                    <input type="hidden" id="new-user-id" name="new-user-id" value="">
                                    <div class="form-group row">
                                        <label for="new-user-name" class="col-2 col-form-label">Nome <span class="text-danger">*</span></label>
                                        <div class="col-4">
                                            <input class="form-control" type="text" id="new-user-name" name="new-user-name" placeholder="">
                                        </div>
                                        <label for="new-user-secondname" class="col-2 col-form-label">Secondo nome</label>
                                        <div class="col-4">
                                            <input class="form-control" type="text" id="new-user-secondname" name="new-user-secondname" placeholder="">
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <label for="new-user-surname" class="col-2 col-form-label">Cognome <span class="text-danger">*</span></label>
                                        <div class="col-4">
                                            <input class="form-control" type="text" id="new-user-surname" name="new-user-surname" placeholder="">
                                        </div>
                                        <label for="new-user-role" class="col-2 col-form-label">Ruolo</label>
                                        <div class="col-4">
                                            <input class="form-control" type="text" id="new-user-role" name="new-user-role" placeholder="">
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <label for="new-user-mobile" class="col-2 col-form-label">Numero cellulare</label>
                                        <div class="col-4">
                                            <input class="form-control" type="text" id="new-user-mobile" name="new-user-mobile" placeholder="">
                                        </div>
                                        <label for="new-user-phone" class="col-2 col-form-label">Numero telefono</label>
                                        <div class="col-4">
                                            <input class="form-control" type="text" id="new-user-phone" name="new-user-phone" placeholder="">
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <label for="new-user-email" class="col-2 col-form-label">Email <span class="text-danger">*</span></label>
                                        <div class="col-4">
                                            <input class="form-control" type="text" id="new-user-email" name="new-user-email" placeholder="">
                                        </div>
                                        <div class="col-sm-4 offset-md-2">
                                            <div class="custom-control custom-checkbox">
                                                <input checked disabled type="checkbox" class="custom-control-input" id="user-active" name="user-active">
                                                <label class="custom-control-label" for="user-active">Utente attivo</label>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- <div class="form-group row">
                                        <label for="fileupload" class="col-2 col-form-label">Avatar</label>
                                        <div class="col-10">
                                            <input type="file" id="fileupload" name="fileupload" class="dropify" />
                                        </div>
                                    </div> -->

                                    <div class="form-group row">
                                        <label for="fileupload" class="col-2 col-form-label">Avatar</label>
                                        <div class="col-10" id="dpz-container">
                                            <div id="fileupload" class="dropzone"></div>
                                            <!-- <input type="file" id="fileupload" name="fileupload" /> -->
                                        </div>
                                        <div class="col-2" id="img-container"></div>
                                    </div>

                                    <h5 class="divider-title">Dettagli aziendali</h5>
                                    % if( $user->{user_sys_admin} == 1 ){
                                    <div class="form-group row">
                                        <label for="new-user-portal" class="col-2 col-form-label">Portale di riferimento</label>
                                        <div class="col-4">
                                            <select class="custom-select col-12" id="new-user-portal" name="new-user-portal">
                                                <option value="-1">Seleziona...</option>
                                                % foreach my $portal (@{$portals}){
                                                    <option value="<%= $portal->{'portal_id'} %>"><%= $portal->{'portal_name'} %></option>
                                                % }
                                            </select>
                                        </div>
                                        <div class="col-sm-4 offset-md-2">
                                            <div class="custom-control custom-checkbox">
                                                <input checked type="checkbox" class="custom-control-input" id="user-email-active" name="user-email-active">
                                                <label class="custom-control-label" for="user-email-active">Invia email</label>
                                            </div>
                                        </div>
                                        <!-- <div class="col-2">
                                            <a id="selected-azienda-detail" href="#info-portale" role="button" data-toggle="modal" class="info-box"><i class="icon-info"></i> Info portale</a>
                                        </div> -->
                                    </div>
                                    % }

                                    <div class="form-group row">
                                        <label for="new-user-comp" class="col-2 col-form-label">Azienda di appartenenza</label>
                                        <div class="col-8">
                                            <select class="custom-select col-12" id="new-user-comp" name="new-user-comp">
                                                <option value="1">Seleziona...</option>
                                                % foreach my $comp (@{$comps}){
                                                    <option value="<%= $comp->{'comp_id'} %>"><%= $comp->{'comp_name'} %></option>
                                                % }
                                            </select>
                                        </div>
                                        <div class="col-2">
                                            <a id="selected-azienda-detail" href="#info-azienda" role="button" data-toggle="modal" class="info-box"><i class="icon-info"></i> Info azienda</a>
                                        </div>
                                    </div>
                                    <h5 class="divider-title">Avanzate</h5>
                                    <div class="form-group row">
                                        <label for="new-user-groups" class="col-2 col-form-label">Associa ai seguenti gruppi <span class="text-danger">*</span></label>
                                        <div class="col-8">
                                            <select id="new-user-groups" name="new-user-groups" class="select2 m-b-10 select2-multiple" style="width: 100%" multiple="multiple" data-placeholder="Seleziona...">
                                            </select>
                                        </div>
                                        <div class="col-2">
                                            <a id="selected-group-detail" href="#info-gruppi" role="button" class="info-box" data-toggle="modal"><i class="icon-info"></i> Info gruppi</a>
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <label for="new-user-session" class="col-2 col-form-label">Scadenza sessione login</label>
                                        <div class="col-5">
                                            <select class="form-control custom-select col-12" id="new-user-session" name="new-user-session" placeholder="">
                                                <option value="86400">1 Giorno</option>
                                                <option value="259200">3 Giorni</option>
                                                <option value="604800">1 Settimana</option>
                                                % if ($user->{user_sys_admin} == 1 ){
                                                <option value="2147483647">Mai</option>
                                                % }
                                            </select>
                                        </div>
                                    </div>
                                    <hr class="m-t-30">
                                    <div class="form-group row">
                                        <div class="col-12">
                                            <button type="submit" class="btn btn-info" name="invio_report" id="invio_report"> <i class="ti-save"></i> Salva</button>
                                            <button type="button" class="btn btn-inverse" name="annulla_report" id="annulla_report">Annulla</button>
                                        </div>
                                    </div>
                                </form>

                            </div>
                        </div>
                        <!-- end Tab panes -->

                        <div class="modal" id="info-azienda" tabindex="-1" role="dialog" aria-hidden="true">
                            <div class="modal-dialog modal-full modal-dialog-centered" role="document">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title text-primary">Informazioni sull'azienda selezionata</h5>
                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">×</span>
                                        </button>
                                    </div>
                                    <div class="modal-body" id="info-azienda-result">
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-info btn-sm" data-dismiss="modal">CHIUDI</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal" id="info-portale" tabindex="-1" role="dialog" aria-hidden="true">
                            <div class="modal-dialog modal-full modal-dialog-centered" role="document">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title text-primary">Informazioni sul portale selezionato</h5>
                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">×</span>
                                        </button>
                                    </div>
                                    <div class="modal-body" id="info-portale-result">
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-info btn-sm" data-dismiss="modal">CHIUDI</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="tab-pane p-20" id="page-tab" role="tabpanel">
                        <div class="row">
                            <div class="col-lg-7">
                                <h4 class="tab-title">Permessi delle pagine</h4>
                                <h6 class="tab-subtitle">Seleziona un gruppo di utenti e scegli quali pagine possono visualizzare e quali permessi assegnare.</h6>
                                <div class="row m-b-10 row-filter">
                                    <div class="col-lg-7">
                                        <select class="custom-select col-12" id="filter-group-pages" name="filter-group-pages">
                                        </select>
                                    </div>
                                    <div class="col-lg-5">
                                        <a id="pages-group-detail" href="#info-gruppi" role="button" class="info-box" data-toggle="modal"><i class="icon-info"></i> Informazioni visibilità gruppo</a>
                                    </div>
                                </div>
                                <div class="pages-table like-head">
                                    <div class="pages-head">Pagina</div>
                                    <div class="pages-cols sho">Visualizza <i class="ti-help-alt text-danger" data-toggle="tooltip" data-original-title="Se abilitato consente di visualizzare la pagina"></i></div>
                                    <div class="pages-cols ins">Inserisci <i class="ti-help-alt text-danger" data-toggle="tooltip" data-original-title="Se abilitato consente di eseguire azioni di inserimento nella pagina"></i></div>
                                    <div class="pages-cols mod">Modifica <i class="ti-help-alt text-danger" data-toggle="tooltip" data-original-title="Se abilitato consente di eseguire azioni di modifica nella pagina"></i></div>
                                    <div class="pages-cols del">Elimina  <i class="ti-help-alt text-danger" data-toggle="tooltip" data-original-title="Se abilitato consente di eseguire azioni di eliminazione nella pagina"></i></div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div id="accordion-as-table">
                                        </div>
                                    </div>
                                </div>
                                <div class="pages-table like-head">
                                    <div class="pages-head">Pagina</div>
                                    <div class="pages-cols sho">Visualizza <i class="ti-help-alt text-danger" data-toggle="tooltip" data-original-title="Se abilitato consente di visualizzare la pagina"></i></div>
                                    <div class="pages-cols ins">Inserisci <i class="ti-help-alt text-danger" data-toggle="tooltip" data-original-title="Se abilitato consente di eseguire azioni di inserimento nella pagina"></i></div>
                                    <div class="pages-cols mod">Modifica <i class="ti-help-alt text-danger" data-toggle="tooltip" data-original-title="Se abilitato consente di eseguire azioni di modifica nella pagina"></i></div>
                                    <div class="pages-cols del">Elimina  <i class="ti-help-alt text-danger" data-toggle="tooltip" data-original-title="Se abilitato consente di eseguire azioni di eliminazione nella pagina"></i></div>
                                </div>
                            </div>
                            <div class="col-lg-5">
                                <h4 class="tab-title">Permessi dei gruppi <span class="font-bold">in visualizzazione</span></h4>
                                <h6 class="tab-subtitle">Seleziona una pagina e controlla quali gruppi possono vederla e che permessi hanno.</h6>
                                <div class="row m-b-10 row-filter">
                                    <div class="col-lg-12">
                                        <select class="custom-select col-12" id="filter-pages" name="filter-pages">
                                            <option value="-1">Seleziona...</option>
                                            % my $nlevel = 2;
                                            % my $user_closed = 0;
                                            % my $submenu_closed = 0;
                                            
                                            <optgroup label="Menu utente">
                                            
                                            % foreach my $page (@{$pages}){
                                        
                                                % # chiudo optgroup Menu utenti
                                                % if ($page->{'menu_type'} ne 'usernav' && $user_closed == 0){
                                                    </optgroup>
                                                    % $user_closed = 1;
                                                % }
                                                
                                                % # passaggio ad un livello superiore, chiudo optgroup precedente
                                                % if ($nlevel > $page->{'nlevel'}){
                                                    % $submenu_closed = 1;
                                                    </optgroup>
                                                % }
                                                
                                                % if (!defined $page->{'page_id'}){
                                                    % $submenu_closed = 0;
                                                    <optgroup label="<%= $page->{'mp_name'} %>">
                                                % }
                                                % else{
                                                    <option value="<%= $page->{'page_id'} %>">
                                                        <%= $page->{'mp_name'} %>
                                                    </option>
                                                % }
                                            
                                                % $nlevel = $page->{'nlevel'}
                                            % }
                                            
                                            % if ($submenu_closed == 0){
                                                </optgroup>
                                            % }
                                        </select>
                                    </div>
                                </div>

                                <table id="groups-table" class="display responsive table table-hover table-striped table-compressed-middle tbl-va-center resp-plus tbl-arrgd" cellspacing="0" width="100%">
                                    <thead>
                                        <tr>
                                            <th class="text-right text-info"><i class="fa-solid fa-people-group"></i> Gruppo</th>
                                            <th class="text-center">Visualizza</th>
                                            <th class="text-center">Inserisci</th>
                                            <th class="text-center">Modifica</th>
                                            <th class="text-center">Elimina</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <th class="text-right text-info"><i class="fa-solid fa-people-group"></i> Gruppo</th>
                                            <th class="text-center">Visualizza</th>
                                            <th class="text-center">Inserisci</th>
                                            <th class="text-center">Modifica</th>
                                            <th class="text-center">Elimina</th>
                                            <th></th>
                                        </tr>
                                    </tfoot>
                                </table>

                            </div>
                        </div>

                    </div>

                    <div class="tab-pane p-20" id="station-tab" role="tabpanel">
                        <h4 class="tab-title">Stazioni da visualizzare</h4>
                        <h6 class="tab-subtitle">Seleziona per ogni gruppo di utenti quali stazioni può visualizzare</h6>
                        <div class="row m-b-10 row-filter">
                            <div class="col-lg-4">
                                <select class="custom-select col-12" id="filter-group-stations" name="filter-group-stations">
                                </select>
                            </div>
                            <div class="col-lg-4">
                                <select class="custom-select col-12" id="filter-province-stations" name="filter-province-stations">
                                    <option value="-1">Seleziona provincia...</option>
                                    % my $region = '';
                                    % foreach my $province (@{$provinces}){

                                        % if ($region eq ''){
                                            <optgroup label="<%= $province->{'region_name'} %>">
                                            <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                        % }else{
                                            % if ($region eq $province->{'region_id'}){
                                                <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                            % } else {
                                                </optgroup>
                                                <optgroup label="<%= $province->{'region_name'} %>">
                                                <option value="<%= $province->{'province_id'} %>"><%= $province->{'province_name'} %></option>
                                            % }
                                        % }
                                        % $region = $province->{'region_id'};
                                    % }
                                    </optgroup>
                                </select>
                            </div>
                            <div class="col-lg-4">
                                <select class="custom-select col-12" id="filter-network-stations" name="filter-network-stations">
                                    <option value="-1">Seleziona rete...</option>
                                    % foreach my $net (@{$networks}){
                                        <option value="<%= $net->{'st_network_id'} %>"><%= $net->{'st_network_desc'} %></option>
                                    % }
                                </select>
                            </div>
                        </div>
                        <div class="row" id="table-switch-network-row">
                            <div class="col-lg-12">
                                <h5 class="text-info m-t-10">Seleziona i permessi di tutte le stazioni visualizzate</h5>
