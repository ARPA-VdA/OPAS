            </div>

            <div class="tab-pane" id="ig-tab" role="tabpanel">
                <!-- Nav tabs -->
                <ul class="nav nav-tabs customtab p-t-5" role="tablist">
                    <li class="nav-item"> <a class="nav-link active" data-toggle="tab" href="#validation-tab" role="tab"><span class="hidden-sm-up"><i class="fa-regular fa-shield-check"></i></span> <span class="hidden-xs-down">Validazione</span></a> </li>
                </ul>
                <!-- Tab panes -->
                <div class="tab-content" id="main-tab">
                    <div class="tab-pane p-20 active" id="group-tab" role="tabpanel">

                        <div class="row">
                            <div class="col-lg-5">
                                <h4 class="tab-title">Codici di validazione<strong class="text-danger">*</strong></h4>
                                <h6 class="tab-subtitle">Imposta i codici ed i livelli di validazione che vuoi attuare sul tuo sistema.</h6>
                                <table id="table-val-codes" class="table table-striped table-hover tbl-oneshot m-b-0">
                                    <thead>
                                        <tr>
                                            <th></th>
                                            <th>Codice</th>
                                            <th>Attivo</th>
                                            <th>Colore</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        % my $cnt = 0;
                                        % foreach my $code (@{$codes}){
                                            % if($code->{'fvc_code_id'} == 0){
                                            %     next;
                                            % }

                                            % $cnt++;
                                        <tr>
                                            <td style="width: 50px;"><%= $cnt %></td>
                                            <td style="width: 70%;"><input type="text" class="form-control" id="cod-txt-<%= $code->{'fvc_code_id'} %>" name="cod-txt" value="<%= $code->{'fvc_code_desc'} %>"></td>
                                            <td style="width: 10%;"><input type="checkbox" id="cod-active-<%= $code->{'fvc_code_id'} %>" name="cod-active" data-onstyle="info" data-offstyle="danger" data-on="SI" data-off="NO" data-size="xs" data-style="android" checked class="cod-active"></td>
                                            <td style="width: 10%;"><div class="valid-level code-<%= $code->{'fvc_code_id'} %>"></div></td>
                                        </tr>
                                        <!-- <tr>
                                            <td style="width: 50px;">2</td>
                                            <td><input type="text" class="form-control" id="cod-txt-2" name="cod-txt" disabled></td>
                                            <td><input type="checkbox" id="cod-active-2" name="cod-active" data-onstyle="info" data-offstyle="danger" data-on="SI" data-off="NO" data-size="xs" data-style="android" class="cod-active"></td>
                                            <td><div class="valid-level code-2 dis"></div></td>
                                        </tr> -->
                                        % }
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <th></th>
                                            <th>Codice</th>
                                            <th>Attivo</th>
                                            <th>Colore</th>
                                        </tr>
                                    </tfoot>
                                </table>
                                <h4 class="tab-title m-t-25">Data conclusione modifica dati<strong class="text-danger">*</strong></h4>
                                <h6 class="tab-subtitle">Le operazioni di validazione sono bloccate <strong>prima della seguente data</strong> (il giorno selezionato <strong>è escluso dal blocco</strong>).</h6>
                                <div class="row">
                                    <div class="input-group col-md-12">
                                        <input type="text" class="form-control clear-input flag-el" id="data-conclusion" name="data-conclusion" placeholder="mm/dd/yyyy">
                                        <div class="input-group-append">
                                            <span class="input-group-text"><i class="icon-calender"></i></span>
                                        </div>
                                    </div>
                                </div>
                                <h4 class="tab-title m-t-25">Reset validazione finale<strong class="text-danger">*</strong></h4>
                                <h6 class="tab-subtitle">
                                    Se l'<strong>utente modifica i dati dopo la validazione finale</strong>, vuoi che i livelli vengano resettati?&nbsp;&nbsp;
                                    <input type="checkbox" id="validation-reset" name="cod-active" data-onstyle="success" data-offstyle="danger" data-on="SI" data-off="NO" data-size="sm" data-style="android" class="cod-active">
                                </h6>

                            </div>
                            <div class="col-lg-7">
                                <h4 class="tab-title">Parametri da validare<strong class="text-danger">*</strong></h4>
                                <h6 class="tab-subtitle">Scegli quali parametri vuoi visualizzare in "Validazione multilivello"</h6>
                                <hr class="m-t-20 m-b-10">
                                <!-- <table id="table-val-params" class="table table-striped table-hover tbl-oneshot">
                                    <thead>
                                        <tr>
                                            <th>Parametro</th>
                                            <th>Unità</th>
                                            <th>Tipo</th>
                                            <th>Attivo</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <th>Parametro</th>
                                            <th>Unità</th>
                                            <th>Tipo</th>
                                            <th>Attivo</th>
                                        </tr>
                                    </tfoot>
                                </table> -->

                                <div class="form-group row multi-sel-group">
                                    <div class="col-sm-5">
                                        <h6 class="m-t-10">Tutti i parametri</h6>
                                        <select name="from[]" id="multiselect1" class="form-control multi-style" size="15" multiple="multiple">
                                            % my $type = '';
                                            % foreach my $param (@{$params}){

                                                % if ($type eq ''){
                                                    <optgroup label="<%= $param->{'parameter_type_desc'} %>">
                                                    <option value="<%= $param->{'parameter_id'} %>"><%= $param->{'parameter_name'} %> [<%= $param->{'parameter_unit'} %>]</option>
                                                % }else{
                                                    % if ($type eq $param->{'parameter_type_id'}){
                                                        <option value="<%= $param->{'parameter_id'} %>"><%= $param->{'parameter_name'} %> [<%= $param->{'parameter_unit'} %>]</option>
                                                    % } else {
                                                        </optgroup>
                                                        <optgroup label="<%= $param->{'parameter_type_desc'} %>">
                                                        <option value="<%= $param->{'parameter_id'} %>"><%= $param->{'parameter_name'} %> [<%= $param->{'parameter_unit'} %>]</option>
                                                    % }
                                                % }
                                                % $type = $param->{'parameter_type_id'};
                                            % }
                                            </optgroup>
                                        </select>
                                    </div>

                                    <div class="col-sm-2 m-t-85">
                                        <button type="button" id="multiselect1_rightAll" class="btn btn-block"><i class="fa fa-angle-double-right"></i></button>
                                        <button type="button" id="multiselect1_rightSelected" class="btn btn-block"><i class="fa fa-angle-right"></i></button>
                                        <button type="button" id="multiselect1_leftSelected" class="btn btn-block"><i class="fa fa-angle-left"></i></button>
                                        <button type="button" id="multiselect1_leftAll" class="btn btn-block"><i class="fa fa-angle-double-left"></i></button>
                                    </div>

                                    <div class="col-sm-5">
                                        <h6 class="m-t-10">Parametri selezionati</h6>
                                        <select name="validation-params[]" id="validation-params" class="form-control multi-style" size="15" multiple="multiple"></select>
                                        <div class="row">
                                            <div class="col-sm-6">
                                                <button type="button" id="multiselect1_move_up" class="btn btn-block"><i class="fa fa-angle-up"></i></button>
                                            </div>
                                            <div class="col-sm-6">
                                                <button type="button" id="multiselect1_move_down" class="btn btn-block"><i class="fa fa-angle-down"></i></button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                        <hr class="m-t-20 m-b-10">
                        <div class="saving-section">
                            <button type="button" class="btn btn-info" name="save-code" id="save-code"><i class="icon-magic-wand"></i> Salva modifiche</button>
                            <button type="button" class="btn btn-inverse" name="cancel-code" id="cancel-code"><i class="fa-solid fa-eraser"></i> Annulla</button>
                        </div>
                        <h6 class="tab-subtitle m-t-10"> <strong class="text-danger font-20">*</strong>Ricordati di <strong>cliccare "<i class="fa-solid fa-floppy-disk"></i> Salva"</strong> dopo le modifiche.</h6>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- MODAL DESTINAZIONE WIDGET -->
<div class="modal fade" id="widget-destination" tabindex="-1" role="dialog" aria-labelledby="widget-destination" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-primary">Modifica la destinazione finale del link di approfondimento per i widget che hai attivato</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form class="form" id="form-link-widget">
                <div class="modal-body">
                    <div class="box-widget-links">
                        <h5 class="text-info m-b-5">Allerta VDA</h5>
                        <h6 class="font-italic m-b-10 ttl-links">Vista rapida sul Bollettino di Criticità Meteorologica, Idrogeologica e Nivologica Regionale.</h6>
                        <p class="font-bold">Seleziona un'opzione:</p>
                        <input type="hidden" id="widget-id" name="widget-id" class="clear-input" value="">
                        <div class="custom-control custom-radio m-t-5">
                            <input type="radio" id="link-default" name="add-link" class="custom-control-input" value="default" checked>
                            <label class="custom-control-label" for="link-default">Link di default</label>
                        </div>
                        <div class="custom-control custom-radio m-t-5">
                            <input type="radio" id="link-page" name="add-link" class="custom-control-input" value="page">
                            <label class="custom-control-label" for="link-page">Seleziona una pagina</label>
                        </div>
                        <div class="m-l-25" id="link-page-selection">
                            <div class="form-group m-b-5">
                                <input type="text" id="link-page-title" name="link-page-title" class="form-control clear-input" placeholder="Inserisci un titolo...">
                            </div>
                            <div class="form-group m-b-5">
                                <select id="link-page-select" name="link-page-select" class="custom-select col-12 clear-select" placeholder="Inserisci una pagina....">
                                    <option value="-1">Seleziona pagina....</option>
                                    % my $nlevel = 2;
                                    % my $user_closed = 0;
                                    % my $submenu_closed = 0;

                                    <optgroup label="Menu utente">

                                    % foreach my $page (@{$pages}){

                                        % # chiudo optgroup Menu utenti
                                        % if ($page->{'menu_type'} ne 'usernav' && $user_closed == 0){
                                            </optgroup>
                                            % $user_closed = 1;
                                        % }

                                        % # passaggio ad un livello superiore, chiudo optgroup precedente
                                        % if ($nlevel > $page->{'nlevel'}){
                                            % $submenu_closed = 1;
                                            </optgroup>
                                        % }

                                        % if (!defined $page->{'page_id'}){
                                            % $submenu_closed = 0;
                                            <optgroup label="<%= $page->{'mp_name'} %>">
                                        % }
                                        % else{
                                            <option value="<%= $page->{'page_id'} %>" data-link="<%= $page->{'page_href'} %>"><%= $page->{'mp_name'} %></option>
                                        % }

                                        % $nlevel = $page->{'nlevel'}
                                    % }

                                    % if ($submenu_closed == 0){
                                    </optgroup>
                                    % }
                                </select>
                            </div>
                        </div>
                        <div class="custom-control custom-radio m-t-5">
                            <input type="radio" id="link-external" name="add-link" class="custom-control-input" value="external">
                            <label class="custom-control-label" for="link-external">Seleziona link esterno</label>
                        </div>
                        <div class="m-l-25" id="link-external-selection">
                            <div class="form-group m-b-5">
                                <input type="text" id="link-external-title" name="link-external-title" class="form-control clear-input" placeholder="Inserisci un titolo...">
                            </div>
                            <div class="form-group m-b-5">
                                <textarea id="link-external-link" name="link-external-link" rows="3" class="form-control clear-input" placeholder="Inserisci un link...."></textarea>
                                <small class="text-danger font-italic">Incolla qui sopra il link alla pagina esterna</small>
                            </div>
                        </div>
                        <div class="custom-control custom-radio m-t-5">
                            <input type="radio" id="link-none" name="add-link" class="custom-control-input" value="none">
                            <label class="custom-control-label" for="link-none">Nessun link</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary" name="form-link-widget-save" id="form-link-widget-save"> <i class="fa-thin fa-floppy-disks"></i> Salva</button>
                    <button type="button" class="btn btn-inverse" name="form-link-widget-cancel" id="form-link-widget-cancel">Annulla</button>
                    <button type="button" class="btn btn-link text-danger" data-dismiss="modal" id="form-link-widget-close"><i class="ti-close"></i> Chiudi</button>
                </div>
            </form>
        </div>
    </div>
</div>