                                            <!-- <th>Per : <strong class="text-success">Tutte le province</strong></th> -->
                                            <th></th>
                                            <th>Visualizza <i class="ti-help-alt text-danger" data-toggle="tooltip" data-original-title="Se abilitato consente di visualizzare ovunque i dati della stazione"></i></th>
                                            <th>Inserisci <i class="ti-help-alt text-danger" data-toggle="tooltip" data-original-title="Se abilitato consente di inserire i dati correlati alla stazione"></i></th>
                                            <th>Modifica <i class="ti-help-alt text-danger" data-toggle="tooltip" data-original-title="Se abilitato consente di modificare i dati correlati alla stazione"></i></th>
