% layout 'default';
% title 'Profilo utente';
<script src="<%=url_for(helperGetFileVersion('/bobo-js/utente/options.js'))%>" type="text/javascript"></script>

<div class="row">
    <div class="col-lg-12">
        <!-- Nav tabs -->
        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item"> <a class="nav-link active" data-toggle="tab" href="#hp-tab" role="tab"><span class="hidden-sm-up"><i class="fa-regular fa-globe"></i></span> <span class="hidden-xs-down">Homepage</span></a> </li>
            <li class="nav-item"> <a class="nav-link" data-toggle="tab" href="#short-links-tab" role="tab"><span class="hidden-sm-up"><i class="fa-regular fa-scissors"></i></span> <span class="hidden-xs-down">Icone rapide</span></a> </li>
            <!-- <li class="nav-item"> <a class="nav-link" data-toggle="tab" href="#other-tab" role="tab"><span class="hidden-sm-up"><i class="mdi mdi-repeat"></i></span> <span class="hidden-xs-down">Altro</span></a> </li> -->
        </ul>
        <!-- Tab panes -->
        <div class="tab-content tabcontent-border tab-big" id="main-tab">
            <div class="tab-pane p-20 active" id="hp-tab" role="tabpanel">
                <h4 class="tab-title">I widget nella tua homepage</h4>
                <h6 class="tab-subtitle">Seleziona quanti e quali widget vuoi visualizzare nella tua homepage</h6>
                <div class="row">
                    <div class="col-lg-4 col-md-12 m-b-20">
                        <p class="info">
                            Passa sopra ad un widget per avere maggiori informazioni.<br>
                            Trascinalo nelle celle che hai abilitato per vederli in homepage.
                        </p>
                        <ul id="widget-list">
                        </ul>
                    </div>
                    <div class="col-lg-8 col-md-12">
                        <p class="info">
                            Hai a disposizione 4 righe ed in ogni riga puoi inserire al massimo 3 widget.
                        </p>
                        <div id="cells" class="clearfix">
                            <div class="onerow">
                                <div id="row1-col1" class="onecol enabled" ondrop="drop(event)" ondragover="allowDrop(event)"></div>
                                <div id="row1-col2" class="onecol enabled" ondrop="drop(event)" ondragover="allowDrop(event)"></div>
                                <div id="row1-col3" class="onecol enabled" ondrop="drop(event)" ondragover="allowDrop(event)"></div>
                            </div>
                            <div class="onerow">
                                <div id="row2-col1" class="onecol enabled" ondrop="drop(event)" ondragover="allowDrop(event)"></div>
                                <div id="row2-col2" class="onecol enabled" ondrop="drop(event)" ondragover="allowDrop(event)"></div>
                                <div id="row2-col3" class="onecol enabled" ondrop="drop(event)" ondragover="allowDrop(event)"></div>
                            </div>
                            <div class="onerow">
                                <div id="row3-col1" class="onecol enabled" ondrop="drop(event)" ondragover="allowDrop(event)"></div>
                                <div id="row3-col2" class="onecol enabled" ondrop="drop(event)" ondragover="allowDrop(event)"></div>
                                <div id="row3-col3" class="onecol enabled" ondrop="drop(event)" ondragover="allowDrop(event)"></div>
                            </div>
                            <div class="onerow">
                                <div id="row4-col1" class="onecol enabled" ondrop="drop(event)" ondragover="allowDrop(event)"></div>
                                <div id="row4-col2" class="onecol enabled" ondrop="drop(event)" ondragover="allowDrop(event)"></div>
                                <div id="row4-col3" class="onecol enabled" ondrop="drop(event)" ondragover="allowDrop(event)"></div>
                            </div>
                        </div>
                        <div class="save-changes">
                            <button type="button" class="btn btn-info" name="salva_wgt" id="salva_wgt"> <i class="ti-save"></i> Salva disposizione homepage</button>
                            <button type="button" class="btn btn-inverse" name="annulla_wgt" id="annulla_wgt">Annulla modifiche</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="tab-pane p-20" id="short-links-tab" role="tabpanel">
                <h4 class="tab-title">Menu icone accesso rapido</h4>
                <h6 class="tab-subtitle">Personalizza il menu di icone ad accesso rapido inserendo i link alle pagine che usi di più</h6>
                <p>Il menu in basso a sinistra, sotto a quello principale, contiene 4 icone che puntano a determinate pagine del portale. E' stato pensato per avere un percorso "breve" alle pagine che più utilizzi all'interno del sistema. Tramite il modulo qui di seguito puoi personalizzarlo a seconda delle tue esigenze.</p>
                <div class="row">
                    <div class="col-md-5 col-xl-4">
                        <div id="change-short-icons">
                            <div>
                                <a href="#" target="_blank" class="text-primary shortcut-1" data-toggle="tooltip" data-original-title="Icona 1"><i class="fa-solid fa-1"></i></a>
                                <span class="text-danger"><i class="fa-solid fa-1"></i></span>
                            </div>
                            <div>
                                <a href="#" target="_blank" class="text-info shortcut-2" data-toggle="tooltip" data-original-title="Icona 2"><i class="fa-solid fa-2"></i></a>
                                <span class="text-danger"><i class="fa-solid fa-2"></i></span>
                            </div>
                            <div>
                                <a href="#" class="text-success shortcut-3" data-toggle="tooltip" data-original-title="Icona 3"><i class="fa-solid fa-3"></i></a>
                                <span class="text-danger"><i class="fa-solid fa-3"></i></span>
                            </div>
                            <div>
                                <a href="#" class="text-warning shortcut-4" data-toggle="tooltip" data-original-title="Icona 4"><i class="fa-solid fa-4"></i></a>
                                <span class="text-danger"><i class="fa-solid fa-4"></i></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-7 col-xl-8">
                        <p><input type="checkbox" checked id="form-active" name="form-active" class="js-switch" data-color="#79a030" /> <label for="form-active" class="font-bold text-danger" id="form-active-label">Questo menu non mi interessa, disattivalo!</label></p>
                        <form class="form" id="form-shortcut-icons">
                            <h5 class="divider-title m-t-0">Seleziona le tue pagine preferite</h5>
                            <div class="form-group row">
                                <label for="new-user-name" class="col-2 col-form-label">Icona <i class="fa-solid fa-1 text-danger"></i> <span class="text-danger">*</span></label>
                                <div class="col-4">
                                    <select class="custom-select col-12 clear-select" id="icons-1" name="icons-one" data-dest="shortcut-1">
                                        <option value="-1" data-icon="fa-solid fa-1">Seleziona icona 1...</option>
                                        % my $nlevel = 2;
                                        % my $user_closed = 0;
                                        % my $submenu_closed = 0;

                                        <optgroup label="Menu utente">

                                        % foreach my $page (@{$pages}){

                                            % # chiudo optgroup Menu utenti
                                            % if ($page->{'menu_type'} ne 'usernav' && $user_closed == 0){
                                                </optgroup>
                                                % $user_closed = 1;
                                            % }

                                            % # passaggio ad un livello superiore, chiudo optgroup precedente
                                            % if ($nlevel > $page->{'nlevel'}){
                                                % $submenu_closed = 1;
                                                </optgroup>
                                            % }

                                            % if (!defined $page->{'page_id'}){
                                                % $submenu_closed = 0;
                                                <optgroup label="<%= $page->{'mp_name'} %>">
                                            % }
                                            % else{
                                                <option value="<%= $page->{'page_id'} %>" data-icon="<%= $page->{'page_shortcut_icon'} %>"><%= $page->{'mp_name'} %></option>
                                            % }

                                            % $nlevel = $page->{'nlevel'}
                                        % }

                                        % if ($submenu_closed == 0){
                                        </optgroup>
                                        % }
                                    </select>
                                </div>
                                <label for="new-user-name" class="col-2 col-form-label">Icona <i class="fa-solid fa-2 text-danger"></i> <span class="text-danger">*</span></label>
                                <div class="col-4">
                                    <select class="custom-select col-12 clear-select" id="icons-2" name="icons-two" data-dest="shortcut-2">
                                        <option value="-1" data-icon="fa-solid fa-2">Seleziona icona 2...</option>
                                        % $nlevel = 2;
                                        % $user_closed = 0;
                                        % $submenu_closed = 0;

                                        <optgroup label="Menu utente">

                                        % foreach my $page (@{$pages}){

                                            % # chiudo optgroup Menu utenti
                                            % if ($page->{'menu_type'} ne 'usernav' && $user_closed == 0){
                                                </optgroup>
                                                % $user_closed = 1;
                                            % }

                                            % # passaggio ad un livello superiore, chiudo optgroup precedente
                                            % if ($nlevel > $page->{'nlevel'}){
                                                % $submenu_closed = 1;
                                                </optgroup>
                                            % }

                                            % if (!defined $page->{'page_id'}){
                                                % $submenu_closed = 0;
                                                <optgroup label="<%= $page->{'mp_name'} %>">
                                            % }
                                            % else{
                                                <option value="<%= $page->{'page_id'} %>" data-icon="<%= $page->{'page_shortcut_icon'} %>"><%= $page->{'mp_name'} %></option>
                                            % }

                                            % $nlevel = $page->{'nlevel'}
                                        % }

                                        % if ($submenu_closed == 0){
                                        </optgroup>
                                        % }
                                    </select>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="new-user-name" class="col-2 col-form-label">Icona <i class="fa-solid fa-3 text-danger"></i> <span class="text-danger">*</span></label>
                                <div class="col-4">
                                    <select class="custom-select col-12 clear-select" id="icons-3" name="icons-three" data-dest="shortcut-3">
                                        <option value="-1" data-icon="fa-solid fa-3">Seleziona icona 3...</option>
                                        % $nlevel = 2;
                                        % $user_closed = 0;
                                        % $submenu_closed = 0;

                                        <optgroup label="Menu utente">

                                        % foreach my $page (@{$pages}){

                                            % # chiudo optgroup Menu utenti
                                            % if ($page->{'menu_type'} ne 'usernav' && $user_closed == 0){
                                                </optgroup>
                                                % $user_closed = 1;
                                            % }

                                            % # passaggio ad un livello superiore, chiudo optgroup precedente
                                            % if ($nlevel > $page->{'nlevel'}){
                                                % $submenu_closed = 1;
                                                </optgroup>
                                            % }

                                            % if (!defined $page->{'page_id'}){
                                                % $submenu_closed = 0;
                                                <optgroup label="<%= $page->{'mp_name'} %>">
                                            % }
                                            % else{
                                                <option value="<%= $page->{'page_id'} %>" data-icon="<%= $page->{'page_shortcut_icon'} %>"><%= $page->{'mp_name'} %></option>
                                            % }

                                            % $nlevel = $page->{'nlevel'}
                                        % }

                                        % if ($submenu_closed == 0){
                                        </optgroup>
                                        % }
                                    </select>
                                </div>
                                <label for="new-user-name" class="col-2 col-form-label">Icona <i class="fa-solid fa-4 text-danger"></i> <span class="text-danger">*</span></label>
                                <div class="col-4">
                                    <select class="custom-select col-12 clear-select" id="icons-4" name="icons-four" data-dest="shortcut-4">
                                        <option value="-1" data-icon="fa-solid fa-4">Seleziona icona 4...</option>
                                        % $nlevel = 2;
                                        % $user_closed = 0;
                                        % $submenu_closed = 0;

                                        <optgroup label="Menu utente">

                                        % foreach my $page (@{$pages}){

                                            % # chiudo optgroup Menu utenti
                                            % if ($page->{'menu_type'} ne 'usernav' && $user_closed == 0){
                                                </optgroup>
                                                % $user_closed = 1;
                                            % }

                                            % # passaggio ad un livello superiore, chiudo optgroup precedente
                                            % if ($nlevel > $page->{'nlevel'}){
                                                % $submenu_closed = 1;
                                                </optgroup>
                                            % }

                                            % if (!defined $page->{'page_id'}){
                                                % $submenu_closed = 0;
                                                <optgroup label="<%= $page->{'mp_name'} %>">
                                            % }
                                            % else{
                                                <option value="<%= $page->{'page_id'} %>" data-icon="<%= $page->{'page_shortcut_icon'} %>"><%= $page->{'mp_name'} %></option>
                                            % }

                                            % $nlevel = $page->{'nlevel'}
                                        % }

                                        % if ($submenu_closed == 0){
                                        </optgroup>
                                        % }
                                    </select>
                                </div>
                            </div>
                            <hr class="m-t-30">
                            <div class="form-group row">
                                <div class="col-12">
                                    <button type="submit" class="btn btn-info" name="send-icons" id="send-icons"> <i class="ti-save"></i> Salva</button>
                                    <button type="button" class="btn btn-inverse" name="cancel-icons" id="cancel-icons">Annulla</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <!-- <div class="tab-pane p-20" id="other-tab" role="tabpanel">
                work in progress
            </div> -->
        </div>
    </div>
</div>