% layout 'default';
% title 'System Admin';

<script src="<%=url_for(helperGetFileVersion('/bobo-js/utente/sysadmin.js'))%>" type="text/javascript"></script>

<!-- Nav tabs -->
<ul class="nav nav-tabs" role="tablist" id="main-list">
    <li class="nav-item"> <a class="nav-link active" data-toggle="tab" href="#maint-tab" role="tab"><span class="hidden-sm-up"><i class="fa-solid fa-toolbox"></i> <span class="hidden-xs-down">Manutenzione del portale</span></a> </li>
    <li class="nav-item"> <a class="nav-link" data-toggle="tab" href="#stat-tab" role="tab"><span class="hidden-sm-up"><i class="fa-solid fa-chart-pie"></i> <span class="hidden-xs-down">Statistiche reti</span></a> </li>
    <li class="nav-item"> <a class="nav-link" data-toggle="tab" href="#email-tab" role="tab"><span class="hidden-sm-up"><i class="fa-solid fa-envelope-dot"></i> <span class="hidden-xs-down">Email Gateway</span></a> </li>
    <li class="nav-item"> <a class="nav-link" data-toggle="tab" href="#access-log-tab" role="tab"><span class="hidden-sm-up"><i class="fa-solid fa-key"></i> <span class="hidden-xs-down">Log accessi</span></a> </li>
</ul>

<!-- Tab panes -->
<div class="tab-content tabcontent-border tab-big m-b-25" id="main-tab">
    <div class="tab-pane p-20 active" id="maint-tab" role="tabpanel">
        <h4 class="tab-title text-success">Gestione manutenzione<strong class="text-danger">*</strong></h4>
        <h6 class="tab-subtitle">Seleziona la modalità "Manutenzione" del tuo portale - aggiungi data di inizio e/o fine a seconda delle tue esigenze.</h6>
        <hr class="m-t-10 m-b-10">

        <div class="row">
            <div class="col-lg-7">
                <form class="form form-medium" id="maintenance-form" name="maintenance-form">
                    Vuoi mettere il portale <strong>in modalità manutenzione</strong>?&nbsp;&nbsp;
                    <input type="checkbox" name="maintenance-active" data-onstyle="success" data-offstyle="danger" data-on="SI" data-off="NO" data-size="sm" data-style="android" id="maintenance-active">
                    <p class="m-t-15">Puoi programmare la manutenzione aggiungendo una data di inizio e/o una data di fine:</p>
                    <div class="form-group row">
                        <label for="maintenance-start" class="col-md-2 col-form-label">Data/ora inizio</label>
                        <div class="input-group col-md-4">
                            <input type="text" class="form-control clear-input" id="maintenance-start" name="maintenance-start" placeholder="mm/dd/yyyy hh:mm">
                            <div class="input-group-append">
                                <span class="input-group-text"><i class="icon-calender"></i></span>
                            </div>
                        </div>
                        <label for="maintenance-end" class="col-md-2 col-form-label">Data/ora fine</label>
                        <div class="input-group col-md-4">
                            <input type="text" class="form-control clear-input" id="maintenance-end" name="maintenance-end" placeholder="mm/dd/yyyy hh:mm">
                            <div class="input-group-append">
                                <span class="input-group-text"><i class="icon-calender"></i></span>
                            </div>
                        </div>
                    </div>
                    <hr class="m-t-20 m-b-10">
                    <div class="saving-section">
                        <button type="submit" class="btn btn-info" name="save-maintenance" id="save-maintenance"><i class="fa-solid fa-floppy-disk"></i> Salva manutenzione</button>
                        <button type="button" class="btn btn-inverse" name="cancel-maintenance" id="cancel-maintenance"><i class="fa-solid fa-eraser"></i> Annulla</button>
                    </div>
                    <h6 class="tab-subtitle m-t-10"> <strong class="text-danger font-20">*</strong>Ricordati di <strong>cliccare "<i class="fa-solid fa-floppy-disk"></i> Salva"</strong> dopo le modifiche.</h6>
                </form>
            </div>
            <div class="col-lg-5 maintenance-info">
            </div>
        </div>

    </div>
    <div class="tab-pane p-20" id="stat-tab" role="tabpanel">
        <h4 class="tab-title text-success">Statistiche sulle varie reti</h4>
        <h6 class="tab-subtitle">Visualizza nella tabella qui sotto, le stazioni attive e non attive suddivise per le varie agenzie.</h6>
        <hr class="m-t-10 m-b-10">
        <table id="stats-table" class="display responsive table table-hover table-striped tbl-va-center resp-plus tbl-arrgd" cellspacing="0" width="100%">
            <thead>
                <tr>
                    <th class="text-right text-info">Stazioni <i class="fa-solid fa-arrow-right-long"></i></th>
                    <th class="text-center col-gray">Attive</th>
                    <th class="text-center col-gray">Sospese
                        <a class="mytooltip" href="javascript:void(0)">
                            <span class="tooltip-content5"><span class="tooltip-text3"><span class="tooltip-inner2">Vengono conteggiate le stazioni sospese, ma <strong>ANCORA ATTIVE</strong>.</span></span></span>
                            <i class="fa-regular fa-circle-info text-info"></i>
                        </a>
                    </th>
                    <th class="text-center col-gray">Non attive</th>
                    <th class="text-center">Fisse</th>
                    <th class="text-center">Mobili</th>
                    <th class="text-center col-gray text-purple"><i class="fa-solid fa-ball-pile"></i> Totali</th>
                </tr>
            </thead>
            <tbody>
                % foreach my $station (@{$stations}){
                <tr>
                    <th><%= $station->{'network'} %></th>
                    <td class="text-center col-gray"><%= $station->{'active'} %></td>
                    <td class="text-center col-gray"><%= $station->{'suspended'} %></td>
                    <td class="text-center col-gray"><%= $station->{'not_active'} %></td>
                    <td class="text-center"><%= $station->{'fixed'} %></td>
                    <td class="text-center"><%= $station->{'mobile'} %></td>
                    <td class="text-center font-bold col-gray text-purple"><%= $station->{'total'} %></td>
                </tr>
                % }
            </tbody>
            <tfoot>
                <tr>
                    <th class="text-right text-info">Stazioni <i class="fa-solid fa-arrow-right-long"></i></th>
                    <th class="text-center col-gray">Attive</th>
                    <th class="text-center col-gray">Sospese
                        <a class="mytooltip" href="javascript:void(0)">
                            <span class="tooltip-content5"><span class="tooltip-text3"><span class="tooltip-inner2">Vengono conteggiate le stazioni sospese, ma <strong>ANCORA ATTIVE</strong>.</span></span></span>
                            <i class="fa-regular fa-circle-info text-info"></i>
                        </a>
                    </th>
                    <th class="text-center col-gray">Non attive</th>
                    <th class="text-center">Fisse</th>
                    <th class="text-center">Mobili</th>
                    <th class="text-center col-gray text-purple"><i class="fa-solid fa-ball-pile"></i> Totali</th>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="tab-pane p-20" id="email-tab" role="tabpanel">
        <h4 class="tab-title text-success">Email in uscita dal Gateway</h4>
        <h6 class="tab-subtitle">Visualizza tutte le mail in uscita dal sistema Gatway.</h6>
        <hr class="m-t-10 m-b-10">
        <div class="row">
            <div class="col-xl-7 order-2 order-xl-1">
                <div class="row m-b-10 show-space-between-med">
                    <div class="input-group col-md-8">
                        <input class="form-control input-daterange-datepicker" type="text" name="daterange" value="" />
                        <div class="input-group-append">
                            <span class="input-group-text"><i class="mdi mdi-calendar-multiple"></i></span>
                        </div>
                    </div>
                </div>
                <table id="email-table" class="display responsive table table-hover table-striped table-compressed-middle tbl-va-center resp-plus tbl-arrgd" cellspacing="0" width="100%">
                    <thead>
                        <tr>
                            <th></th>
                            <th>ID</th>
                            <th>Destinatari</th>
                            <th>Oggetto</th>
                            <th>Stato</th>
                            <th>Data invio</th>
                            <th class="text-center">Tentativi</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                    <tfoot>
                        <tr>
                            <th></th>
                            <th>ID</th>
                            <th>Destinatari</th>
                            <th>Oggetto</th>
                            <th>Stato</th>
                            <th>Data invio</th>
                            <th class="text-center">Tentativi</th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <div class="col-xl-5 order-1 order-xl-2 m-b-25">
                <div class="no-data-sel no-mail">
                    <i class="fa-solid fa-envelope-open-text text-info"></i>
                    <p>Clicca sull'email che vuoi visualizzare</p>
                </div>
                <div class="view-mail">
                </div>
            </div>
        </div>
    </div>
    <div class="tab-pane p-20" id="access-log-tab" role="tabpanel">
        <h4 class="tab-title text-success">Log accessi</h4>
        <h6 class="tab-subtitle">Visualizza tutti i log di accesso sul sistema.</h6>
        <hr class="m-t-10 m-b-10">
        <div class="row">
            <div class="col-xl-7 order-2 order-xl-1">
                <div class="row m-b-10 show-space-between-med">
                    <div class="input-group col-md-8">
                        <input class="form-control input-daterange-datepicker" type="text" name="daterange" value="" />
                        <div class="input-group-append">
                            <span class="input-group-text"><i class="mdi mdi-calendar-multiple"></i></span>
                        </div>
                    </div>
                </div>
                <table id="access-log-table" class="display responsive table table-hover table-striped table-compressed-middle tbl-va-center resp-plus tbl-arrgd" cellspacing="0" width="100%">
                    <thead>
                        <tr>
                            <th></th>
                            <th>ID</th>
                            <th>Email</th>
                            <th>Utente</th>
                            <th>Stato</th>
                            <th>Data accesso</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                    <tfoot>
                        <tr>
                            <th></th>
                            <th>ID</th>
                            <th>Email</th>
                            <th>Utente</th>
                            <th>Stato</th>
                            <th>Data accesso</th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <div class="col-xl-5 order-1 order-xl-2 m-b-25">
                <div class="no-data-sel no-access-log">
                    <i class="fa-solid fa-key text-info"></i>
                    <p>Clicca sull'accesso che vuoi visualizzare</p>
                </div>
                <div class="view-access-log">
                </div>
            </div>
        </div>
    </div>
</div>