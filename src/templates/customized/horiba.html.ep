% layout 'default';
% title 'Gestione horiba';

 <!-- Make sure to use the production build (*.prod.js) when deploying for production. vue.cjs.prod.js-->
<!-- <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
<script src="https://unpkg.com/axios/dist/axios.min.js"></script> -->

<script src="<%=url_for(helperGetFileVersion('/bobo-js/customized/horiba.js'))%>" type="text/javascript"></script>

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-12">
                        <h4 class="card-title">Dati <strong>Horiba PX-375</strong></h4>
                        <h6 class="card-subtitle">Visualizza i dati e le immagine raccolti dallo strumento. <strong>Le acquisizioni avvengono 4 volte al giorno.</strong></h6>
                    </div>
                </div>
                <div class="row" id="elements">
                    <div class="col-xl-3 col-md-4 col-sm-12 m-b-20">
                        <div class="input-group">
                            <div class="input-group-prepend as-btn-element" id="btn-minus">
                                <span class="input-group-text"><i class="fa-solid fa-dash"></i></span>
                            </div>
                            <input class="form-control" type="text" data-date-format="yyyy"  name="datepicker" id="datepicker" />
                            <div class="input-group-append">
                                <span class="input-group-text"><i class="mdi mdi-calendar-multiple"></i></span>
                            </div>
                            <div class="input-group-append as-btn-element as-btn-disabled" id="btn-plus">
                                <span class="input-group-text"><i class="fa-solid fa-plus-large"></i></span>
                            </div>
                        </div>
                    </div>
                </div>

                <h4 class="text-info">Hai selezionato il giorno <strong id="selected-day"></strong> - stazione di <strong>Primo Maggio (AO)</strong></h4>
                <table id="list-table" class="display responsive table table-hover table-striped table-compressed text-center" cellspacing="0" width="100%">
                    <thead>
                        <tr>
                            <th></th>
                            <th>H. 00:00</th>
                            <th>H. 06:00</th>
                            <th>H. 12:00</th>
                            <th>H. 18:00</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                    <tfoot>
                        <tr>
                            <th></th>
                            <th>H. 00:00</th>
                            <th>H. 06:00</th>
                            <th>H. 12:00</th>
                            <th>H. 18:00</th>
                        </tr>
                    </tfoot>
                </table>

            </div>
        </div>
    </div>
</div>



