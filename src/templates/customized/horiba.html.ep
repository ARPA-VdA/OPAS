<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-12">
                        <h4 class="card-title">Dati <strong>Horiba PX-375</strong></h4>
                        <h6 class="card-subtitle">Visualizza i dati e le immagine raccolti dallo strumento. <strong>Le acquisizioni avvengono 4 volte al giorno.</strong></h6>
                    </div>
                </div>
                <div class="row">
                    <div class="input-group col-md-3" style="margin-bottom: 20px;">
                        <input class="form-control" type="text" data-date-format="yyyy"  name="datepicker" id="datepicker" />
                        <div class="input-group-append">
                            <span class="input-group-text"><i class="mdi mdi-calendar-multiple"></i></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select class="custom-select col-12" id="networks" name="networks" disabled>
                            <option value="-1">Seleziona rete...</option>
                        </select>
                    </div>
                    <div class=" col-md-3">
                        <select class="custom-select col-12" id="provinces" name="provinces" disabled>
                            <option value="-1">Seleziona provincia...</option>
                        </select>
                    </div>
                    <div class=" col-md-3">
                        <select class="custom-select col-12" id="stations" name="stations" disabled>
                            <option value="-1">Seleziona stazione...</option>
                        </select>
                    </div>
                </div>

                <h4 class="text-info">Hai selezionato il giorno <strong id="selected-day"></strong> - stazione di <strong>Stazione UNO</strong></h4>
                <table id="list-table" class="display responsive table table-hover table-striped table-compressed text-center" cellspacing="0" width="100%">
                    <thead>
                        <tr>
                            <th></th>
                            <th>H. 00:00</th>
                            <th>H. 06:00</th>
                            <th>H. 12:00</th>
                            <th>H. 18:00</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                    <tfoot>
                        <tr>
                            <th></th>
                            <th>H. 00:00</th>
                            <th>H. 06:00</th>
                            <th>H. 12:00</th>
                            <th>H. 18:00</th>
                        </tr>
                    </tfoot>
                </table>

            </div>
        </div>
    </div>
</div>



